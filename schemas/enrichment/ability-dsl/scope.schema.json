{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/enrichment/ability-dsl/scope.schema.json",
  "title": "Ability Scope",
  "additionalProperties": false,
  "properties": {
    "duration": {
      "$ref": "#/$defs/scope-duration"
    }
  },
  "required": [
    "duration"
  ],
  "$defs": {
    "scope-duration": {
      "type": "string",
      "enum": [
        "phase",
        "turn",
        "battle-round",
        "battle",
        "until-next-command-phase",
        "until-next-movement-phase",
        "until-next-battle-round",
        "until-start-next-turn",
        "one-use",
        "permanent",
        "attack-sequence",
        "resolution",
        "while-leading",
        "after-resolving",
        "until-next-shooting-phase",
        "until-end-of-your-next-turn",
        "until-end-of-opponent-next-turn",
        "until-this-unit-has-shot",
        "control-lost",
        "until-end-of-your-next-fight-phase",
        "until-end-of-your-next-shooting-phase",
        "until-end-of-your-next-movement-phase",
        "until-end-of-opponent-next-movement-phase",
        "until-start-of-opponent-next-command-phase"
      ],
      "description": "How long an effect, a part or a designation lasts; resolution lasts only while resolving this activation; while-leading ends when the bearer stops leading; after-resolving ends after this activation resolves. The remaining values are phase, turn, battle-round, battle, explicit phase edges, attack-sequence, permanent, and domain-specific expiry windows."
    }
  }
}
