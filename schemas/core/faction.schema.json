{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/core/faction.schema.json",
  "title": "Faction",
  "description": "A playable faction or sub-faction.",
  "type": "object",
  "properties": {
    "id": { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
    "external_refs": {
      "$ref": "../defs/common.schema.json#/$defs/external-reference-list"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "parent_faction_id": {
      "oneOf": [
        { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
        { "type": "null" }
      ]
    },
    "game_version": { "$ref": "../defs/game-version-ref.schema.json" },
    "keywords": { "$ref": "../defs/common.schema.json#/$defs/keyword-list" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "faction_rule_ids": {
      "type": "array",
      "items": { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "References to the faction-wide abilities in display order"
    },
    "army_construction_rules": {
      "type": "array",
      "description": "Army-construction constraints evaluated against faction keywords. `faction-keyword-cohesion` limits how many distinct additional faction keywords an army built from this faction may include — the Space Marine Chapters rule, where a second Faction keyword names the unit's Chapter and only one Chapter may be fielded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "const": "faction-keyword-cohesion" },
          "base_faction_keyword": {
            "$ref": "../defs/common.schema.json#/$defs/keyword"
          },
          "additional_keyword_source": {
            "type": "string",
            "minLength": 1,
            "description": "Which secondary Faction keyword the constraint counts (e.g. `chapter`)."
          },
          "max_distinct": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of distinct additional faction keywords an army may include."
          }
        },
        "required": [
          "type",
          "base_faction_keyword",
          "additional_keyword_source",
          "max_distinct"
        ]
      }
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the faction's logo/emblem image."
    }
  },
  "required": ["id", "name", "game_version", "faction_rule_ids"],
  "additionalProperties": false
}
