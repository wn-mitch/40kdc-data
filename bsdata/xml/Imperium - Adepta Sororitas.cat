      <profiles>
        <profile name="Rituale Nullificatus" id="97ec-58de-cfb2-5728" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit has Feel No Pain 4+ against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Virtue of Intolerance" id="7e39-2e44-8d9e-533c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle:
  - Select one enemy unit (your Quarry target). This selection can be made while this unit is embarked. For the rest of the battle, each time a model in this unit makes an attack against it, while the target is a Quarry, this unit's weapons gain [PRECISION]; you can re-roll Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
