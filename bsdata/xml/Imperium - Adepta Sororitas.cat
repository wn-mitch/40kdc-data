        <profile name="Overseer of Redemption" id="cfeb-b37f-ecb9-59ed" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit contains one or more REPENTIA SUPERIOR models, while making melee attacks:
  - You can re-roll Hit rolls for attacks made by SISTERS REPENTIA models in this unit.
  - You can re-roll Wound rolls for attacks made by SISTERS REPENTIA models in this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="e830-f0d8-f034-070e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit has Feel No Pain X+, X being its rating.</characteristic>
          </characteristics>
        </profile>
