      <profiles>
        <profile name="Castigator" id="d56b-287e-3581-a5e1" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">11</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">6+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">Hull</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Castigation" id="85d2-e486-0c32-3597" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After this unit resolves its attacks, once per turn per unit, during your Shooting phase, until the end of the turn:
  - Select one enemy unit that was hit by an attack made by the triggering unit during that shooting sequence (your Rites of Castigation Target). Until the end of the turn, each time a friendly unit makes an attack against it, while making ranged attacks, improve the Armour Penetration characteristic of that attack by 1 if it is made by a friendly ADEPTA SORORITAS unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="1204-1247-6eed-2574" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="8974-8fb7-1cdc-625e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
