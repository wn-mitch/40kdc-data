        <profile name="The Emperor's Grace" id="637f-eeac-66e7-2de3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase, you can use this ability, once per battle per unit, until the end of the phase, this model has a 2+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacred Command" id="93eb-39d1-2d3b-aa7e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model's unit is targeted with a Stratagem, you can use this ability, once per battle round per army, while this unit has the Sacred Command ability, reduce the CP cost of that use of the Stratagem by 1 CP, to a minimum of 0 CP.</characteristic>
          </characteristics>
        </profile>
