      </constraints>
      <profiles>
        <profile name="Auto-Tapestry of the Emperor's Judgement" id="d23c-fd07-041d-78b7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, if this unit is the Aestred Thurga model, this unit's weapons gain [DEVASTATING WOUNDS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8a34-71f8-96ca-a7a3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Recount the Deeds of the Saints" id="4fd7-0866-8db0-c83b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the turn:
  - While this model is leading a unit, if this unit has the AGATHE DOLAN keyword and this unit has destroyed one or more enemy units with those attacks, you gain 1 Miracle die.
  - If this unit has the AGATHE DOLAN keyword, when destroyed by any attack, you gain 1D3 Miracle dice.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
