          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="bfe8-b4eb-c5f0-b802" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Holy Vanguard" id="54a7-a5c2-9257-a485" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, while this unit is being led by a model and this unit is embarked, if the Transport this unit is embarked within has the TRANSPORT keyword, friendly Leader models in this unit gain the Scouts 6" ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Righteous Awareness" id="5dbc-0ab9-c492-683c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a move, during your opponent's Movement phase, while the triggering unit is within 8" of this unit and this unit is unengaged, the triggering unit can make a Normal move of up to D6".</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="d654-0e43-a6e3-d5aa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cherub" id="aa83-7d86-7f68-16ab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an Act of Faith is performed, once per battle per unit, you gain 1 Miracle die.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Acts of Faith" id="cd8d-e6c9-3226-909c" hidden="false" targetId="fd17-e5fe-9e2b-1163" type="rule"/>
