        <profile name="Storm of Retribution" id="9e9e-7cbe-8842-0fff" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks, you can use this ability:
  - You can re-roll Hit rolls of 1.
  - You can re-roll Wound rolls of 1.
  - If the target unit has destroyed one or more friendly ADEPTA SORORITAS units this battle, add 1 to this unit's Hit rolls.
  - If the target unit has destroyed one or more friendly ADEPTA SORORITAS units this battle, add 1 to this unit's Wound rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
