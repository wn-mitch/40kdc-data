    <selectionEntry name="Saint Celestine" id="21f1-8ed6-52c6-54c7" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="c155-f4b4-fa99-a796" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Healing Tears" id="b587-428d-4d5d-831d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit is the Celestine model, during your Command phase, you can return 1 destroyed model named Geminae Superia to this unit, each with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="7276-9734-319c-202a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lifewards" id="4151-05d5-4c95-09ad" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit contains one or more GEMINAE SUPERIA models, this model has Feel No Pain 4+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Miraculous Intervention" id="d693-74fd-7863-afda" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly CELESTINE model in this unit is destroyed, the first time this battle per model:
  - At the end of the phase:
    - Roll one D6: on a 2+, that model can be set up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="a869-c399-a4a7-4abd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends an Ingress move, while this unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Acts of Faith" id="d924-8e13-8c83-4b44" hidden="false" targetId="fd17-e5fe-9e2b-1163" type="rule"/>
