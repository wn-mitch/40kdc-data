    <selectionEntry name="Detachment" id="9cc-e2b2-81eb-df6" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="d56f-b4af-0eb6-4379" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="1"/>
        <constraint id="76e9-9a3b-8501-01cf" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" id="5531-4a51-2f7e-e168" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" id="2ebe-49fb-26b2-0b18" hidden="false">
          <constraints>
            <constraint id="5da9-e925-3936-0b69" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Penitent Host" id="a2f5-a466-96b6-d389" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9319-f805-bbea-9406" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Desperate For Redemption" id="4917-3a79-7634-ddb9" hidden="false">
                  <description>At the start of your Command phase, you can use this ability, until the start of your next Command phase:
  - Select one (each can be chosen once per battle):
    - The Path of the Penitent: Add 3" to friendly PENITENT models' Move characteristic.
    - Absolution in Battle: When a friendly unit is selected to fight, until the end of the phase, if the triggering unit charged this turn, add 1 to the Attacks characteristic of melee weapons equipped by PENITENT models in the triggering unit; add 1 to the Strength characteristic of melee weapons equipped by PENITENT models in the triggering unit.
    - Death Before Disgrace: When a friendly PENITENT model is destroyed, while making melee attacks, unless that model has fought this phase, roll one D6. On a 2+, leave that model on the battlefield; after the attacking unit has finished making its attacks, it can fight. Remove it after it has fought.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="964d-1c2a-4a8b-1276" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Hallowed Martyrs" id="8e26-78e2-10bd-6982" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9afa-b098-d0ef-853d" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="The Blood of Martyrs" id="08bf-fa5e-e8df-3509" hidden="false">
                  <description>While the triggering unit is below its Starting Strength, add 1 to friendly ADEPTA SORORITAS models' Hit rolls.
While the triggering unit is Below Half-strength, add 1 to friendly ADEPTA SORORITAS models' Wound rolls.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="19a6-61c4-db32-81ed" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
                <categoryLink name="Priority Assets" id="febc-cb5f-82c4-8919" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="3"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Bringers of Flame" id="575d-76f6-2edb-22c1" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e418-0594-b283-d280" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Fervent Purgation" id="4e39-66e0-6e78-62a6" hidden="false">
                  <description>Ranged weapons equipped by friendly ADEPTA SORORITAS models gain [ASSAULT].
While making ranged attacks made with [ASSAULT] weapons, while the target is within 6" of the attacking unit, add 1 to friendly ADEPTA SORORITAS models' Strength characteristic.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="7ead-d29a-e972-e0e3" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Champions of Faith" id="5c81-a47b-d3a0-31e8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d7ab-5c94-a191-6ce7" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Righteous Purpose" id="cd2f-f38d-dbf0-294b" hidden="false">
                  <description>Until the end of the turn:
  - Select up to 3 friendly ADEPTA SORORITAS units:
    - For each selected unit:
      - Add 1" to that unit's Move characteristic.
      - Add 1 to that unit's Battle-shock rolls.</description>
                </rule>
              </rules>
              <categoryLinks>
