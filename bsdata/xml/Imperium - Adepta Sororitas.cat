          </characteristics>
        </profile>
        <profile name="Deep Strike" id="26ec-53ca-7f63-caf6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends an Ingress move, while this unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Divine Deliverance" id="d0b8-93ad-2462-9b20" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, you can use this ability, once per battle per unit, until the end of the phase:
  - Add 3 to the Attacks characteristic of melee weapons equipped by this model.
  - Melee weapons equipped by this model gain [DEVASTATING WOUNDS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="0715-b385-96e4-184b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacred Command" id="ed1d-be49-1e90-cd07" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model's unit is targeted with a Stratagem, you can use this ability, once per battle round per army, while this unit has the Sacred Command ability, reduce the CP cost of that use of the Stratagem by 1 CP, to a minimum of 0 CP.</characteristic>
          </characteristics>
        </profile>
      </profiles>
