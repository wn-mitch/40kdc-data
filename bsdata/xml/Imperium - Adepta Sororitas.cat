  <sharedRules>
    <rule name="Acts of Faith" id="fd17-e5fe-9e2b-1163" hidden="false">
      <description>Until the end of the phase, discard a die from your Miracle dice and use its value in place of a Hit, Wound, saving throw, Advance, Charge, Desperate Escape, Hazard or Leadership roll.</description>
    </rule>
  </sharedRules>
