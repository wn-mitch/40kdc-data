        <profile name="Holy Mission" id="98ca-54f6-3570-f864" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, while this model is attached to a DOMINION SQUAD unit, this unit gains the Scouts 6" ability.
When declaring Battle Formations, while this model is attached to a SISTERS NOVITIATE SQUAD unit, this unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8416-b183-6529-9e8f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Righteous Smiting" id="be0e-d9e2-227e-7e70" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, while making melee attacks, add 1 to this unit's Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Zealot" id="fbd8-8ed1-6ef9-984a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle per unit, during the Fight phase, until the end of the phase, you can use this ability:
  - Improve the Attacks characteristic of melee weapons equipped by this model by 3.
  - Improve the Strength characteristic of melee weapons equipped by this model by 3.</characteristic>
          </characteristics>
        </profile>
