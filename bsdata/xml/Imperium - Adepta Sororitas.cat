        <profile name="Litany of Deeds" id="11d5-4d91-ce58-e324" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a Miracle die is generated, if one or more friendly ADEPTA SORORITAS units destroyed triggering this ability within 12" of this model or one or more friendly ADEPTA SORORITAS models destroyed triggering this ability within 12" of this model, you can use this ability and one or more friendly units destroyed within 12" of this model and this unit has the ADEPTA SORORITAS keyword, until the end of the turn, you can re-roll the pool die roll for this model by spending a die from your Miracle Dice.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stanchion of Holy Martyrs" id="172f-fe01-7698-369e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit:
  - Set this unit's Save characteristic to 2+.
  - This unit has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="d9c1-c04d-a710-e7ea" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
