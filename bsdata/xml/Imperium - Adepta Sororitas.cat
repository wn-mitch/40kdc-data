    <selectionEntry name="Triumph of Saint Katherine" id="9f5f-d769-7900-c8a1" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="f948-117c-50bc-afc9" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Triumph of Saint Katherine" id="a024-96a1-4f62-f822" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">18</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">6</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">92x120mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="0c01-7662-340b-dbfc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Relics of the Matriarchs" id="228b-4539-9b60-d162" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round:
    - Select up to two:
      - The Fiery Heart: Add 2" to the Move characteristic of friendly ADEPTA SORORITAS units within 6" of this model; add 1 to the Advance rolls of friendly ADEPTA SORORITAS units within 6" of this model; add 1 to the Charge rolls of friendly ADEPTA SORORITAS units within 6" of this model.
      - Censer of the Sacred Rose: You can re-roll the Battle-shock roll for friendly ADEPTA SORORITAS units within 6" of this model.
      - Simulacrum of the Ebon Chalice: The number of uses of the Acts of Faith ability of friendly ADEPTA SORORITAS units within 6" of this model is 2.
      - Simulacrum of the Argent Shroud: You can re-roll Wound rolls of 1 for attacks made by friendly ADEPTA SORORITAS units within 6" of this model with ranged weapons.
      - Icon of the Valorous Heart: Friendly ADEPTA SORORITAS units within 6" of this model have Feel No Pain 6+.
      - Petals of the Bloody Rose: Improve the Armour Penetration characteristic of melee weapons equipped by friendly ADEPTA SORORITAS units within 6" of this model by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Fiery Heart" id="ac49-7a76-71d2-3ea4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round:
    - Add 2" to the Move characteristic of friendly ADEPTA SORORITAS units within 6" of this model.
    - Add 1 to the Advance rolls of friendly ADEPTA SORORITAS units within 6" of this model.
    - Add 1 to the Charge rolls of friendly ADEPTA SORORITAS units within 6" of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Censer of the Sacred Rose" id="f6e2-e98e-5c98-61e1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round, you can re-roll the Battle-shock roll for friendly ADEPTA SORORITAS units within 6" of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Simulacrum of the Ebon Chalice" id="0910-4536-e63b-2ab9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round, the number of uses of the Acts of Faith ability of friendly ADEPTA SORORITAS units within 6" of this model is 2.</characteristic>
          </characteristics>
        </profile>
        <profile name="Simulacrum of the Argent Shroud" id="cebf-694e-4e2d-5071" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round, you can re-roll Wound rolls of 1 for attacks made by friendly ADEPTA SORORITAS units within 6" of this model with ranged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Icon of the Valorous Heart" id="822d-6b0b-0385-af1e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round, friendly ADEPTA SORORITAS units within 6" of this model have Feel No Pain 6+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Petals of the Bloody Rose" id="ef43-70e3-abb8-f5c6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the battle round, until the end of the battle round:
  - At the start of the battle round, improve the Armour Penetration characteristic of melee weapons equipped by friendly ADEPTA SORORITAS units within 6" of this model by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Solemn Procession" id="6af2-122f-65ba-1e80" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time miracle dice pool is gained or at the start of your turn, while this model is on the battlefield, add a die showing 6 to your Miracle dice.</characteristic>
          </characteristics>
        </profile>
        <profile name="DAMAGED: 1-6 WOUNDS REMAINING" id="0e7d-cfa9-4055-1afd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has 6 or fewer wounds remaining:
  - Halve this model's Attacks characteristic.
  - The number of selections of this model's Relics of the Matriarchs ability is 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
