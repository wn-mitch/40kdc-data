      <profiles>
        <profile name="Coronus Grav-carrier" id="d62a-9cd1-644e-8521" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">12</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">16</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">5+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">95x150mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="aafd-8c1c-6fc8-2fcc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="88c6-b04b-86af-4f09" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Assault Vehicle" id="0350-0860-ee7e-91a7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an Advance move, during the Movement phase, in your turn, friendly units embarked within the unit can disembark using the Shock Disembarkation rules.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="bbfb-1c9d-afda-d8fa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Repulsor Suspensor Technology (Once per phase, per unit)" id="2c9c-b10d-ab69-6d6f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit shoots, once per phase per unit, during the Shooting phase, in the opponent's turn, if the unit lost one or more wounds from attacks from the triggering attacks, while the unit is unengaged, the unit can make a Normal move of up to D6".</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Aegis of the Emperor" id="654d-fd75-54fa-e708" hidden="false" targetId="7374-6ade-4df1-fc0a" type="rule"/>
      </infoLinks>
