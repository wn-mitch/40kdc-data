                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Grav-Assault Force" id="ccb7-6823-6a97-7c19" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="af93-643c-b0ea-4588" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Flare Shields" id="faf4-f1d2-8f56-473f" hidden="false">
                  <description>Against ranged attacks, all friendly GRAV-ASSAULT units have a 4+ invulnerable save.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="27fc-1df5-ba5c-f7bb" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
