        <profile name="Sanctified Flames" id="c8e2-f2ed-8063-2e06" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, you may use this ability, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence:
    -&gt; If the selected unit has the PSYKER keyword, that unit must take a Battle-shock test, applying -1 to that test.
    -&gt; Unless the selected unit has the PSYKER keyword, that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="9e21-9ec5-d159-2f20" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
