            <selectionEntry name="Shadowkeepers" id="26cb-2fd0-9858-61ea" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3bbb-68eb-6e89-6cfc" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Wardens of the Dark Cells" id="65fb-869e-f8e5-a61e" hidden="false">
                  <description>While the target is within range of an objective marker, against melee attacks, while the target is a friendly ADEPTUS CUSTODES unit (excluding MONSTER or VEHICLE units), when the attack's S is more than the target's T, the attacking unit gets -1 to Wound rolls.
While the Kaptaris option of Martial Katah is active:
  -&gt; Select one enemy unit if the selected unit is within Engagement Range of the unit (each unit can be selected for this ability at most once per phase across your army): that unit must take a Battle-shock test, applying -1 to that test.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="839d-e47d-cc9a-588c" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
                <categoryLink name="Detachment Tag: shield-host" id="bb8e-0329-13f4-0513" hidden="false" primary="false" targetId="869d-3286-821c-7eac"/>
