        <profile name="Leader" id="0e9d-7f55-0c2e-7c4b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sweeping Advance" id="edf5-169b-a0c5-fd1c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of the Fight phase, once per battle per unit, if the unit is eligible to fight:
  -&gt; While the unit is unengaged, while the unit is unengaged, the unit can make a Normal move.
  -&gt; While the unit is engaged, the unit can Fall Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="99cc-0c49-a6a1-50dc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Ka'tahs (Once per battle round, per unit)" id="ff64-6c65-55ab-03e4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: Once per battle round per unit, while the unit is not readied, the unit is readied.</characteristic>
          </characteristics>
        </profile>
