        <profile name="Captain-General" id="ea8f-0a08-df79-b3f8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ADEPTUS CUSTODES unit (excluding MONSTER or VEHICLE units) is within 6" of this model, you can re-roll a Hit roll of 1 for attacks made by that unit; you can re-roll a Wound roll of 1 for attacks made by that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="626f-bdde-306d-a3ab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Moment Shackle" id="4e35-46e8-b458-79e9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase, you may use this ability, once per battle per army, until the end of the phase:
  Select exactly 1 distinct options (One of the Following):
    - Improve the Attacks characteristic of melee Watcher’s Axe weapons equipped by this model by 3.
    - This model has a 3+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="4683-31cf-81f0-8a08" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="5b68-ab58-ae45-9bf5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
