            <selectionEntry name="Guardians of the Throne" id="63e2-12d3-9e87-8d43" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a461-7d3e-08ba-6a6c" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Martial Mastery" id="7b71-8f02-110d-8467" hidden="false">
                  <description>When a friendly unit is selected to fight (the triggering unit must have ADEPTUS CUSTODES), during the Fight phase, until the end of the phase:
  Select one of the following:
    - Melee weapons equipped by the triggering unit gain [SUSTAINED HITS 1].
    - Melee weapons equipped by the triggering unit gain [LETHAL HITS].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="1b04-96de-0b1d-7222" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
