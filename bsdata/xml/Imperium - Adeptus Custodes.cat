      <profiles>
        <profile name="Caladius Annihilator Grav Tank" id="b6ee-d396-edce-ba4e" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
