        <profile name="Deep Strike" id="df00-87b0-7a43-7858" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Ka'tahs (Once per battle round, per unit)" id="6a74-b1ab-9658-dda3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: Once per battle round per unit, while the unit is not readied, the unit is readied.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vengeful Surge (Once per battle, per unit)" id="ee69-0d70-2389-77ca" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit shoots, once per battle per unit, during the Shooting phase, in the opponent's turn, if the unit lost one or more wounds from attacks from the triggering attacks, until the end of the phase:
  -&gt; The unit can make a Surge move of up to D6".
  -&gt; Add 2" to the unit's Surge moves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
