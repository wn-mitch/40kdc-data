    <selectionEntry name="Venatari with Kinetic Destroyers" id="201e-e502-a8d1-3974" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="555c-be02-f913-ad5a" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="555c-be02-f913-ad5a" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Deep Strike" id="1527-83a0-9a1a-217f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Neutronium Cascade Mine (Once per battle, per unit)" id="cd45-a8ee-2358-42a6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase, you may use this ability, once per battle per unit:
  -&gt; Select one enemy unit within 3" of the unit:
    -&gt; Roll one D6: on a 2+, unless the selected unit has the MONSTER or VEHICLE keyword, that unit suffers D3 mortal wounds; if the selected unit has the MONSTER or VEHICLE keyword, that unit suffers 2D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strike from the Skies" id="b44c-9a3e-d57d-3918" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn, if the unit made an ingress move this turn, while making ranged attacks, you can re-roll the Hit roll with ranged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Take Wing" id="60de-788a-df31-875d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your opponent's Fight phase, you may use this ability, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Aegis of the Emperor" id="c39b-8b44-f01e-acde" hidden="false" targetId="7374-6ade-4df1-fc0a" type="rule"/>
        <infoLink name="Martial Ka'tah" id="6ca6-37b9-27b0-38d7" hidden="false" targetId="9356-9dd6-9900-f9c7" type="rule"/>
