        <profile name="Corner the Quarry" id="2093-e3c8-4927-6009" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an enemy unit is selected to make a Fall Back move (the triggering unit must not have MONSTER or VEHICLE), while the triggering unit is within Engagement Range of the unit:
  -&gt; While the triggering unit is Battle-shocked, the triggering unit must take a Desperate Escape test, applying -1 to that test.
  -&gt; While the triggering unit is not Battle-shocked, the triggering unit must take a Desperate Escape test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Seeker's Instincts" id="9bd5-f3e3-26d4-8bc9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 2 to the unit's Move characteristic.
You can re-roll the Charge roll.
You can re-roll the Advance roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="422f-d0fa-2fd7-f71f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="4b15-a346-791f-bb00" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
