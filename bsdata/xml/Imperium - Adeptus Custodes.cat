              </constraints>
              <rules>
                <rule name="Companion's Watch" id="5566-56e7-5e4a-31d8" hidden="false">
                  <description>While the attacking unit is within range of an objective marker, you can re-roll a Wound roll of 1 for attacks made by all friendly TRUSTED SENTINEL units.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="4e85-9a46-ddc9-d5f3" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
