        </profile>
        <profile name="Grand Master of the Deathwing" id="59b4-7f32-ab12-a61b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against CHARACTER targets, the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="60bc-bb8a-61d4-fbca" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strikes of Retribution" id="cda9-481b-52cc-9b63" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Fight phase:
  -&gt; Unless the unit has fought this phase, destroy this model.
  -&gt; Each time a model in this unit is destroyed, roll one D6. On a 2+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="e8cc-1d3d-0954-ad53" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
