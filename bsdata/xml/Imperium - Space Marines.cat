        <profile name="Land Speeder Vengeance" id="c33d-f2bd-6b45-486d" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
