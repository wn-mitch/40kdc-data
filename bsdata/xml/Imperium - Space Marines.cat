      <constraints>
        <constraint id="30eb-d2d2-b8be-2f38" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Storm Speeder Thunderstrike" id="e3b3-cb5d-6e22-38a7" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">9</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">11</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">90mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderstrike" id="4565-3952-185f-ca0f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks against MONSTER or VEHICLE targets, the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="0842-1a2f-8f58-3380" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="17b7-b25c-1186-966d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shattered Defences" id="2422-3aed-44c0-cec9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit with the MONSTER or VEHICLE keyword that was hit by an attack made by the triggering unit during its just-finished shooting sequence (your Shattered Defences Target). Each time a friendly unit makes an attack against it, improve the Armour Penetration characteristic of that attack by 1 if it is made with ranged weapons by a friendly ADEPTUS ASTARTES unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Combat Doctrines" id="e6b8-97fd-fa73-51fd" hidden="false" targetId="b872-9bc1-1978-41ae" type="rule"/>
      </infoLinks>
