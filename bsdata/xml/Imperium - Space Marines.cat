            <characteristic name="Base" typeId="nr-base-size">25mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Book of Salvation" id="2404-31c0-19d4-33ff" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the Attacks characteristic of melee weapons equipped by models in this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Engulfing Fear (Psychic)" id="165f-773e-daf4-c6a1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Shooting phase, in your turn, while the unit is not Battle-shocked:
  -&gt; Roll D6, then:
    -&gt; Roll one D6:
      - On 1: The unit is Battle-shocked.
      - On 2-6: Nothing happens.
  -&gt; Select one enemy unit if the selected unit is within 12" of this model: that unit must take a Battle-shock test, applying -1 to that test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="5d8b-07a6-b944-cd0b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Hood" id="2544-29cf-a6ae-dcbc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 4+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chief Librarian (psyker level 3)" id="17de-5d83-1bdf-f517" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Set this model's Psyker Level characteristic to 3.
-&gt; You can:
  -&gt; By paying this cost (spend 1 Psychic Level): during the Shooting phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; select one enemy unit if the selected unit is within 12" of this model: that unit must take a Battle-shock test, applying -1 to that test.
-&gt; When an enemy unit targets this unit, you may use this ability, by paying this cost (spend 1 Psychic Level), until the end of the phase: while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
