          </characteristics>
        </profile>
        <profile name="Leader" id="fe0c-0bb5-0889-b886" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Techmarine" id="323c-5863-6797-af13" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly ADEPTUS ASTARTES VEHICLE unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blessings of the Omnissiah" id="04a0-116a-5768-de58" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move, you may use this ability or when the unit ends a move, you may use this ability, during the Movement phase, in your turn, until the start of your next Movement phase:
  -&gt; Select one friendly ADEPTUS ASTARTES VEHICLE model if the selected unit is within 3" of this model:
    -&gt; That model regains up to D3 lost wounds.
    -&gt; That model ignores any modifiers to its Hit and Wound rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
