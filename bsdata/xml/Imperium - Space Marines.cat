      </constraints>
      <profiles>
        <profile name="Thunderhawk Gunship" id="60a5-46f0-9331-0586" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">12</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">30</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">0</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size"></characteristic>
          </characteristics>
        </profile>
        <profile name="Aerial Assault" id="f963-3c5b-f62d-8d26" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; When a friendly unit disembarks from a Transport: if this model made a Normal move this turn, while the triggering unit has the Deep Strike ability, the triggering unit is eligible to declare a charge in a turn in which it disembarked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderhawk Cluster Bombs" id="1199-301f-ee66-13b7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal or Advance move, you may use this ability, during the Movement phase, in your turn:
  -&gt; Select one enemy unit if the selected unit was moved over by the unit during that move: roll 6 D6: for each 3+, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="7cee-40fa-4d94-a98d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hover" id="9a56-c22d-bf8a-d3d2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the unit uses ability, the unit's Takes to the Skies ability has no limit on its range.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="37b4-a9c6-f2b4-9d54" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
