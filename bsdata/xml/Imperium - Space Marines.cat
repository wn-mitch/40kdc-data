        <profile name="Catechism of Fire" id="86f0-830c-a052-bbec" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit visible to this model (your Catechism of Fire Target). Each time a friendly unit makes an attack against it, ranged weapons equipped by models in this unit gain [DEVASTATING WOUNDS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="5fc2-6ceb-2ece-e106" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Litany of Hate" id="14b8-50bb-cb12-48ed" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Melee weapons equipped by models in this unit gain [LANCE].</characteristic>
          </characteristics>
        </profile>
      </profiles>
