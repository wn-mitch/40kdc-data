      <profiles>
        <profile name="Driven from Cover" id="d69b-2171-0d98-04e4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence (your Driven From Cover Target). Each time a friendly unit makes an attack against it, ranged weapons equipped by all friendly ADEPTUS ASTARTES units gain [IGNORES COVER].</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
