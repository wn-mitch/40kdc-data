      <profiles>
        <profile name="Exploit Their Cowardice" id="02f7-1ef7-4369-a29c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit Falls Back, during the Movement phase, in the opponent's turn, while the triggering unit was engaged with the unit at the start of the phase, while the unit is unengaged, the unit can make a Normal move of up to 6".</characteristic>
          </characteristics>
        </profile>
