    <selectionEntry name="Haywire Mine (Once per battle, per unit)" id="780a-2bfb-7072-62d5" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Haywire Mine" id="3894-1ae9-1187-a863" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn:
  -&gt; Select up to one enemy unit within 6" of the unit visible to this model:
    -&gt; Roll one D6: on a 2+, unless the selected unit has the VEHICLE keyword, that unit suffers D3 mortal wounds; if the selected unit has the VEHICLE keyword, that unit suffers 2D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
      </costs>
    </selectionEntry>
