        <profile name="Fortis Doctrines" id="edd2-e026-d3f4-1468" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target unit is below its starting strength:
  -&gt; Unless the target unit is below half strength, the unit gets +1 to Hit rolls.
  While the target unit is below half strength:
    -&gt; The unit gets +1 to Hit rolls.
    -&gt; The unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
