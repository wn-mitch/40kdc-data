                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="94bb-3284-ee14-57a1" field="selections" scope="primary-catalogue" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint id="0ab5-a6d8-de3d-bfb9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Legendary Slayers" id="07a2-35ac-c429-5493" hidden="false">
                  <description>Against CHARACTER, MONSTER or VEHICLE targets, the weapons of all friendly units with the BLOOD CLAWS, THUNDERWOLF CAVALRY or WULFEN keyword gain [LETHAL HITS].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="d322-9c56-bcbd-705d" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Champions of Fenris" id="afb4-59c7-fa93-55f6" hidden="false" import="true" type="upgrade">
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="94bb-3284-ee14-57a1" field="selections" scope="primary-catalogue" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint id="e854-be1c-1cf6-a372" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="The Great Wolf Watches" id="7263-4f60-7a79-83ad" hidden="false">
                  <description>All friendly ADEPTUS ASTARTES CHARACTER units gain the Countercharge ability:
  -&gt; Once per battle round per unit: the Heroic Intervention Stratagem that targets the unit costs 1CP less.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="41e2-5fc6-53af-8e11" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
                <categoryLink name="Detachment Tag: terminator" id="0337-8e44-c608-c33e" hidden="false" primary="false" targetId="ea2c-8373-89b4-afae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Saga of the Great Wolf" id="bc26-5cb8-f5fb-2760" hidden="false" import="true" type="upgrade">
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="94bb-3284-ee14-57a1" field="selections" scope="primary-catalogue" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint id="3860-cdcd-0a2b-3a34" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Master of Wolves" id="023b-9462-5316-0cc9" hidden="false">
                  <description>While a friendly ADEPTUS ASTARTES unit (excluding MONSTER or VEHICLE units) has the Master of Wolves ability:
  -&gt; That unit gains the Encircling Jaws ability:
    -&gt; While the Assault Doctrine option of Combat Doctrines is active, the unit gets +1 to Advance rolls; the unit gets +1 to Charge rolls.
  -&gt; That unit gains the Hunter’s Eye ability:
    -&gt; While the Devastator Doctrine option of Combat Doctrines is active, you can re-roll a Hit roll of 1 with ranged weapons.
  -&gt; That unit gains the Ferocious Strike ability:
    -&gt; While the Tactical Doctrine option of Combat Doctrines is active, while the target is within 9" of the attacking unit, the unit's weapons gain [SUSTAINED HITS 1].
All friendly LOGAN GRIMNAR units gain the Howling Onslaught ability:
  -&gt; Once per battle per army, you can, until the start of your next Command phase: during the Command phase, in your turn, all friendly ADEPTUS ASTARTES units with the MONSTER or VEHICLE keyword gain the Encircling Jaws (Master of Wolves) ability; all friendly ADEPTUS ASTARTES units with the MONSTER or VEHICLE keyword gain the Hunters Eye (Master of Wolves) ability; all friendly ADEPTUS ASTARTES units with the MONSTER or VEHICLE keyword gain the Ferocious Strike (Master of Wolves) ability.
Your army can include SPACE WOLVES units.
Your army can include units from only one Chapter.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="8c81-c61d-87da-2c87" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Blade of Ultramar" id="6d9d-6462-1738-6bb3" hidden="false" import="true" type="upgrade">
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="4029-9237-e8db-af55" field="selections" scope="primary-catalogue" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint id="4efa-c1da-8692-6d27" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Mastered Doctrines" id="f59e-3142-3267-750c" hidden="false">
                  <description>You can: If your army includes a MARNEUS CALGAR unit, you can select one option of Combat Doctrines Adeptus Astartes one additional time per battle.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="edf8-5487-8a5b-6140" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
