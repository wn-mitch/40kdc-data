      <profiles>
        <profile name="Feel No Pain" id="e51f-a55f-5ea6-e3c4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="a817-a4b7-dc2a-c558" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Litanies of the Devout" id="8deb-c53c-64a4-b113" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can re-roll the Hit roll with melee weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Temple Relics" id="fb81-d209-967f-943d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, if the unit contains 1+ CENOBYTE SERVITOR models, until the start of your next Command phase:
  Select up to 1 distinct options (Temple Relics):
    - The unit gets +1 to Advance rolls; the unit gets +1 to Charge rolls.
    - Add 1 to the unit's Toughness characteristic.
    - Improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Banner of the Emperor Victorious" id="35b0-9ec8-44f9-05dd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, if the unit contains 1+ CENOBYTE SERVITOR models, until the start of your next Command phase:
  -&gt; The unit gets +1 to Advance rolls.
  -&gt; The unit gets +1 to Charge rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Column from the Major Altar" id="ed82-7cf0-28ae-1c37" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, if the unit contains 1+ CENOBYTE SERVITOR models, until the start of your next Command phase, add 1 to the unit's Toughness characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Water from the Stoup of Elucidation" id="88db-b47c-8b31-4f07" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, if the unit contains 1+ CENOBYTE SERVITOR models, until the start of your next Command phase, improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Faithful Cenobytes" id="c53f-7c49-0ba1-7ea1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; When a friendly CHAPLAIN GRIMALDUS model is destroyed: destroy CENOBYTE SERVITOR models in the unit.
For Transport capacity, each Cenobyte Servitor model occupies 0 model spaces.</characteristic>
          </characteristics>
        </profile>
      </profiles>
