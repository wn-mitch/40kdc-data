          <profiles>
            <profile name="Defensive Mastery" id="967e-28ae-3850-4a1e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After deployment, you may use this ability:
  -&gt; Select up to 3 friendly ADEPTUS ASTARTES INFANTRY units:
    -&gt; For each selected unit:
      Select one of the following:
        - That unit can be set up on the battlefield.
        - That unit can be placed into Strategic Reserves, ignoring any limits on units in Strategic Reserves.
Applies to: units with ADEPTUS ASTARTES.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
