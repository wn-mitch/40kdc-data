            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">100mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Firing Deck" id="c6a9-8aa6-19d0-abdf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Firing Deck X ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="fe9f-f932-cd13-fd39" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rapid Disembarkation" id="193c-652b-e6fc-4d94" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an Advance move, during the Movement phase, in your turn, friendly units embarked within the unit can disembark using the Shock Disembarkation rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
