      <profiles>
        <profile name="Talonstrike Doctrines" id="e801-a60b-3344-f8b1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit was set up this turn:
  -&gt; Improve the unit's Armour Penetration characteristic by 1.
  -&gt; Melee weapons equipped by models in this unit gain [LANCE].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="3c7b-eebd-6e3a-9f34" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
