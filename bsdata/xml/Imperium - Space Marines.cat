          </characteristics>
        </profile>
        <profile name="Cerebrex Logic Engine" id="4bf6-43f2-1482-62b8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, you may use this ability:
  -&gt; Select one friendly ADEPTUS ASTARTES INFANTRY unit: that unit gains the Scouts 6" ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cold and Calculating" id="7209-455a-241f-ddbd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot or fight, you may use this ability, during the Shooting phase, in your turn or during the Fight phase, until the end of the phase:
  Select one of the following (Attacks Ability):
    - Against MONSTER or VEHICLE targets, the unit's weapons gain [LETHAL HITS].
    - Against a unit that is not a MONSTER or VEHICLE, the unit's weapons gain [SUSTAINED HITS 1].
    - While the Tactical Doctrine option of Combat Doctrines is active, against MONSTER or VEHICLE targets, the unit's weapons gain [LETHAL HITS]; against a unit that is not a MONSTER or VEHICLE, the unit's weapons gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="7ad2-5915-f807-e0f2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="8e7c-e1d0-172f-7a45" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="5de2-2eb1-9c48-cdb3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
