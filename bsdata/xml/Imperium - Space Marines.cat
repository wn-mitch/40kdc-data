        <profile name="Guile of the Wolf (Aura)" id="f5bb-ba5f-42f9-0d74" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase:
  -&gt; The unit gains Assault Doctrine (Combat Doctrines).
  -&gt; The unit gains Devastator Doctrine (Combat Doctrines).
  -&gt; The unit gains Tactical Doctrine (Combat Doctrines).</characteristic>
          </characteristics>
        </profile>
        <profile name="High King of Fenris" id="5e87-0749-2f81-2552" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the phase:
  -&gt; Select one friendly SPACE WOLVES unit that is in Strategic Reserves: that unit can be set up on the battlefield from Strategic Reserves, treating the battle round as 1 higher than it is.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="04e9-5c1a-2a69-ca87" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="9c30-784e-1531-4592" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
