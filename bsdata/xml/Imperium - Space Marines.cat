        <selectionEntry name="Grimnar's Mark" id="b103-51cc-cef2-892b" import="true" type="upgrade" hidden="false">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="bc26-5cb8-f5fb-2760" field="selections" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
