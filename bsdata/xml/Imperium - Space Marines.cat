      <profiles>
        <profile name="Captain Titus" id="3008-1d92-fae2-c76a" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">6</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Honour of Ultramar" id="d3eb-53f3-bf52-fde3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Before this model is removed from play, until the end of the phase, during the Fight phase, unless the unit has fought this phase, roll one D6. On a 2+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Press the Attack" id="e2f5-831e-f663-5cbb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Unless the Assault Doctrine option of Combat Doctrines is active, while the target does not have the MONSTER or VEHICLE keyword, melee weapons equipped by models in this unit gain [SUSTAINED HITS 1].
While the Assault Doctrine option of Combat Doctrines is active, melee weapons equipped by models in this unit gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="ce8e-4e3e-06ac-bd87" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="bf4b-dbcf-85eb-59a8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Righteous Fury (Once per battle, per army)" id="306b-d75e-2c84-105d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Fight phase, until the end of the phase:
  -&gt; Improve the Strength characteristic of melee weapons equipped by models in this unit by 1.
  -&gt; After the unit resolves its attacks, you may use this ability:
    Select one of the following:
      - This model regains up to D3 lost wounds.
      - If this model has destroyed 1+ enemy models this phase, this model regains up to 2D3 lost wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
