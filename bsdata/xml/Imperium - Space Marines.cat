      <profiles>
        <profile name="Black Rage" id="5fc3-44d1-882b-5de8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can re-roll a Hit roll of 1 with melee weapons.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, the unit cannot Fall Back.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, set the unit's Objective Control characteristic to 0.</characteristic>
          </characteristics>
        </profile>
        <profile name="Savage Fury" id="92ce-12a6-b25d-38f0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gets +1 to Charge rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="fe44-25c1-ee69-266b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="20a1-bf71-8442-949b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
