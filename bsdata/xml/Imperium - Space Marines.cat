        <profile name="Masterful Tactician" id="7dec-ff61-eca8-ecb2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Movement phase, in your turn, until the start of your next Command phase:
  -&gt; Select up to one friendly ADEPTUS ASTARTES unit within 9" of this model visible to this model: select one option of Combat Doctrines for that unit, in place of any already active.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Grand Master" id="93a2-8d25-6454-77e2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit's weapons gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Watcher in the Dark (Once per battle, per unit)" id="5fc2-7ccc-d9a1-b267" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When damage is allocated, you may use this ability, once per battle per unit, until the end of the phase, the unit has the Feel No Pain 4+ ability against mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
