        <profile name="Heroic Last Stand" id="18cd-64de-38c0-b661" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Fight phase:
  -&gt; Unless the unit has fought this phase, destroy this model.
  -&gt; Each time a model in this unit is destroyed, roll one D6. On a 2+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="1533-c53e-914e-215c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
