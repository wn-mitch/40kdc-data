      <profiles>
        <profile name="Deadly Stalkers" id="1994-a082-0ac9-8553" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target unit is an enemy unit, while the target is not within 6" of an enemy unit other than the target unit, the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="c0a9-388a-97a5-f84e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="63a0-90be-991d-4127" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hunting Hounds" id="21fa-46e5-bd5e-5ddb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is not Battle-shocked, while the unit is within 6" of a friendly SPACE WOLVES CHARACTER model (excluding WULFEN models), until the end of the battle round, set the unit's Objective Control characteristic to 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
