      <profiles>
        <profile name="Ravenwing Dark Talon" id="ce9a-93b5-52bb-c1e6" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">-</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">8</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">11</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">-</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">92x120mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Stasis Bomb" id="4397-5931-973c-8ac5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of your opponent's next Movement phase:
  -&gt; At the end of your opponent's Fight phase:
    -&gt; Select one enemy unit (excluding AIRCRAFT units) without the Lone Operative ability visible to this model if the selected unit is within 24" of the unit:
      -&gt; That unit is slowed.
      -&gt; When the selected unit is selected to move, if the triggering unit did not remain stationary this turn, until the end of your opponent's next Movement phase:
        -&gt; Roll one D6:
          - On 1-4: While the triggering unit is slowed, during the Movement phase, in the opponent's turn, the triggering unit suffers D3 mortal wounds; while the triggering unit is slowed, during the Movement phase, in the opponent's turn, subtract 2 from the triggering unit's Move characteristic.
          - On 5-6: While the triggering unit is slowed, during the Movement phase, in the opponent's turn, the triggering unit suffers 2D3 mortal wounds; while the triggering unit is slowed, during the Movement phase, in the opponent's turn, subtract 3 from the triggering unit's Move characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="6194-3944-5184-2628" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="45ea-a019-0f4a-0206" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
