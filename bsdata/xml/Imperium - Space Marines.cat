    <rule name="The Ravenwing" id="0e94-6378-67b4-fd82" hidden="false">
      <description>All friendly ADEPTUS ASTARTES units that are FLY VEHICLE units or MOUNTED units gain the RAVENWING keyword.</description>
    </rule>
    <rule name="The Deathwing" id="5b8d-814a-9682-552f" hidden="false">
      <description>Nothing happens.</description>
    </rule>
