      <profiles>
        <profile name="Chief Librarian Mephiston" id="5a2e-1b01-64cd-0608" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">6</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">6</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="d5c5-8997-e7b3-d0d1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="8347-5b22-b463-050d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Fights First ability, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="f789-87f6-8e07-fec4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="Transfixing Gaze (Aura, Psychic)" id="7579-aca6-c3b4-28cb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an enemy unit is selected to make a Fall Back move within 6" of this model, for the rest of the battle:
  -&gt; The triggering unit takes a Leadership test (2D6, passing on its current Leadership or higher); if passed, nothing happens; otherwise, the triggering unit cannot Fall Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chief Librarian (psyker level 3)" id="f2b8-2284-d0f1-af9b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Set this model's Psyker Level characteristic to 3.
-&gt; You can:
  -&gt; By paying this cost (spend 1 Psychic Level), until the start of your next Command phase: during the Command phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the unit gains Assault Doctrine (Combat Doctrines).
-&gt; By paying this cost (spend 2 Psychic Levels): while the unit is not Battle-shocked, at the start of your opponent's Movement phase, you may use this ability: roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; each time an enemy unit Falls Back, until the end of the phase: while the triggering unit is within 6" of the unit, the triggering unit must take a Leadership test; if the triggering leadership roll was a failure, the triggering unit cannot move.</characteristic>
          </characteristics>
        </profile>
      </profiles>
