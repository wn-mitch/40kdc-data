      <profiles>
        <profile name="Lion El'Jonson" id="0973-6cc8-1c23-2ab4" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">16</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">5+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">4</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">3+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Dark Angels Bodyguard" id="a274-1b16-0b28-72da" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly DARK ANGELS INFANTRY unit, the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="aa0b-3f4d-aa46-e16d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="be23-7767-3842-e057" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Fights First ability, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Primarch of the First Legion" id="e71d-8b25-7efb-18ac" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, you may use this ability, until the start of your next Command phase:
  Select up to 2 distinct options (Abilities in the Primarch of the First Legion Section):
    - During the Command phase, in your turn, while the unit is unengaged, the unit can be placed into Strategic Reserves; it arrives in the Reinforcements step of your next Movement phase, even in the first battle round; during the Movement phase, in your turn, the unit can make an Ingress move.
    - While making melee attacks, while a friendly DARK ANGELS unit is within 6" of this unit, you can re-roll a Hit roll of 1 for attacks made by that unit; you can re-roll a Wound roll of 1 for attacks made by that unit.
    - While a friendly DARK ANGELS unit is within 6" of this unit, that unit has the Feel No Pain 5+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mist-wreathed Shadow Realms" id="d547-1f64-0abe-3173" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, you may use this ability, during the Command phase, in your turn, while the unit is unengaged, until the start of your next Command phase:
  -&gt; The unit can be placed into Strategic Reserves; it arrives in the Reinforcements step of your next Movement phase, even in the first battle round.
  -&gt; During the Movement phase, in your turn, the unit can make an Ingress move.</characteristic>
          </characteristics>
        </profile>
        <profile name="Martial Exemplar" id="6b56-3932-6193-a0d8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, you may use this ability, while making melee attacks, until the start of your next Command phase, while a friendly DARK ANGELS unit is within 6" of this unit, you can re-roll a Hit roll of 1 for attacks made by that unit; you can re-roll a Wound roll of 1 for attacks made by that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="No Hiding from the Watchers" id="6e32-116b-6dbf-a4e5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, you may use this ability, until the start of your next Command phase, while a friendly DARK ANGELS unit is within 6" of this unit, that unit has the Feel No Pain 5+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Emperor's Shield" id="bec0-01e8-5e90-253f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the attack's S is more than the target's T, the unit gets -1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="f21c-5269-9a61-f514" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Strategist" id="fcd5-f458-ef82-914f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, until the start of your next Command phase, select one option of Combat Doctrines for the unit, in addition to any already active.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Watchers" id="1cd8-2e8e-12f8-63cb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 4+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
