        <profile name="Codex Adept" id="82d6-8fd4-52d8-1785" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains Assault Doctrine (Combat Doctrines).
The unit gains Devastator Doctrine (Combat Doctrines).
The unit gains Tactical Doctrine (Combat Doctrines).</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="ba4b-0c26-870b-4da1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="5f72-51ed-ee07-42d6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Tactician" id="d9a7-e7c9-ba4e-4fc1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Movement phase, in your turn, until the start of your next Command phase:
  -&gt; Select one friendly ADEPTUS ASTARTES unit visible to this model if the selected unit is within 9" of this model: select one option of Combat Doctrines for that unit, in place of any already active.</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderhawk Insertion" id="0743-0354-3113-f74d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, you may use this ability:
  -&gt; Select one friendly unit with the GRAVIS, PHOBOS or TACTICUS keyword: that unit gains the Deep Strike ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
