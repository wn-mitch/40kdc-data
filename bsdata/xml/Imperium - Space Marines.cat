            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit made an ingress move this turn, the unit gets +1 to Hit rolls with ranged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="7a7b-765a-4065-b6f0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Parabolic Jetleap" id="eb08-3b9f-d2af-5f11" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your opponent's Fight phase, you may use this ability, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
