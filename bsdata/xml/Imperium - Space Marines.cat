        <profile name="Armour of Faith" id="8eba-bcee-d6f9-3da6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When damage is allocated to this model, each time an attack is allocated to this model, subtract 1 from the Damage characteristic of that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chosen of the Emperor" id="d741-989c-a4b2-6b49" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Your army can include only one friendly EMPEROR'S CHAMPION unit.</characteristic>
          </characteristics>
        </profile>
