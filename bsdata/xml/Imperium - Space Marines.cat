        <profile name="Iron Father" id="56e7-277f-0e8d-4b4a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly ADEPTUS ASTARTES VEHICLE unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="63df-aea2-d830-baaa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Forge" id="7fc6-adbf-a607-035d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a move, you may use this ability or when the unit starts a move, you may use this ability, during the Movement phase, in your turn, until the start of your next Movement phase:
  -&gt; Select one friendly ADEPTUS ASTARTES VEHICLE model if the selected unit is within 3" of this model:
    -&gt; That model regains up to 3 lost wounds.
    -&gt; That model ignores any modifiers to its Ballistic Skill characteristics.
    -&gt; That model ignores any modifiers to its Hit and Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Tempering" id="4c74-f0f9-d150-3ecb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the attack's S is more than the target's T, the attacking unit gets -1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="f66d-030f-14b7-2830" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
