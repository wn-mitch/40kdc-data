        <profile name="Finest Hour" id="e09e-4548-5c9a-b71f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to fight, you may use this ability, during the Fight phase, until the end of the phase:
  -&gt; Improve the Attacks characteristic of melee weapons equipped by this model by 3.
  -&gt; Melee weapons equipped by this model gain [DEVASTATING WOUNDS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="43a4-fd50-bf19-b443" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strategic Acumen" id="e480-91f6-7940-9a27" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, until the start of your next Command phase, select one option of Combat Doctrines for the unit, in place of any already active.</characteristic>
          </characteristics>
        </profile>
      </profiles>
