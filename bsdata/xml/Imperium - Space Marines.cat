        <profile name="Condemnatory Annihilation" id="6e45-dd59-b93b-ccf8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, if the unit has destroyed 1+ enemy models this phase:
  For each enemy unit within Engagement Range of the unit: The unit must take a Battle-shock test, applying -1 to that test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="f5ee-5baa-81ac-65cf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Remorseless Persecution" id="5100-cf9c-11ef-e5b9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to make an Advance move, during the Movement phase, in your turn, until the end of the phase, the unit is eligible to declare a charge even if it Advanced this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
