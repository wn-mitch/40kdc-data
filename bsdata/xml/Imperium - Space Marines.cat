        <profile name="Leader" id="af48-5246-393f-8744" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Hood" id="5912-b58d-198c-ee21" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 4+ ability against Psychic Attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Librarian (psyker level 1)" id="7035-b502-788c-30ab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Set this model's Psyker Level characteristic to 1.
-&gt; When the unit is selected to make an Advance move, you may use this ability, by paying this cost (spend 1 Psychic Level): while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the unit's Advance rolls count as 6.
-&gt; You can:
  -&gt; By paying this cost (spend 1 Psychic Level), until the start of your next turn: during the Movement phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the unit has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
