      <profiles>
        <profile name="Astartes Banner" id="5e6b-53f3-5515-9514" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains 1+ RAVENWING ANCIENT models, add 1 to the unit's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Honour or Death" id="33e2-c952-c73a-88a0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains 1+ RAVENWING CHAMPION models:
  -&gt; The unit gets +1 to Advance rolls.
  -&gt; The unit gets +1 to Charge rolls.
-&gt; When you target the unit with the Heroic Intervention Stratagem: if the unit contains 1+ RAVENWING CHAMPION models, reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).</characteristic>
          </characteristics>
        </profile>
        <profile name="Narthecium" id="68af-5e55-029b-097a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains 1+ RAVENWING APOTHECARY models, during the Command phase, in your turn, the unit regains up to D3+1 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="3fdd-66d8-4a8e-1fc5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
