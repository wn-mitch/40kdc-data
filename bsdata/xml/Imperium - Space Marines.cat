        </profile>
        <profile name="Exhortation of Rage" id="8729-43b5-cee2-3a88" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is below half strength, you can re-roll the Wound roll with melee weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="77a7-04d3-6d4b-c4b4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="21ef-da3a-2a03-9040" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Litany of Hate" id="d171-2d28-2433-01e5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Melee weapons equipped by models in this unit gain [LANCE].</characteristic>
          </characteristics>
        </profile>
      </profiles>
