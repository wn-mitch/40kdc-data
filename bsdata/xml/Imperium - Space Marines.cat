        <profile name="Cunning Hunters" id="f94f-a69b-7bd5-2a23" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Fight phase, while the unit is within range of an objective marker:
  -&gt; Improve the Strength characteristic of melee weapons equipped by models in this unit by 1.
  -&gt; Improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Old Greymanes" id="ac50-0fe5-0a82-378a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, you may use this ability, split the unit into 2 units with as equal a number of models as possible.</characteristic>
          </characteristics>
        </profile>
