        <profile name="Roboute Guilliman" id="6ea1-6651-c335-b566" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
