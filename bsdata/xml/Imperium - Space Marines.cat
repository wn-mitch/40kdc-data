        </profile>
        <profile name="Martial Honour" id="a0ff-a59a-e11a-d474" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: If the unit has destroyed 1+ enemy units with melee attacks this phase, for the rest of the battle, improve this model's Objective Control characteristic by 5.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vengeful Exhortation" id="5f78-52fe-ffbb-6792" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a model in the unit is destroyed, you may use this ability, until the end of the phase, during the Fight phase, unless the unit has fought this phase, roll one D6. On a 4+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="f293-2199-e1a5-bf60" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
