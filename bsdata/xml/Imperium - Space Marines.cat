        </profile>
        <profile name="Intractable Will" id="d48c-b285-68b3-9324" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a model in the unit is destroyed, until the end of the phase, during the Fight phase, unless the unit has fought this phase, roll one D6. On a 4+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="9459-f9eb-f68e-a333" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Spiritshield Helm" id="6ade-2fcf-420a-a25b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 3+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
