          </characteristics>
        </profile>
        <profile name="Author of the Codex" id="a771-21f0-c4a6-5226" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Movement phase, in your turn, until the start of your next Command phase:
  -&gt; Select one friendly ADEPTUS ASTARTES unit within 12" of this model visible to this model: select one option of Combat Doctrines for that unit, in addition to any already active.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="ace9-7e54-bbe5-e49e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Codex Adept" id="4f95-9a71-997e-62c6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains Assault Doctrine (Combat Doctrines).
The unit gains Devastator Doctrine (Combat Doctrines).
The unit gains Tactical Doctrine (Combat Doctrines).</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="0115-8673-3940-25d7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader of Astartes" id="4f21-fbb9-33ef-7278" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly ADEPTUS ASTARTES INFANTRY unit, the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Primarch of the XIII (Aura)" id="75d6-01cc-ffb1-976d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly ADEPTUS ASTARTES unit is within 6" of this unit, you can re-roll a Hit roll of 1 for attacks made by that unit; you can re-roll a Wound roll of 1 for attacks made by that unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
