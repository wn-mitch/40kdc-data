          </characteristics>
        </profile>
        <profile name="Deep Strike" id="9a88-dfcb-debb-1a1c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="0526-a555-da64-aa37" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="78fa-b657-6540-f41c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="f4fb-2f93-db30-6d68" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tactical Precision" id="165b-2987-3112-0c6e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against a unit that is not a MONSTER or VEHICLE, the unit's weapons gain [LETHAL HITS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Demi-company Commander (Once per turn, per unit)" id="676c-3c70-7428-7c5f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a friendly unit uses Strategic Acumen (the triggering unit must have CAPTAIN), you may use this ability, until the start of your next Command phase, the Combat Doctrines option the triggering use selected is active for the unit (and no other option is).</characteristic>
          </characteristics>
        </profile>
      </profiles>
