            <profile name="Howlmaw" id="0a38-684b-07e7-212c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, you may use this ability, once per turn per unit:
  -&gt; Select one enemy unit if the selected unit is within 6" of this model: that unit must take a Battle-shock test, applying -1 to that test.</characteristic>
              </characteristics>
            </profile>
