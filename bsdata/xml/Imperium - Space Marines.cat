      <profiles>
        <profile name="Logan Grimnar" id="b48e-dd86-9bbc-5b50" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
