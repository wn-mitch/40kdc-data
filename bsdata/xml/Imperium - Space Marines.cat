      <profiles>
        <profile name="Iron Priest" id="54e9-3015-e37a-ad58" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">7"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">4</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Gift of the Iron Wolf" id="fed3-01b4-0e1c-2a43" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move or when the unit ends a move, during the Movement phase, in your turn, until the start of your next Movement phase:
  -&gt; Select up to one friendly SPACE WOLVES VEHICLE model if the selected unit is within 3" of this model (each model can be selected for this ability at most once per phase across your army):
    -&gt; That model regains up to D3 lost wounds.
    -&gt; That model ignores any modifiers to its Hit and Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Iron Priest" id="015d-1b7d-9bee-2918" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly SPACE WOLVES VEHICLE unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Judgement of the Omnissiah" id="7ccf-6101-bb5d-5421" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target is within Engagement Range of a friendly SPACE WOLVES VEHICLE unit, you can re-roll the Wound roll for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="840a-bbf3-058f-6312" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
