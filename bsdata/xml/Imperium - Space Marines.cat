        <profile name="Leader" id="8216-c56b-9727-7c6e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="fe32-348c-3420-cdaf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Hood" id="7588-7c77-3fda-b9fc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 4+ ability against Psychic Attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Librarian (psyker level 1)" id="e055-12d4-deab-992b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Set this model's Psyker Level characteristic to 1.
-&gt; By paying this cost (spend 1 Psychic Level), until the end of the phase: during the Fight phase, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; add 2 to the Strength characteristic of melee weapons equipped by models in this unit.
-&gt; By paying this cost (spend 1 Psychic Level), until the end of the phase: during the Shooting phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; add 6 to the Range characteristic of ranged weapons equipped by models in this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
