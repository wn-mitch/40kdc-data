          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="328a-399b-d129-0306" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Forgefather" id="0e65-546b-d6d4-78e1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn:
  -&gt; Select one enemy unit within 24" of this model visible to this model (your Forgefather Target). Each time a friendly unit makes an attack against it, while making attacks made with [MELTA] weapons or while making attacks made with [TORRENT] weapons, improve the Strength characteristic of that attack by 2 if it is made by a friendly ADEPTUS ASTARTES unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Seeker of the Unfound" id="5dd5-5c66-1b29-e216" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is set up:
  -&gt; Select one objective marker within range of this model, binding it as selected objective: while this model is within range of that objective marker, set this model's Objective Control characteristic to 10; set this model's Leadership characteristic to 5; this model has the Feel No Pain 4+ ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
