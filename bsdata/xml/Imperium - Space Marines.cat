          <profiles>
            <profile name="Grimnar's Mark" id="abc6-2ad7-2336-3473" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: Once per battle round per army:
  -&gt; The unit is eligible to be targeted with the Rapid Ingress Stratagem even if it has already been targeted with that Stratagem this phase.
  -&gt; The unit is eligible to be targeted with the Heroic Intervention Stratagem even if it has already been targeted with that Stratagem this phase.
  -&gt; Reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).
  -&gt; The unit's Rapid Ingress ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.
  -&gt; The unit's Heroic Intervention ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="1"/>
          </costs>
        </selectionEntry>
