              </constraints>
              <rules>
                <rule name="Armoured Wrath" id="df1a-b613-67e3-d7a8" hidden="false">
                  <description>When a friendly unit is selected to shoot (the triggering unit must have ADEPTUS ASTARTES), you may use this ability or when a friendly unit is selected to fight (the triggering unit must have ADEPTUS ASTARTES), you may use this ability, until the end of the phase:
  -&gt; While the triggering unit is within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Hit roll.
  -&gt; While the triggering unit is within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Wound roll.
  -&gt; While the triggering unit is within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Damage roll.
  Select one of the following:
    - While the triggering unit is not within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Hit roll.
    - While the triggering unit is not within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Wound roll.
    - While the triggering unit is not within 6" of a friendly unit with the CAANOK VAR or IRON FATHER FEIRROS keyword, you can re-roll one Damage roll.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="1f14-3e27-4d5d-46ba" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
