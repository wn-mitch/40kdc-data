        <profile name="Anvil of Endurance" id="afc0-b033-5207-e7ea" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a model in the unit is destroyed, until the end of the phase, during the Fight phase, unless the unit has fought this phase, roll one D6. On a 4+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Champion of the Kingsguard" id="c9f9-41bb-596d-8aa1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against CHARACTER targets:
  -&gt; You can re-roll a Hit roll of 1 for attacks made by this model.
  -&gt; You can re-roll a Wound roll of 1 for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="1c2d-8207-2637-546e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="9549-bcf5-02f6-0256" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
