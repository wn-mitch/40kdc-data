    <selectionEntry name="Eliminator Squad" id="d6c3-e9d2-430d-6c2f" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="1c81-543e-024f-03ec" type="set" value="2">
          <conditions>
