      <profiles>
        <profile name="Librarian in Phobos Armour" id="4c20-6e2d-086a-e7b4" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">4</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">4</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8e73-f0fd-ef8c-25a3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shrouding (Psychic)" id="0510-9336-7755-7ee6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an enemy unit targets this unit, you may use this ability, while the unit is not Battle-shocked, until the end of the phase:
  -&gt; Roll D6, then:
    -&gt; Roll one D6:
      - On 1: The unit is Battle-shocked.
      - On 2-6: Nothing happens.
  -&gt; The unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="85f8-c5d8-9201-2a4d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Hood" id="5d72-101a-c99e-0d0a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain 4+ ability against Psychic Attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="1f15-ec8f-f9b6-f422" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Librarian (psyker level 1)" id="d759-322a-1400-9f1c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Set this model's Psyker Level characteristic to 1.
-&gt; When an enemy unit targets this unit, you may use this ability, by paying this cost (spend 1 Psychic Level), until the end of the phase: while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the attacking unit gets -1 to Hit rolls.
-&gt; You can:
  -&gt; By paying this cost (spend 1 Psychic Level), until the end of the phase: during the Shooting phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; select one enemy unit visible to this model: each time a ranged attack targets that unit, the attacking weapon has [IGNORES COVER].</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="5484-0ced-d5fe-0db9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="efb7-e224-d271-cb01" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
      </profiles>
