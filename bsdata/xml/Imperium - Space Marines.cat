            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">5+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="e329-f660-3050-ae6d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Oathbound" id="945f-bacf-1a19-fd63" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Select one of the following:
  - The unit gets +1 to Hit rolls with melee weapons.
  - While making melee attacks, while the target is a Slayer's Oath, the unit gets +1 to Hit rolls; the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slayer's Oath" id="14f9-9622-94ea-0f32" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; At the start of the battle round, if during the first battle round, you can:
  -&gt; Select up to one enemy unit with the CHARACTER, MONSTER or VEHICLE keyword, binding it as slayers oath selection (your Slayers Oath target). For the rest of the battle, each time a model in this unit makes an attack against it, while the target is a Slayer's Oath, the unit ignores any modifiers to its Weapon Skill and Ballistic Skill characteristics; the unit ignores any modifiers to its Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="5632-92a7-7971-e012" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
