        <profile name="Crusade of Wrath" id="e68f-0c0e-fd6e-330d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 1 to the Attacks characteristic of melee weapons equipped by models in this unit.
Add 1 to the Strength characteristic of melee weapons equipped by models in this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="High Marshal" id="d0f1-f03d-ff8b-b2b4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase:
  -&gt; Select up to one enemy unit if the selected unit is within Engagement Range of the unit:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-3: That unit suffers D3 mortal wounds.
      - On 4-5: That unit suffers 3 mortal wounds.
      - On 6: That unit suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="6496-eeeb-5513-891c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
