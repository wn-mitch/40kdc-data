      <profiles>
        <profile name="An Honourable Death in Combat" id="5bbb-f408-3cfb-6b2e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Select one of the following:
  - While the unit is below its starting strength, the unit's weapons gain [SUSTAINED HITS 1].
  - While the unit is below half strength, the unit's weapons gain [SUSTAINED HITS 2].</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="4114-b71d-5c85-aa7b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Black Rage" id="7c87-9a8e-8321-0954" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can re-roll a Hit roll of 1 with melee weapons.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, the unit cannot Fall Back.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, set the unit's Objective Control characteristic to 0.</characteristic>
          </characteristics>
        </profile>
      </profiles>
