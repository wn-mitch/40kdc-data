      <profiles>
        <profile name="Bolter Discipline" id="3610-809e-cc70-273c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn, while the unit is within range of an objective marker or while the target is within range of an objective marker, the unit gets +1 to Hit rolls with ranged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tactical Mainstay" id="a2ee-d3e5-49eb-cc0f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit is eligible to start an Action even if it is within Engagement Range of enemy units or it is Battle-shocked.
-&gt; Each time the unit uses action: the unit is eligible to shoot even if it is performing an Action.</characteristic>
          </characteristics>
        </profile>
      </profiles>
