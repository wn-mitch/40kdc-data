      <profiles>
        <profile name="Predatory Instinct" id="85da-e102-97d9-18a8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a move, during the Movement phase, in the opponent's turn, while the triggering unit is within 8" of the unit, while the unit is unengaged, the unit can make a Normal move of up to D6".</characteristic>
          </characteristics>
        </profile>
        <profile name="Hunting Hounds" id="5102-a37d-4d61-63de" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 6" of a friendly CHARACTER SPACE WOLVES model (excluding WULFEN models), while the unit is not Battle-shocked, add 1 to the unit's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
