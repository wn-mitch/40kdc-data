      <profiles>
        <profile name="Death Company Captain" id="23e5-4778-1af0-d587" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">5</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Black Rage" id="0bec-e314-c968-1353" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can re-roll a Hit roll of 1 with melee weapons.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, the unit cannot Fall Back.
While the unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while the unit is not within 12" of a friendly CHAPLAIN unit, set the unit's Objective Control characteristic to 0.</characteristic>
          </characteristics>
        </profile>
        <profile name="Forlorn Hero" id="2def-7ed0-e6bb-3812" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts 6" ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="42dd-bf71-9a0a-60e8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="1d49-d5a8-f160-5440" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Death Visions of Sanguinius" id="beb4-712f-1f05-253e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit fights, you may use this ability, during the Fight phase, if this model lost 1+ models to the just-resolved attacks:
  While this model is within Engagement Range of an enemy unit that is the Warlord:
    -&gt; Roll one D6:
      - On 1: The triggering unit suffers D3 mortal wounds.
      - On 2-3: The triggering unit suffers 3 mortal wounds.
      - On 4-6: The triggering unit suffers D3+3 mortal wounds.
  While this model is not within Engagement Range of an enemy unit that is the Warlord:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-3: The triggering unit suffers D3 mortal wounds.
      - On 4-5: The triggering unit suffers 3 mortal wounds.
      - On 6: The triggering unit suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
