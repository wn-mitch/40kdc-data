      <profiles>
        <profile name="Overlapping Destruction" id="9afd-78c4-78d6-8445" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit (your Overlapping Destruction Target). Each time a friendly unit makes an attack against it, Heavy Bolter weapons equipped by models in this unit gain [BLAST 1].</characteristic>
          </characteristics>
        </profile>
      </profiles>
