    <selectionEntry name="Defiler" id="f158-2979-c38b-65b5" hidden="false" import="true" type="model">
      <modifiers>
        <modifier field="d0b5-ffcc-cf9a-defa" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="d0b5-ffcc-cf9a-defa" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Defiler" id="50a5-c339-acd9-777f" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">18</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">160mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="a676-581f-7356-5233" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Destroyer of Futures" id="6e10-626e-432f-622b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can use this ability: This unit is eligible to be targeted with the Counteroffensive Stratagem even if it has already been targeted with that Stratagem this phase.
Reduce the CP cost of that use of the Stratagem by 1 CP, to a minimum of 0 CP.
This unit's Counteroffensive ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scuttling Walker" id="6c34-f11b-4248-4e7a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends a Normal, Advance or Fall Back move:
  - This unit can move over non-Titanic models as though they were not there.
  - This unit can move over terrain features as though they were not there.
  - The triggering unit is eligible to move even if it is within Engagement Range of enemy units.
  - The triggering unit cannot end a move within Engagement Range of any enemy unit, during its Normal, Advance and Fall Back moves.
  - This unit automatically passes Desperate Escape tests.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="8471-33eb-8bee-ce08" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
