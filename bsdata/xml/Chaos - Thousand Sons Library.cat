        <profile name="Ensorcelled Annihilation" id="3c58-da7c-ab2a-5b0e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase:
  - You can re-roll failed Hit rolls.
  - You can re-roll failed Damage rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="dfd9-a8f0-12c7-c7e7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="af11-bfc3-dbc6-ee80" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
