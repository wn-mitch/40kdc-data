                <constraint id="ae46-02b2-697f-5170" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Sorcerous Invigoration" id="3f73-9386-7134-276b" hidden="false">
                  <description>Each time a friendly PSYKER THOUSAND SONS unit (excluding MONSTER units) attempts a Ritual, once per turn per unit, that unit regains up to D3 lost wounds.
Applies to: THOUSAND SONS PSYKER units (excluding MONSTER units).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="9cb8-d867-b062-461f" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
