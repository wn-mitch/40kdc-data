      <profiles>
        <profile name="Deep Strike" id="4a8e-197c-6b42-d03a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends an Ingress move, while this unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Exploding Horrors" id="ae0b-d1b5-562e-0605" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is selected to fight, you can use this ability:
  - Select one enemy unit that is within Engagement Range of this unit (referred to below as the enemy):
    - Select one or more friendly BRIMSTONE models in this unit (referred to below as the horrors):
      - For each selected model:
        - Roll one D6: on a 4+, destroy that model; the chosen enemy suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="6d5e-3cef-14ec-a4b6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Split" id="f597-d61c-339b-33eb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly BLUE model in this unit is destroyed, after the attacking unit has resolved its attacks, while this unit is on the battlefield:
  - Roll one D6: on a 4+, add 1 Brimstone Horror model to this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sullen Malevolence" id="15f6-b61f-aa43-f4f7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit contains one or more BLUE models, while an enemy unit is within 6" of this unit, worsen that unit's Leadership characteristic by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Pact of Sorcery" id="5d53-2df0-5404-bdfa" hidden="false" targetId="cb84-1d12-885e-45f9" type="rule"/>
