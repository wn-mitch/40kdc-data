        <profile name="Glamour of Tzeentch (Aura, Psychic)" id="7c00-c91b-ccd4-dc63" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly INFANTRY THOUSAND SONS unit is within 6" of this model, that unit gains the Stealth ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Servile Pawns" id="df33-98a1-f102-4cb4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly INFANTRY THOUSAND SONS unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spirit Snare" id="e8c6-a446-2a75-23aa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly PSYKER THOUSAND SONS model with the Cabal of Sorcerers ability is destroyed:
  - Select one friendly model within 9" of that model with the Spirit Snare ability. That model gains the following rules (each time this unit attempts a Ritual, for the rest of the battle, add 1 to this model's Psychic rolls, to a maximum of +2).</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="0c3b-7801-9db9-a7e4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
