            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">13</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">4</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">92x120mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="a54c-397c-a7e2-b407" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="3aa9-75a7-ddb2-6823" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit has Feel No Pain X+, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Immaterial Flare (Aura)" id="24c2-3dec-d133-44b1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly unit is within 6" of this model, if this unit has the PSYKER keyword, add 1 to that unit's Psychic rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mutating Vortex (Aura)" id="26ee-5bf4-0349-a826" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Movement phase, while an enemy unit is within 6" of this model, for each enemy unit within 6" of this model: roll one D6: on 1, nothing happens; on 2-3, that unit suffers 1 mortal wound; on 4-5, that unit suffers D3 mortal wounds; on 6, that unit suffers D6 mortal wounds; that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="e93f-774e-2dd0-4022" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
