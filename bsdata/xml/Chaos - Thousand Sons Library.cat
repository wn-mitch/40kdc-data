      <profiles>
        <profile name="Deep Strike" id="7dd3-67a1-12a3-1d61" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends an Ingress move, while this unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slashing Dive" id="8413-1eb6-e110-44b6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends a Normal move, you can use this ability, during your Movement phase:
  - Select one enemy unit that was moved over by this unit during that move. Roll one D6 for each model in this unit: for each 4+, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
