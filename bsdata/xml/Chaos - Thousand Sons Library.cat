            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">8</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="523a-1002-79aa-219e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Devoted to Destruction" id="d6dd-1795-9e2b-24f7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is equipped with one weapon named "Close combat weapon" and this model is equipped with exactly 2 melee weapons other than "Close combat weapon", improve the Attacks characteristic of melee weapons other than "Close combat weapon" equipped by this model by 2.</characteristic>
          </characteristics>
        </profile>
        <profile name="Terrifying Assault" id="ec31-bc7c-307a-b0a8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After this unit resolves its attacks, during your Shooting phase or during the Fight phase, until the end of the phase:
  - Select one enemy unit that was hit by an attack made by the triggering unit during that shooting sequence:
    - While the selected unit is within 9" of a friendly PSYKER THOUSAND SONS unit, that unit must take a Battle-shock test, applying -1 to that test.
    - While the selected unit is not within 9" of a friendly PSYKER THOUSAND SONS unit, that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
