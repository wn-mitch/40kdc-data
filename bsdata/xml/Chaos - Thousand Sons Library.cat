        <profile name="Rebind Rubricae (Psychic)" id="c346-152e-0e6b-f609" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your Command phase, while this model is leading a unit, you can use this ability:
  - Roll one D6:
    - On 1: This unit suffers D3 mortal wounds.
    - On 2-5: Return 1 destroyed BODYGUARD model to this unit, each with its full wounds remaining.
    - On 6: Return 2 destroyed BODYGUARD models to this unit, each with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
      </profiles>
