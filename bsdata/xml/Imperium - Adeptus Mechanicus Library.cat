        <profile name="Canticles of the Omnissiah" id="30e2-7ab5-16a6-c9fa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, until the start of your next Command phase:
  Select exactly 1 distinct options (Canticles of the Omnissiah Ability):
    - At the start of your Command phase, until the start of your next Command phase: select one enemy unit: that unit is marked as machine vengeance target; while the target is tagged machine vengeance target, you can re-roll the Hit roll for attacks made by all friendly ADEPTUS MECHANICUS units.
    - This model gains the BATTLELINE keyword; Binharic Courage: while a friendly ADEPTUS MECHANICUS unit is within 6" of this model, add 1 to that unit's Objective Control characteristic; when the unit takes a Battle-shock test or when the unit takes a Leadership test: the unit gets +1 to Battle-shock rolls; the unit gets +1 to Leadership rolls.
    - While a friendly ADEPTUS MECHANICUS unit is within 6" of this model, that unit gains the Stealth ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invocation of Machine Vengeance" id="5265-0b3b-b424-882c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, until the start of your next Command phase:
  -&gt; At the start of your Command phase, until the start of your next Command phase:
    -&gt; Select one enemy unit:
      -&gt; That unit is marked as machine vengeance target.
      -&gt; While the target is tagged machine vengeance target, you can re-roll the Hit roll for attacks made by all friendly ADEPTUS MECHANICUS units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mantra of Discipline" id="1dbd-d3d5-2bc1-0cae" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, until the start of your next Command phase:
  -&gt; This model gains the BATTLELINE keyword.
  -&gt; Binharic Courage:
    -&gt; While a friendly ADEPTUS MECHANICUS unit is within 6" of this model, add 1 to that unit's Objective Control characteristic.
    -&gt; When the unit takes a Battle-shock test or when the unit takes a Leadership test:
      -&gt; The unit gets +1 to Battle-shock rolls.
      -&gt; The unit gets +1 to Leadership rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shroudpsalm" id="2ce3-dc5d-df64-dd2c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, until the start of your next Command phase, while a friendly ADEPTUS MECHANICUS unit is within 6" of this model, that unit gains the Stealth ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mechanicus Bodyguard" id="1a24-e48f-e154-b462" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly ADEPTUS MECHANICUS unit other than this model, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Self-repair Mechanisms" id="2949-99f4-6baa-4f34" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Command phase, this model regains up to D3 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="da46-4cd4-0e13-7e5d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
