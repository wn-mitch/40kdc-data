                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Eradication Cohort" id="6d06-9e26-0d3c-5317" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ca09-6e43-97e8-ecee" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Murderous Imperative" id="4121-77ae-e349-3537" hidden="false">
                  <description>While the Protector Imperative option of Doctrina Imperatives is active, you can re-roll a Hit roll of 1 for attacks made by all friendly SKITARII units.
While the Conqueror Imperative option of Doctrina Imperatives is active, you can re-roll a Wound roll of 1 for attacks made by all friendly SKITARII units.
Applies to: units with SKITARII.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="b550-3ebc-c293-9e53" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
