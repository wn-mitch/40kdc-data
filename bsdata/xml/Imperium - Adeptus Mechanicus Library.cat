        <profile name="Achillan Eye" id="f083-1776-c970-5811" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making attacks made with radium jezzail against INFANTRY targets, you can re-roll the Wound roll for attacks made by this model.
While making attacks made with Skatros transuranic arquebus against MONSTER or VEHICLE targets, you can re-roll the Wound roll for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dread Snipers" id="5683-88ea-8461-e42f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence: that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="04aa-6e2b-9b15-88c6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="Sydonian Sentinel" id="f8d8-84ea-44ee-a87a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit cannot be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="941e-1b3c-eba1-0ea5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
      </profiles>
