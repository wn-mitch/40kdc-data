      <profiles>
        <profile name="Skorpius Disintegrator" id="d20a-7d67-af2b-9b3c" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">12</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">Hull</characteristic>
          </characteristics>
        </profile>
        <profile name="Blistering Salvoes" id="acc2-0fac-5dbb-78be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making attacks made with belleros energy cannon against INFANTRY targets, this model gets +1 to Hit rolls.
While making attacks made with ferrumite cannon against MONSTER or VEHICLE targets, this model gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="9c87-fb77-5833-21c0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Broad Spectrum Data-tether" id="7342-035e-3de7-340d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time you target the unit with a Stratagem:
  -&gt; Roll one D6: on a 5+, you gain 1CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="46a9-81ae-eae6-5546" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
