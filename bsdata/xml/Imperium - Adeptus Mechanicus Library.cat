        <constraint id="ce95-07ca-e01d-b4f4" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Tech-Priest Enginseer" id="754a-2f2f-b766-735f" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">4</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">3</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Enginseer" id="a3d1-9600-d242-4644" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly ADEPTUS MECHANICUS VEHICLE unit, unless this model is leading a unit, the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="5a8f-3a30-0e8d-fa5d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Omnissiah's Blessing" id="a0d1-fda7-4347-01d1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the start of your next Command phase:
  -&gt; Select one friendly ADEPTUS MECHANICUS model within 3" of this model (each model can be selected for this ability at most once per phase across your army):
    -&gt; That model regains up to D3 lost wounds.
    -&gt; If the selected unit has the VEHICLE keyword, that model has the Feel No Pain 5+ ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vengeance for the Omnissiah" id="2ca4-f52c-2f39-a6b8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly ADEPTUS MECHANICUS VEHICLE model is destroyed, while that model is within 12" of this model, for the rest of the battle, set the Attacks characteristic of melee omnissian axe weapons equipped by this model to 6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
