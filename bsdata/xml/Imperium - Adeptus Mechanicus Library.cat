      <profiles>
        <profile name="Cybernetica Datasmith" id="2299-49a3-952b-94cb" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">4</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">3</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Protocols" id="5f4a-0648-a0ee-a080" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, while this model is leading a KASTELAN ROBOTS unit, for the rest of the battle:
  -&gt; At the start of the battle, Aegis Protocol is active.
  -&gt; Select one:
    - Protector Protocol: add 2 to the Attacks characteristic of ranged weapons equipped by KASTELAN ROBOTS models in the unit.
    - Conqueror Protocol: add 2 to the Attacks characteristic of melee weapons equipped by KASTELAN ROBOTS models in the unit.
    - Aegis Protocol: add 1 to KASTELAN ROBOTS models in the unit's Toughness characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Protector Protocol" id="33fb-25b0-c3b5-c193" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, while this model is leading a KASTELAN ROBOTS unit, for the rest of the battle, add 2 to the Attacks characteristic of ranged weapons equipped by KASTELAN ROBOTS models in the unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Conqueror Protocol" id="c541-ff58-9f52-1095" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, while this model is leading a KASTELAN ROBOTS unit, for the rest of the battle, add 2 to the Attacks characteristic of melee weapons equipped by KASTELAN ROBOTS models in the unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Aegis Protocol" id="5748-52e7-2b8f-60e0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, while this model is leading a KASTELAN ROBOTS unit, for the rest of the battle, add 1 to KASTELAN ROBOTS models in the unit's Toughness characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Data-severed" id="6b1b-de15-b759-bbcf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains at most 0 KASTELAN ROBOT models:
  -&gt; The unit loses the VEHICLE keyword.
  -&gt; The unit gains the INFANTRY keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="4448-700f-c6e7-c01e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
