      <profiles>
        <profile name="Thulia Ghuld" id="d855-02b6-4eeb-5f46" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">8</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">80mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Mechanicus Bodyguard" id="511f-4655-1aa8-ff3e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly ADEPTUS MECHANICUS unit other than this model, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rod of the War Forge" id="c94d-135e-0f55-d6e6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  Select exactly 1 distinct options:
    - Until the start of your next Command phase: select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model: ranged weapons equipped by models in that unit gain [ASSAULT]; that unit is eligible to declare a charge in a turn in which it Advanced.
    - Until the start of your next Command phase: select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model: that unit is eligible to shoot in a turn in which it Fell Back; that unit is eligible to declare a charge in a turn in which it Fell Back.
    - Until the start of your next Command phase: select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model: the Conqueror Imperative and Protector Imperative options of Doctrina Imperatives are active for that unit (and no other option is).</characteristic>
          </characteristics>
        </profile>
        <profile name="Fanatical Devotion" id="2e2d-5538-8d0b-6fe2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; Until the start of your next Command phase:
    -&gt; Select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model:
      -&gt; Ranged weapons equipped by models in that unit gain [ASSAULT].
      -&gt; That unit is eligible to declare a charge in a turn in which it Advanced.</characteristic>
          </characteristics>
        </profile>
        <profile name="Adaptive Tactics" id="6d73-4416-ab54-b44d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; Until the start of your next Command phase:
    -&gt; Select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model:
      -&gt; That unit is eligible to shoot in a turn in which it Fell Back.
      -&gt; That unit is eligible to declare a charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Fires of Mars" id="b99a-88f7-2eaa-c090" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; Until the start of your next Command phase:
    -&gt; Select one friendly unit with the SKITARII or THULIA GHULD keyword within 6" of this model: the Conqueror Imperative and Protector Imperative options of Doctrina Imperatives are active for that unit (and no other option is).</characteristic>
          </characteristics>
        </profile>
        <profile name="Secutor of Olympus" id="61a6-fd85-1798-652c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Shooting phase:
  -&gt; Select one enemy VEHICLE unit within 12" of this model:
    -&gt; Roll one D6: on a 2+, that unit suffers D3+1 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="5fdd-9e5d-728f-13dd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
