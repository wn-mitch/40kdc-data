          <profiles>
            <profile name="Accomplished Tactician" id="89d0-87d9-3615-e5c5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit shoots, you may use this ability, once per turn per model, during the Shooting phase, in the opponent's turn, until the end of the phase:
  -&gt; Select one friendly EMPEROR'S CHILDREN unit within 9" of this model that was hit by an attack made by the triggering unit during its just-finished shooting sequence, binding it as outer:
    -&gt; Select one friendly TRANSPORT unit if the bound outer is wholly within 6" of the unit and the bound outer is able to embark within that Transport, binding it as inner: the bound outer is eligible to embark into the bound inner.
Applies to: units with EMPEROR’S CHILDREN, INFANTRY.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
