      <profiles>
        <profile name="Daemonic Patrons" id="a535-1f69-1f40-8a3a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; When the unit is selected to fight, you may use this ability, until the end of the phase:
  -&gt; The unit resolves the Daemonic Patrons ability now.
  -&gt; The unit scores Critical Wounds on Wound rolls of 3+.
-&gt; At the end of the Fight phase: if the unit used the Daemonic Patrons ability this phase, unless the unit has destroyed 1+ enemy models this phase, destroy 1 model in the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
