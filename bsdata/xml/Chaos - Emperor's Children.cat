        <profile name="Doom Siren" id="4a3a-13d2-d5ea-31a1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn:
  -&gt; Select one enemy INFANTRY unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence:
    -&gt; Roll 3 D6: for each 4+, that unit suffers 1 mortal wound.
    -&gt; If the selected unit lost one or more wounds from mortal attacks from the triggering attacks, that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="20cd-c2bf-f9dc-fcb5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Obsessive Annunciation" id="7ce2-87ee-0cff-1f3f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, ranged weapons equipped by models in this unit gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
      </profiles>
