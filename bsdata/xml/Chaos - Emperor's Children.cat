    <selectionEntry name="Detachment" id="a6ad-d379-46ee-2c24" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="bfd5-c2ab-32ea-da56" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="1"/>
        <constraint id="31fe-2767-04d7-8df5" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" id="4f57-f181-aed0-1abc" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" id="f987-8fe1-82d5-ec1a" hidden="false">
          <constraints>
            <constraint id="58ad-d729-c706-acd2" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Slaanesh's Chosen" id="8635-b1cc-e7bb-e8a1" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5322-fbb5-5f62-80da" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Internal Rivalries" id="ad90-7445-cd3b-b001" hidden="false">
                  <description>If the unit has the EMPEROR'S CHILDREN keyword, if the unit has the CHARACTER keyword, the unit ignores any modifiers to its characteristics; the unit ignores any modifiers to its Advance rolls; the unit ignores any modifiers to its Charge rolls; you can re-roll a failed Wound roll.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="9ac3-fc4d-2f44-a9b4" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Carnival of Excess" id="3c9e-2156-254e-66e8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a3dd-3561-d8d6-c6c3" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Daemonic Empowerment" id="9e8d-95b3-cae9-fa9e" hidden="false">
                  <description>If the unit has the EMPEROR'S CHILDREN keyword, while the unit is within 6" of a friendly LEGIONS OF EXCESS unit, the unit's weapons gain [SUSTAINED HITS 1].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="9f43-495f-4350-3d77" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="3"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Peerless Bladesmen" id="faf3-053d-d290-a3d9" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="26ec-28a4-121e-7e12" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Exquisite Swordsmanship" id="d85b-7d26-0129-e0a1" hidden="false">
                  <description>When a friendly unit is selected to fight (the triggering unit must have EMPEROR'S CHILDREN), if the triggering unit charged this turn, until that unit finishes resolving its attacks:
  Select one of the following:
    - Melee weapons equipped by the triggering unit gain [LETHAL HITS].
    - Melee weapons equipped by the triggering unit gain [SUSTAINED HITS 1].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="4a1b-11ca-3374-4e91" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Rapid Evisceration" id="26ff-306a-fca9-ebfd" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="05fc-b5e5-e7b5-36d5" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Mechanised Murder" id="1221-87fb-a01d-7613" hidden="false">
                  <description>If the attacking unit has the TRANSPORT keyword or if the attacking unit disembarked from a Transport this turn:
  -&gt; You can re-roll a Hit roll of 1 for attacks made by all friendly EMPEROR'S CHILDREN models.
  -&gt; You can re-roll a Wound roll of 1 for attacks made by all friendly EMPEROR'S CHILDREN models.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="40fd-dd4b-0798-b191" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Mercurial Host" id="ae45-3e0d-eac7-7edb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c9c7-7d05-b06c-1125" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Quicksilver Grace" id="32aa-787b-5ba0-72a0" hidden="false">
                  <description>You can re-roll the Advance roll for all friendly EMPEROR'S CHILDREN units.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="0a53-7c3f-c17f-8aa4" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Court of the Phoenician" id="12b9-2601-5150-66f4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7068-2f01-18fb-4af1" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Sensational Performance" id="f0f0-ade1-8ea6-af00" hidden="false">
                  <description>All friendly EMPEROR'S CHILDREN units gain the Sensational Performance ability.
-&gt; When the unit is selected to fight, if the unit charged this turn, you may use this ability, until the end of the phase:
  -&gt; The unit cannot target enemy units with attacks if the target unit was engaged with this unit at the start of the turn.
  -&gt; The unit cannot target enemy units with attacks if a unit other than this unit has selected the target unit as a target this phase.
  -&gt; Improve the Strength characteristic of melee weapons equipped by models in this unit by 1.
  -&gt; Improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1.
Applies to: units with EMPEROR'S CHILDREN.</description>
                </rule>
                <rule name="Master of the Pageant" id="7082-b1aa-1ef8-0450" hidden="false">
                  <description>You gain 1CP.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="44be-f497-9800-2772" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Coterie of the Conceited" id="9db8-cf55-983f-9671" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ab50-1ca8-dcdf-2b1a" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Pledges to the Dark Prince" id="a52b-02e6-6e4a-6167" hidden="false">
                  <description>-&gt; At the start of the battle round: while a friendly model that is the Warlord is on the battlefield, declare a number as your pledge.
-&gt; At the end of the battle round:
  -&gt; If you destroyed at least as many enemy units this battle round as your pledge, you gain a number of Pact points equal to your pledge.
  -&gt; Unless you destroyed at least as many enemy units this battle round as your pledge, friendly models that are the Warlord suffer D3 mortal wounds.
All friendly EMPEROR'S CHILDREN units gain the following rules:
  -&gt; While you have 1+ pact points, you can re-roll a Hit roll of 1.
  -&gt; While you have 3+ pact points, you can re-roll a Wound roll of 1.
  -&gt; While you have 5+ pact points, melee weapons equipped by models in this unit gain [LETHAL HITS] and [SUSTAINED HITS 1].
  -&gt; While you have 7+ pact points, the unit scores Critical Hits on Hit rolls of 5+.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="6c37-7d48-b504-89e3" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="3"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Elegant Brutes" id="8aff-09e5-5ff7-e9f2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1588-930e-2a7a-6ca1" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Eager to Kill" id="d39c-ec8c-f9a9-665f" hidden="false">
                  <description>When a friendly unit is set up (the triggering unit must have EMPEROR'S CHILDREN and TERMINATOR), until the end of the turn, the unit gets +1 to Charge rolls.
Applies to: units with EMPEROR’S CHILDREN, TERMINATOR.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="4278-9155-62ab-f098" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Frenzied Host" id="9a0b-73fb-c56f-babc" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cbdf-4cda-d5b7-cd77" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Frantic Focus" id="3fa3-b676-e643-b431" hidden="false">
                  <description>When a friendly unit is selected to make an Advance or Fall Back move (the triggering unit must have BATTLELINE and EMPEROR'S CHILDREN), until the end of the turn, friendly BATTLELINE models in the triggering unit's weapons gain [SUSTAINED HITS 1].
Applies to: units with EMPEROR’S CHILDREN, BATTLELINE.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="b3d6-b825-1dca-e072" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Spectacle of Slaughter" id="68d6-d094-a5d3-9bb5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f0c5-b9ea-4cbd-a4cf" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Entitled to Victory" id="d733-3f15-1662-4cda" hidden="false">
                  <description>All friendly FLAWLESS BLADES units gain the Fights First ability.
Applies to: units with EMPEROR’S CHILDREN, FLAWLESS BLADES.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="768a-a7bc-e004-5699" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
