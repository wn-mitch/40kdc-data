        <profile name="A Challenge Worthy of Skill" id="db74-592d-c4cd-66cd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against CHARACTER, MONSTER or WALKER targets:
  -&gt; You can re-roll the Hit roll for attacks made by this model.
  -&gt; You can re-roll the Wound roll for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Duellist's Hubris" id="afa8-a255-9c3f-aac4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, unless this model is leading a unit, until the end of the phase, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="35d8-a089-51f6-89a7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="9476-1e45-b587-3a84" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="ecc2-17e2-bedd-265a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
