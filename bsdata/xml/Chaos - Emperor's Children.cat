            <characteristic name="Base" typeId="nr-base-size">Hull</characteristic>
          </characteristics>
        </profile>
        <profile name="Assault Vehicle" id="2bde-0607-a50a-53b3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model is eligible to disembark in a turn in which it Advanced.
-&gt; When a friendly unit disembarks from a Transport: if this model advanced this turn, the triggering unit cannot declare a charge.</characteristic>
          </characteristics>
        </profile>
        <profile name="Firing Deck" id="3267-f5f5-aa42-42fd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Firing Deck X ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="7adf-cc8d-7ae1-6f8f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
