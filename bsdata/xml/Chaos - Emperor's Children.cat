                <condition childId="183e-f3bb-3ce6-7b55" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint id="d220-969a-71bd-8ef1" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="3"/>
          </constraints>
          <profiles>
            <profile name="Beguiling Grotesquerie (Upgrade)" id="fe9d-1c9f-6815-fedb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Your opponent cannot target the unit with Overwatch.
Applies to: units with EMPEROR’S CHILDREN, FLAWLESS BLADES.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="1"/>
