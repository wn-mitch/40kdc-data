          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="439f-bd3d-6cda-2075" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Daemon Prince of Slaanesh with Wings" id="bccc-e86a-0c6d-ed83" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">9</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic Destruction" id="9fa3-95b6-b7a2-83b1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Charge move:
  -&gt; Select one enemy unit if the selected unit is within Engagement Range of this model:
    -&gt; Roll D6, then:
      -&gt; If the result of that roll is a 4+, that unit suffers 1 mortal wound (to a maximum of 6 mortal wounds).</characteristic>
          </characteristics>
        </profile>
        <profile name="Stimulated by Pain" id="bf10-89ea-9f7b-1a58" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Subtract 1 from the attacking unit's Damage characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="aa00-a67e-2ad2-7b0d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="7e1d-ada1-6599-f9d1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
