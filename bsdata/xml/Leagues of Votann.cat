        <profile name="Computational Mastermind" id="659b-855c-65b4-f279" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, while the unit is within range of an objective marker, if you control 1+ objectives, until the end of the phase:
  Select one of the following (Spend or Gain Yp):
    - Spend 1 YP.
    - You gain 1 YP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="0118-601c-9905-3e45" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Predictive Guidance" id="a4fd-4456-5ec7-7c1f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When you target the unit with the Fire Overwatch Stratagem, you may use this ability or when you target the unit with the Heroic Intervention Stratagem, you may use this ability, once per battle round per unit, reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).</characteristic>
          </characteristics>
        </profile>
      </profiles>
