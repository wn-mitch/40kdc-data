    <selectionEntry name="Buri Aegnirssen" id="b7e1-55fd-9aae-b690" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="c9d3-6569-5bc6-ad35" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Buri Aegnirssen" id="37d0-2614-862e-2007" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">6</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">5</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Grudge-fuelled Fortitude" id="1b68-4c52-9016-824a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of each phase, if this model was destroyed this phase (1+ times), the first time this battle per model:
  -&gt; Roll one D6: on a 2+, this model can be set up on the battlefield as close as possible to where it was destroyed more than 1" away from all enemy models, with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="2622-5c0b-1f20-efa2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="7918-0153-2214-276a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unhinged Vengeance" id="a752-37ac-2291-7da6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit shoots, during the Shooting phase, in the opponent's turn, while the model has lost wounds, until the end of the phase:
  -&gt; The unit can make a Surge move of up to D6".
  -&gt; Add 2" to the unit's Surge moves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
