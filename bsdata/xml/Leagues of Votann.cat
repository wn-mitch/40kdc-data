              <rules>
                <rule name="Optimal Application" id="cc85-b9e0-a797-36bb" hidden="false">
                  <description>For the rest of the battle:
  -&gt; During the Command phase, if you control 1+ objectives, you gain 1 YP.
  During the Shooting phase:
    -&gt; Spend 1 YP.
    -&gt; You can re-roll a Hit roll of 1.</description>
                </rule>
