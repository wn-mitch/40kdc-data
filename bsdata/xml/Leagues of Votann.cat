    <selectionEntry name="Brôkhyr Iron-master" id="8f33-5601-3707-78f4" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="bbdd-3cdb-6206-c531" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="bbdd-3cdb-6206-c531" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Brôkhyr Guild Support" id="666c-9b8b-02c2-7d43" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly IRONKIN STEELJACKS or LEAGUES OF VOTANN VEHICLE unit, unless the unit is an attached unit, the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Forgewrought Expertise" id="a870-ed95-cb99-4e82" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Select one friendly unit within 3" of the unit with the LEAGUES OF VOTANN and VEHICLE keywords or with the EXOFRAME or IRONKIN STEELJACKS keyword (each unit can be selected for this ability at most once per turn across your army): that unit regains up to D3 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="27e5-f48c-3e68-aba6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Multispectral Visor" id="e59a-2a49-81ca-844d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
