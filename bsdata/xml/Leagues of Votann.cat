      <profiles>
        <profile name="Ûthar the Destined" id="47b5-fce3-9406-3d08" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">5</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Ancestral Fortune" id="4a74-d560-3220-792e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: Once per turn per unit:
  -&gt; Spend 1 YP.
  Select one of the following:
    - One of the unit's Hit rolls counts as 6.
    - One of the unit's Wound rolls counts as 6.
    - One of the unit's saving throw rolls counts as 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grim Efficiency" id="6b77-7a6e-964a-3383" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly LEAGUES OF VOTANN unit within 12" of this model is targeted with a Stratagem, you may use this ability, once per battle round per model, reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="b3ab-6709-d7e7-d1ea" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Prioritised Efficiency" id="0bfb-090c-b39d-202a" hidden="false" targetId="e8a2-a9a7-0c99-e17f" type="rule"/>
      </infoLinks>
