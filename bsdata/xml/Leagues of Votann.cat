        <profile name="Break the Foe" id="3ae7-c58d-ad26-1159" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Melee weapons equipped by models in this unit gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="e464-fcdf-e844-aba9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="e3cf-6a8f-19b4-3969" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Relentless Avalanche" id="73fc-c891-eb7c-c7bc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: The unit is eligible to be targeted with the Heroic Intervention Stratagem even if it has already been targeted with that Stratagem this phase.
Reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).
The unit's Heroic Intervention ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Prioritised Efficiency" id="7523-3792-b38f-2be9" hidden="false" targetId="e8a2-a9a7-0c99-e17f" type="rule"/>
      </infoLinks>
