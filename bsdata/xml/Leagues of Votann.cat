        <profile name="Exemplar of the Einhyr" id="a7ce-7a15-8c59-0a9e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit:
  -&gt; The unit gets +1 to Advance rolls.
  -&gt; The unit gets +1 to Charge rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="062d-1a00-6fd4-754b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mass Driver Accelerators" id="65f9-57f7-04b2-d4b8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Charge move, you may use this ability:
  -&gt; Select one enemy unit if the selected unit is within Engagement Range of this model:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-5: That unit suffers D3 mortal wounds.
      - On 6: That unit suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
