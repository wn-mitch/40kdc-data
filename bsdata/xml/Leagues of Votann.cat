            <profile name="Bastion Shield" id="f06e-7904-a5b6-d9be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks, until the end of the phase:
  -&gt; You can: while the unit is not tagged bastion shield yp spent, spend 1 YP; the unit is marked as bastion shield yp spent until the end of the phase.
  -&gt; While the attacking unit is within 12" of the unit, unless the unit is tagged bastion shield yp spent and the attacking unit is within 18" of the unit, worsen the attacking unit's Armour Penetration characteristic by 1.
  -&gt; While the unit is tagged bastion shield yp spent, while the attacking unit is within 18" of the unit, worsen the attacking unit's Armour Penetration characteristic by 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="25"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="1"/>
