    <selectionEntry name="Warhound Titan" id="8eb5-a990-6eb0-9b41" hidden="false" import="true" type="model">
      <modifiers>
        <modifier field="3ac6-33c9-8994-23f9" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="3ac6-33c9-8994-23f9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Warhound Titan" id="3288-2658-b995-300e" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">13</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">40</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">16</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size"></characteristic>
          </characteristics>
        </profile>
        <profile name="Flank Speed" id="4755-e061-01ab-f485" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an Advance move, until the end of the phase, the unit does not make an Advance roll; add 8" to its Move characteristic instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Super-heavy Walker" id="0714-f70c-5374-2c0c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; When this model ends a Normal, Advance or Fall Back move:
  -&gt; The triggering unit can move over non-Titanic models as though they were not there.
  -&gt; The triggering unit can move over terrain features 4" or lower as though they were not there.
  -&gt; The triggering unit is eligible to move even if it is within Engagement Range of enemy units.
  -&gt; The triggering unit cannot end a move within Engagement Range of any enemy unit, during its Normal, Advance and Fall Back moves.
  -&gt; The triggering unit can move over terrain features over 4" as though they were not there.
-&gt; When this model moves through terrain over 4" tall:
  -&gt; Roll one D6:
    - On 1: The unit is Battle-shocked.
    - On 2-6: Nothing happens.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="ea40-5deb-d6cf-b68d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="5404-9d6f-7625-be82" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="fe58-ee83-a849-1c3e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Striding Colossus" id="80a1-1017-ffac-e493" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time you target the unit with a Stratagem, Stratagems that target the unit cost twice their stated CP cost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
