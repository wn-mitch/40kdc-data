        <profile name="Chaos Reaver Titan" id="6c05-621d-8675-5a47" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
