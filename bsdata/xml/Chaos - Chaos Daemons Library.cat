        <profile name="Disease of Mirth (Aura)" id="6aa4-02c8-3e13-7b47" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, while an enemy unit (excluding MONSTER or VEHICLE units) is within 6" of this model, that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Jolly Gutpipes" id="4cb0-a667-6b74-a169" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: While this model is leading a unit:
  -&gt; Add 1 to the unit's Move characteristic.
  -&gt; You can re-roll the Advance roll.</characteristic>
          </characteristics>
        </profile>
