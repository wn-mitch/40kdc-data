            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">7+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">5</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Formless Horror" id="20fb-f799-d4b0-e1ab" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an enemy unit selects its targets, until the end of the phase:
  -&gt; The triggering unit must take a Battle-shock test.
  -&gt; If the triggering battle shock roll was a failure, the triggering unit cannot target this model with attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mischief and Confusion" id="4594-ebc4-b3a4-918d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your opponent's Shooting phase, until the end of the phase:
  -&gt; Select one enemy unit if the selected unit is within 12" of this model and the selected unit is visible to this model:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-5: That unit gets -1 to Hit rolls.
      - On 6: That unit cannot shoot.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="1ec4-b6ee-f6e2-e154" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="4c73-d41c-4a48-b4e1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="00c9-44af-f70b-c9d3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
      </profiles>
