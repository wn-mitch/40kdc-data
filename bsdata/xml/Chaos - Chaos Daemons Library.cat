          </characteristics>
        </profile>
        <profile name="P'tarix's Sorcerous Syphon (Aura)" id="fbca-b287-af27-9163" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making psychic attacks, while an enemy unit is within 12" of this model, that unit gets -1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Xirat'p's Sorcerous Barrages (Psychic)" id="3f63-01fe-62f8-e907" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Movement phase:
  For each enemy unit within 6" of this model:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-3: The unit suffers 1 mortal wound.
      - On 4-5: The unit suffers D3 mortal wounds.
      - On 6: The unit suffers D6 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="bd7f-1bbf-6662-880d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="c2b8-a524-a4c9-155e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
      </profiles>
