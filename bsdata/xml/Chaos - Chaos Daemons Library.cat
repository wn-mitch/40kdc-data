          </characteristics>
        </profile>
        <profile name="Horrible Fascination (Psychic)" id="9c8a-6be5-16df-bf05" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your opponent's Shooting phase, you may use this ability, once per phase per army, if this model has the PSYKER keyword, while this model is friendly, while this model has the Horrible Fascination ability, until the end of the phase:
  -&gt; Select one enemy unit if the selected unit is within 12" of this model and the selected unit is visible to this model:
    -&gt; Roll one D6:
      - On 1: This model suffers D3 mortal wounds.
      - On 2-5: That unit gets -1 to Hit rolls.
      - On 6: That unit cannot shoot.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="d692-b1fa-04be-6b37" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Swallow Energy (Psychic)" id="8d4b-c773-22c9-68c4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, the unit has the Feel No Pain 4+ ability against Psychic Attacks and mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="e861-acc6-fb37-18fa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="d105-65e4-038a-c711" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
