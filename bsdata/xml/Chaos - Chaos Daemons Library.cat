      <profiles>
        <profile name="Daemon Prince of Chaos with Wings" id="f3f4-448c-0181-8677" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">9</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Harbinger of Death" id="2356-1f79-e83f-14ae" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to fight, until the end of the phase:
  Select one of the following:
    - Hellforged weapons equipped by this model gain [LETHAL HITS].
    - Hellforged weapons equipped by this model gain [PRECISION].
    - Hellforged weapons equipped by this model gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Malefic Destruction" id="02ed-fce3-870b-c3f9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, you may use this ability, once per battle per unit, until the end of the phase, add 3 to the Attacks characteristic of melee hellforged weapons equipped by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="0471-4c8b-c54e-9660" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="8061-b961-fc01-4df7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic Allegiance" id="8260-15a4-4675-7566" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
