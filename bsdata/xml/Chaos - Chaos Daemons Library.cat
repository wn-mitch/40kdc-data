      <profiles>
        <profile name="Lord of Change" id="3104-faa7-1ef9-e531" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">6+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">18</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">100mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Lord of Tzeentch (Aura)" id="735e-6c0c-09a9-b6cf" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks, while a friendly LEGIONES DAEMONICA TZEENTCH unit is within 6" of this model, add 1 to that unit's Strength characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Greater Daemon of Tzeentch (Aura)" id="ffbf-7a9d-e3d8-06f7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly LEGIONES DAEMONICA TZEENTCH unit is within 6" of this model, that unit counts as being within The Shadow of Chaos.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Magicks (Psychic)" id="ba5e-2bd7-4f00-5327" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn, until the end of the phase:
  Select one of the following:
    - Ranged Bolt of Change weapons equipped by this model gain [IGNORES COVER].
    - Ranged Bolt of Change weapons equipped by this model gain [LETHAL HITS].
    - Ranged Bolt of Change weapons equipped by this model gain [SUSTAINED HITS D3].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="5eac-0dfd-4b3b-4ee7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="d9e0-d7d4-e514-9db7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="0aef-ace1-b6f2-7c71" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="The Shadow of Chaos" id="b1ad-c4d7-618c-cdb0" hidden="false" targetId="1d05-942b-7d36-e2af" type="rule"/>
      </infoLinks>
