    <selectionEntry name="Pink Horrors" id="e7b8-aa40-6da7-778e" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="8f17-b43f-bfc8-7ffc" type="set" value="4">
          <conditions>
