      <profiles>
        <profile name="Tranceweaver" id="0e44-4b63-425f-27f7" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">9"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">7+</characteristic>
