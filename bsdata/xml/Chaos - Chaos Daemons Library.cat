    <selectionEntry name="Blue Horrors" id="b795-b936-ad61-e407" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="3fa9-e9da-1165-72fa" type="set" value="4">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="3fa9-e9da-1165-72fa" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="6"/>
      </constraints>
      <profiles>
        <profile name="Exploding Horrors" id="e1de-c5d8-6257-2b4a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to fight, you may use this ability:
  -&gt; Select one enemy unit if the selected unit is a unit within Engagement Range of the unit, binding it as enemy:
    -&gt; Select one or more friendly BRIMSTONE models in the unit, binding them as horrors:
      -&gt; For each selected model:
        -&gt; Roll one D6: on a 4+, destroy that model; the bound enemy suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sullen Malevolence (Aura)" id="604f-1de5-661a-93b1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains 1+ BLUE models, while an enemy unit is within 6" of this unit, worsen that unit's Leadership characteristic by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="f634-015c-7c8d-dadd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="e681-bd97-8734-29c0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Split" id="5a17-d909-9426-0f05" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly BLUE model in the unit is destroyed, after the attacking unit has resolved its attacks, while the unit is on the battlefield:
  -&gt; Roll one D6: on a 4+, add 1 Brimstone Horror model to the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
