      </constraints>
      <profiles>
        <profile name="Soul Grinder" id="89d3-c141-dd98-c0f4" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">14</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">160mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic Allegiance" id="2cf9-33be-59eb-cf31" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For the rest of the battle:
  -&gt; When selecting your army:
    -&gt; Select one (each may be chosen once per battle):
      - Khorne: this model gains the KHORNE keyword; this model gains 1 Torrent of Burning Blood weapon.
      - Tzeentch: this model gains the TZEENTCH keyword; this model gains 1 Warp Gaze weapon.
      - Nurgle: this model gains the NURGLE keyword; this model gains 1 Phlegm Bombardment weapon.
      - Slaanesh: this model gains the SLAANESH keyword; this model gains 1 Scream of Despair weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="Khorne" id="a63a-9667-f4f3-c0e8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For the rest of the battle:
  -&gt; When selecting your army:
    -&gt; This model gains the KHORNE keyword.
    -&gt; This model gains 1 Torrent of Burning Blood weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tzeentch" id="dab0-c1bf-f964-99f5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For the rest of the battle:
  -&gt; When selecting your army:
    -&gt; This model gains the TZEENTCH keyword.
    -&gt; This model gains 1 Warp Gaze weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nurgle" id="ab79-8f9f-3c41-ba9e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For the rest of the battle:
  -&gt; When selecting your army:
    -&gt; This model gains the NURGLE keyword.
    -&gt; This model gains 1 Phlegm Bombardment weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slaanesh" id="9b28-df0e-2505-12b6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">For the rest of the battle:
  -&gt; When selecting your army:
    -&gt; This model gains the SLAANESH keyword.
    -&gt; This model gains 1 Scream of Despair weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="d4a0-53e1-5332-1d53" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="479c-ffd1-140e-b2e6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scuttling Walker" id="381b-8cff-a418-7905" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal or Advance move:
  -&gt; This model can move over friendly Monster models as though they were not there.
  -&gt; This model can move over friendly Vehicle models as though they were not there.
  -&gt; This model can move over terrain features 4" or lower as though they were not there.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="6e4e-fb84-b05e-8af7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
