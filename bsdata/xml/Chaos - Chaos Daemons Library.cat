        <profile name="Discordant Disruption (Aura)" id="4020-13c5-bf16-a776" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While an enemy PSYKER unit is within 12" of this model, weapons with [PSYCHIC] equipped by that unit gain [HAZARDOUS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Harmonic Alignment" id="dc83-d6c1-ad82-9e4a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: While this model is leading a unit, during the Command phase, in your turn, return D3 destroyed Bodyguard models to the unit, each with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="2ea6-af12-58ea-637f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="d56f-b1ae-c2d5-b991" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="0123-4b1f-5135-4af0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Fights First ability, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
