  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Enhancements" id="e312-814d-e46d-d23d" hidden="false">
      <constraints>
        <constraint id="bc6b-26fd-2990-a9a5" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Slaughterthirst (Aura)" id="8d0b-296c-5515-4267" import="true" type="upgrade" hidden="false">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="21b4-7a36-fec6-b7ea" field="selections" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
              </conditions>
            </modifier>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
