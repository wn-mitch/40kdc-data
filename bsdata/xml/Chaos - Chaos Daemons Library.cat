          </characteristics>
        </profile>
        <profile name="Leader" id="bc9e-47c7-4e33-dea2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Symphony of Pain (Psychic)" id="aa49-6d8d-7d0f-4615" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Movement phase, you may use this ability:
  -&gt; Select one enemy unit if the selected unit is Battle-shocked and the selected unit is within 12" of this model (your Symphony of Pain Target). Until the end of the turn, each time a friendly unit makes an attack against it:
    -&gt; You can re-roll the Hit roll for attacks made by all friendly LEGIONES DAEMONICA SLAANESH models.
    -&gt; You can re-roll the Wound roll for attacks made by all friendly LEGIONES DAEMONICA SLAANESH models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tranceweaver" id="06fa-ba3f-0ac4-7f24" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target is not within range of an objective marker, you can re-roll a Hit roll of 1.
While the target is within range of an objective marker, you can re-roll the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="8d2c-c332-12f6-86ae" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="20e8-88a1-821b-be3c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Fights First ability, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="The Shadow of Chaos" id="1ca4-1729-139f-033c" hidden="false" targetId="1d05-942b-7d36-e2af" type="rule"/>
