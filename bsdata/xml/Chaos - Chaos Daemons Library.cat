        <profile name="Cover" id="de4e-27ad-d5ed-a9be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a ranged attack is allocated, unless the target is not fully visible to the attacking model because of this model, that unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shadow of Khorne" id="4225-e7e1-225f-d143" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Units within 6" of this model count as being within The Shadow of Chaos.
-&gt; After a friendly unit takes a Battle-shock test (the triggering unit must have KHORNE and LEGIONES DAEMONICA) within 6" of this model, you may use this ability: you can re-roll the Battle-shock roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fortification" id="1aec-c3f7-c52a-ee07" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, the attacking unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="1309-116b-90fc-3084" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
