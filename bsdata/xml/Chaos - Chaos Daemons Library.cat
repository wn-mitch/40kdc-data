      <profiles>
        <profile name="Death's Heads" id="74bf-7d26-917a-5127" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn, until the end of the turn:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence (your Deaths Heads Target). Until the end of the turn, each time a friendly unit makes an attack against it, you can re-roll the Wound roll for attacks made by all friendly LEGIONES DAEMONICA NURGLE units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="5977-add0-0f26-b149" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
