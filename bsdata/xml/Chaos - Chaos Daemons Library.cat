      </modifiers>
      <constraints>
        <constraint id="d3fa-c5d1-7915-b112" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Be'lakor" id="dea6-884d-9677-bbc0" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">20</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">100mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="d44f-6223-1641-4124" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="07f5-71f5-9a19-3b44" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shadow Form Abilities" id="38c8-dc89-3393-da5f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the battle round:
  -&gt; At the start of the battle round:
    -&gt; Select one:
      - Wreathed in Shadows: enemy models cannot target friendly units with the LEGIONES DAEMONICA or SHADOW LEGION keyword within 6" of this model with ranged attacks unless the attacking model is within 18".
      - Pall of Despair: enemy units within 9" of this model must take a Battle-shock test; this model regains up to D3 lost wounds.
      - Shadow Lord: you can re-roll a Hit roll of 1 for attacks made by friendly units with the LEGIONES DAEMONICA or SHADOW LEGION keyword within 6" of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wreathed in Shadows" id="1e67-d083-fbf1-fb4d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the battle round:
  -&gt; At the start of the battle round: enemy models cannot target friendly units with the LEGIONES DAEMONICA or SHADOW LEGION keyword within 6" of this model with ranged attacks unless the attacking model is within 18".</characteristic>
          </characteristics>
        </profile>
        <profile name="Pall of Despair" id="71cc-d6e0-b688-2de0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the battle round:
  -&gt; At the start of the battle round:
    -&gt; Enemy units within 9" of this model must take a Battle-shock test.
    -&gt; This model regains up to D3 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shadow Lord" id="db43-ae83-fceb-6ea6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the battle round:
  -&gt; At the start of the battle round: you can re-roll a Hit roll of 1 for attacks made by friendly units with the LEGIONES DAEMONICA or SHADOW LEGION keyword within 6" of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="a48c-b4b4-e100-04dd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="0ab0-de3a-6ae7-f65d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Dark Master (Aura)" id="6698-9e49-d4bb-b03e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">A terrain area is marked as shadow of chaos.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="5585-4c5e-dd2d-d54c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
