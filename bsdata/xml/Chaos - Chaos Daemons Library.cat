        <profile name="Hysterical Frenzy" id="7267-3b0e-3a9c-5f40" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a model in the unit is destroyed, unless the triggering unit has fought this phase, do not remove that model yet; after the attacking unit has finished making its attacks, it can fight; then remove it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="24f1-52c7-cb8b-bfc3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tormentbringer (Aura)" id="153d-cc17-ab32-3d47" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly LEGIONES DAEMONICA SLAANESH unit is within 6" of this model, melee weapons equipped by that unit gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="a2bc-9eb6-c77c-e621" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
