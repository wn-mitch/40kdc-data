        <profile name="Fortification" id="9107-5866-614f-ae64" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, the attacking unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shroud of Flies" id="cdcf-d00d-7b6e-436f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly LEGIONES DAEMONICA NURGLE unit is within 6" of this unit, that unit gains the Stealth ability.</characteristic>
