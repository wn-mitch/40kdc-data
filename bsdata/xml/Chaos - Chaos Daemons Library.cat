      </constraints>
      <profiles>
        <profile name="Brimstone Horror" id="d4a2-9f8b-4bc3-be85" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">7+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">1</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">8+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="HORRORS ARE PINK. HORRORS ARE BLUE. WHERE ONCE THERE WAS ONE, NOW THERE ARE TWO." id="605e-a2e8-bc89-40ac" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit contains at most 0 PINK models, the unit uses the Blue Horrors datasheet from now on, keeping its lost wounds and its position.</characteristic>
          </characteristics>
        </profile>
        <profile name="Split" id="572b-f3c2-f4b2-a7e3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly model with the BLUE or PINK keyword in the unit is destroyed, after the attacking unit has resolved its attacks, while the unit is on the battlefield:
  -&gt; Roll one D6: on a 4+, if that model has the PINK keyword, add 2 Blue Horror models to the unit; if that model has the BLUE keyword, add 1 Brimstone Horror model to the unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="7945-935f-31c8-1c1a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="The Shadow of Chaos" id="9539-d1cc-005a-5742" hidden="false" targetId="1d05-942b-7d36-e2af" type="rule"/>
