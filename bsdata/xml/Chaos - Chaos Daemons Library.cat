        <profile name="Dazzling Acrobatics" id="5106-8a1a-9cb8-964d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model is eligible to declare a charge in a turn in which it Advanced.
This model is eligible to declare a charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fights First" id="fc07-f42d-f40b-785e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Fights First ability, the unit gains the Fights First ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="443b-9fbd-a4da-1b4e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="The Eternal Dance" id="513b-7978-7fb9-f5a2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase:
  -&gt; Select one enemy unit within 6" of this model (your The Eternal Dance Target). Until the end of the phase:
    -&gt; Each time a friendly unit makes an attack against it, while making melee attacks, all friendly LEGIONES DAEMONICA SLAANESH models get +1 to Wound rolls.
    -&gt; While it is your target, while making melee attacks, the selected unit gets -1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="7f8d-d3a9-b9ec-5c6a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
