        <profile name="Deadly Demise" id="5fa6-2b9d-dac9-236c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sunderer of Fortresses" id="e3fe-9436-43ed-efbe" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against VEHICLE targets:
  - Against a unit that is not a FORTIFICATION:
    - Improve this model's Strength characteristic by 1.
    - Improve this model's Damage characteristic by 1.
  - Against FORTIFICATION targets:
    - Improve this model's Strength characteristic by 2.
    - Improve this model's Damage characteristic by 2.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="4b4e-a625-a984-ace4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="de0c-fb0e-0bca-1fc4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
