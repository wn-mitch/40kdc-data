      <profiles>
        <profile name="Knight Destrier" id="b292-cf02-8f9e-5976" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">18</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">8</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">95x150mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Ram Jets" id="d754-af8e-b58b-e847" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is selected to make a Normal or Advance move, until the end of the phase, add D3" to this model's Move characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Thundercharge" id="29c7-5936-81fe-a2df" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is equipped with one weapon named "Thundershock spear" and this model is equipped with one weapon named "Bellatus reaper chainsword", add 2 to the Attacks characteristic of melee weapons equipped by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Saturation Fire" id="18f0-b454-8723-c441" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks, while the target is within range of an objective marker, ranged weapons equipped by this model gain [IGNORES COVER].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="3de6-3cf6-2f69-9c7d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="a824-6ec5-75b7-2463" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="02bb-0fef-84da-5675" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
