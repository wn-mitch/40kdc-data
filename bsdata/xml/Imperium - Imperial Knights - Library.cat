          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can use this ability: The Crushing Impact Stratagem that targets this unit costs 0 CP.
This model's Crushing Impact ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="355d-4ff9-2d5c-0db8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="60c4-88d4-38a5-fa49" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lancer's Duty" id="6711-8241-f429-a746" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If a friendly model that is Bondsman-affected by this unit advanced this turn, that model is eligible to declare a charge even if it Advanced this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="38b4-69cc-79db-3004" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
