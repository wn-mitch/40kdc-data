    <selectionEntry name="Detachment" id="5a84-ea91-b707-1656" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="15a7-d21a-dd25-09d2" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="1"/>
        <constraint id="49cd-dd74-1ebb-b281" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" id="a981-0417-0699-53f5" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" id="acb0-2368-af43-e062" hidden="false">
          <constraints>
            <constraint id="abec-754a-3cd4-ef5d" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Valourstrike Lance" id="e424-58f3-8e79-19a6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="14c4-30d3-643d-b96e" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Bold Gallantry" id="0ff9-8e83-02a3-e694" hidden="false">
                  <description>Each time a friendly IMPERIAL KNIGHTS unit ends an Advance move, until the end of the turn, ranged weapons equipped by friendly IMPERIAL KNIGHTS models gain [ASSAULT].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="bb6d-a384-a3a4-a345" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Questor Forgepact" id="9a4a-a4c8-a16a-c969" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b599-2503-fb83-eec1" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Cogbound Alliance" id="125d-9823-80a9-da40" hidden="false">
                  <description>If this unit has the IMPERIAL KNIGHTS keyword:
  - Add 1 to the Ballistic Skill characteristic of friendly ADEPTUS MECHANICUS units within 6".
  - Ranged weapons equipped by friendly ADEPTUS MECHANICUS units within 6" gain [HEAVY].
If this unit has the TECH PRIEST keyword, during the Command phase:
  - Select up to one friendly IMPERIAL KNIGHTS model within 3" of this model (each model can be selected for this ability at most once per phase across your army). That model regains up to D3 lost wounds.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="484d-b296-d48c-213d" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Gate Warden Lance" id="884c-fbb7-9f22-1297" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ed84-a04e-47b3-767e" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Dauntless Defenders" id="8af9-99ac-8a61-6c24" hidden="false">
                  <description>While this unit is within Defensive Line:
  - This unit ignores any modifiers to its Hit rolls.
  - This model's weapons gain [SUSTAINED HITS 1].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="93bf-b589-7348-e703" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Spearhead-at-Arms" id="d469-239c-7e4c-4210" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4ee9-e604-88b9-bb3c" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Knightly Teachings" id="8a9f-5ffb-9686-2cd7" hidden="false">
                  <description>Each time a friendly model uses a Bondsman ability, you can use this ability, unless a friendly model other than that unit used that same ability this turn, for this activation:
  - Unless your army is honoured, replace that ability's selection with up to 3 friendly ARMIGER models within 12" of that unit that are not Bondsman-affected; those recipients are affected by that same ability until the start of your next Command phase.
  - If your army is honoured, replace that ability's selection with up to 3 friendly ARMIGER models within 15" of that unit that are not Bondsman-affected; those recipients are affected by that same ability until the start of your next Command phase.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="5ff4-83f2-f958-9e63" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
                <categoryLink name="Detachment Tag: armigers" id="7198-ce0e-bdb6-3d39" hidden="false" primary="false" targetId="0911-1532-9b9e-6542"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Questoris Companions" id="a692-b024-09d9-b79f" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="351d-1ef8-fd2b-ac9b" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Heroes of Legend" id="28b0-e374-c6d9-e771" hidden="false">
                  <description>At the start of your turn, if the Code Chivalric oath is fulfilled, this unit resolves the Code Chivalric Oath procedure again.
When selecting deeds and qualities for Code Chivalric for this unit; exclude previously selected deeds and qualities; if a duplicate is rolled, choose an unselected result in that domain; stop when every domain is exhausted.
Friendly models with the Code Chivalric ability retain qualities from fulfilled Code Chivalric Oaths.
For this unit, on completion of additional Code Chivalric deeds, regardless of how those deeds were selected, replace their reward with: you gain 1 CP.</description>
                </rule>
                <rule name="Valour's Reward" id="11c4-e814-61ef-c0df" hidden="false">
                  <description>For the rest of the battle:
  - Friendly units that are designated as Enhancement Expended cannot use Enhancements.
  - When you fulfil an Oath, friendly units that are designated as Enhancement Expended are no longer designated as Enhancement Expended.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="d806-1eab-7426-29e2" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
                <categoryLink name="Reconnaissance" id="bff4-228b-6148-5280" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
