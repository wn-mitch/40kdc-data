        <profile name="Repair Auto-simulacra" id="c4e2-d215-9385-54f3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Command phase, this model regains up to D3 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="a34b-4ccc-7978-4813" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="6e07-ac69-cd06-0876" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Magaera's Duty" id="b69a-909a-77a5-cdbe" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the Magaeras Duty is active, while making ranged attacks, if the target is the closest eligible target:
  - Improve this unit's Strength characteristic by 1.
  - Improve this unit's Armour Penetration characteristic by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="ac5b-3395-9106-382d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
