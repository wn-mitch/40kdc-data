        <modifier field="bee1-9cf3-baab-d893" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="bee1-9cf3-baab-d893" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Knight Crusader" id="d956-e15c-d576-bf36" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">26</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">10</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">109x170mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Punishing Salvoes" id="5ea6-fbcd-1cb2-f641" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your Movement phase, if this model remained stationary this turn, until the end of the turn, ranged weapons equipped by this model gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="d82d-ff29-decf-22fe" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Crusader's Duty" id="c148-9dae-314b-b2b7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the attacking unit is Bondsman-affected by this unit, while making ranged attacks, add 1 to friendly units' Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="ca0a-ef4f-eadd-803e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="7e12-5196-7c70-af8c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
