    <selectionEntry name="Knight Gallant" id="eb4-4a67-11e9-3cb8" hidden="false" import="true" type="model">
      <modifiers>
        <modifier field="dc4c-d37d-e403-3b16" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="dc4c-d37d-e403-3b16" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Knight Gallant" id="a7af-67b2-ed19-f95f" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">26</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">10</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">109x170mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Martial Pride" id="a57b-f0c8-889d-49a3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit ends a Consolidation move, if you are engaged on one or more fronts, add 3" to this unit's Consolidation moves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="312b-0227-2e02-3cd9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="49e3-3a0d-f88b-882f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gallant's Duty" id="20ba-637e-9525-f3a4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the Gallants Duty is active:
  - You can re-roll the Charge roll.
  - While making melee attacks, you can re-roll Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="20c8-a1cd-1d26-6c24" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
