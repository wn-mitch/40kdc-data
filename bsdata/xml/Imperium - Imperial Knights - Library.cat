        <profile name="Ion Aegis (Aura)" id="e670-ce1c-09ec-9892" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making ranged attacks, friendly ARMIGER models within 6" of this model have the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Thundershock" id="8a9a-f47d-6dd2-7d48" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During your Shooting phase:
  - When this model selects its targets with thundercoil harpoon weapons:
    For each enemy unit that is the same unit as the target unit or an enemy unit within 6" of the target unit:
      - Roll one D6: on a 4+, that unit is struck by arcing energies until the end of the phase.
  - After this model resolves its attacks:
    For each unit that is struck by arcing energies: That unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="c1e1-87f3-84d4-a992" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves, roll one D6: on a 6+, for each unit: while this unit is within 6" of this model, that unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="03ea-37b7-7ebf-9759" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, subtract 1 from this model's Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged Objective Control" id="794f-4365-ef69-4508" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model is Damaged, subtract its rating from this model's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
      </profiles>
