    <selectionEntry name="Brotherhood Techmarine" id="f667-5267-f241-37" hidden="false" import="true" type="model">
      <modifiers>
        <modifier field="c865-6479-f1e2-077d" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="c865-6479-f1e2-077d" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Brotherhood Techmarine" id="e813-c5bd-8fe2-9cd7" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">4</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc"></characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Blessing of the Omnissiah" id="d037-bf36-81d9-050e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; Select one friendly GREY KNIGHTS VEHICLE model if the selected unit is within 3" of this model (each model can be selected for this ability at most once per turn across your army):
    -&gt; That model regains up to D3 lost wounds.
    -&gt; That model gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Guardians of the Machine" id="ad3e-0d92-47f2-f501" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a Charge move, you may use this ability, while the triggering unit is a unit within Engagement Range of a friendly GREY KNIGHTS VEHICLE unit, while the triggering unit is within 6" of the unit:
  -&gt; The unit is eligible to be targeted with the Heroic Intervention Stratagem even if it has already been targeted with that Stratagem this phase.
  -&gt; Reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).
  -&gt; The unit's Heroic Intervention ability has no limit on its number of uses, and this use does not count toward that ability's limit for other units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="1840-4dd5-34a4-cb26" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Techmarine" id="b547-79f4-2033-e47c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly GREY KNIGHTS VEHICLE unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="b8e8-bafc-ab81-c0bb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
