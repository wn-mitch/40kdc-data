        <profile name="Champion of the Order of Purifiers (Psychic)" id="3c80-4aba-954f-940b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, add 1 to the Attacks characteristic of ranged purifying flame weapons equipped by models in this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Foesight (Psychic)" id="3bad-0e33-5893-964f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Against CHARACTER targets, you can re-roll the Hit roll for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="b088-ee6b-143a-1f38" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
