      </constraints>
      <profiles>
        <profile name="Grand Master Voldus" id="d1d3-3d8e-d5d2-dac1" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">6</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">7</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">40mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Hammer Aflame (Psychic)" id="84c6-f80b-b7c9-5531" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to fight, you may use this ability:
  -&gt; Select one enemy unit if the selected unit is a unit within Engagement Range of the unit:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-3: That unit suffers 1 mortal wound.
      - On 4-5: That unit suffers D3 mortal wounds.
      - On 6: That unit suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="f0e2-3054-9902-13b4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sanctuary (Psychic)" id="7961-ac5d-48b1-a88c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Stealth ability.
Against melee attacks, the attacking unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="3e34-95ad-d8d8-e4ba" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Gate of Infinity" id="7fa8-1ae4-0451-b21e" hidden="false" targetId="1426-6657-b497-fa07" type="rule"/>
      </infoLinks>
