          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: Once per phase per model, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one friendly unit if the selected unit has the Primed and Ready ability: the Grenade Stratagem costs 0CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="65a7-b397-cdd4-b014" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
