        <profile name="Cult Demagogue" id="6b8d-1695-4f5a-0fe4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, the unit gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Decoys and Misdirection" id="5942-7de3-725c-0733" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After deployment, you may use this ability, once per battle per army:
  -&gt; Select up to 3 friendly GENESTEALER CULTS units:
    -&gt; For each selected unit:
      Select one of the following:
        - That unit can be set up on the battlefield.
        - That unit can be placed into Strategic Reserves, ignoring any limits on units in Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="7868-876e-76a1-bc29" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="8e6d-0109-f8b4-f813" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
