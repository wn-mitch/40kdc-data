      <profiles>
        <profile name="Jackal Alphus" id="6b3e-a48d-288e-c63c" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
