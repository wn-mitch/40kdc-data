          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="f514-dea0-8ca5-1b1b" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Kelermorph" id="37fc-c1c6-8212-af7e" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">3</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">5+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">3</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="4857-9a0b-24fa-109d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Heroic Fusillade" id="39a4-097a-2f5e-39d6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After a friendly model with the Heroic Fusillade ability shoots, you may use this ability, once per turn per army:
  -&gt; Select one enemy INFANTRY unit that was hit by an attack made by the triggering model during its just-finished shooting sequence: that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hypersensory Abilities" id="e4c0-51e3-cdc7-04e8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a move, you may use this ability, once per turn, while the triggering unit is within 8" of this model, while the unit is unengaged:
  -&gt; This model is eligible to shoot as if it were your Shooting phase.
  -&gt; This model must target the triggering unit with ranged attacks.
  -&gt; This model can make a Normal move of up to D6".</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="ea52-1de8-3ba0-8e73" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Character" id="96ac-d0ab-65e7-7623" hidden="false" primary="true" targetId="9cfd-1c32-585f-7d5c"/>
