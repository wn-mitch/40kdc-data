    <entryLink name="Detachment" id="10ef-6da2-5893-0e59" hidden="false" import="true" targetId="b96c-3fb6-1ee9-15ae" type="selectionEntry"/>
  </entryLinks>
  <infoLinks>
    <infoLink name="Cult Ambush" id="3b7d-5959-5fc5-7c7f" hidden="false" targetId="3db3-80e4-899c-debf" type="rule"/>
  </infoLinks>
  <sharedSelectionEntries>
    <selectionEntry name="Atalan Jackals" id="3a81-2b84-bf4c-4f85" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="51b2-306e-1021-d207" type="set" value="150">
          <conditions>
            <condition childId="model" field="selections" includeChildSelections="true" scope="3a81-2b84-bf4c-4f85" shared="true" type="atLeast" value="6"/>
          </conditions>
        </modifier>
        <modifier field="51b2-306e-1021-d207" type="set" value="150">
          <conditions>
            <condition childId="model" field="selections" includeChildSelections="true" scope="3a81-2b84-bf4c-4f85" shared="true" type="atLeast" value="10"/>
          </conditions>
        </modifier>
        <modifier field="729d-1125-b972-a447" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="729d-1125-b972-a447" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Demolition Run" id="2187-09eb-e3fe-3db8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal, Advance or Fall Back move, you may use this ability, once per turn per unit, during the Movement phase, in your turn:
  -&gt; Select one enemy unit if the selected unit is within 6" of the unit and the selected unit is visible to the unit: roll one D6 for each friendly ATALAN JACKALS model in the unit: for each 4+, that unit suffers 1 mortal wound (to a maximum of 6 mortal wounds).</characteristic>
          </characteristics>
        </profile>
        <profile name="Outrider Gangs" id="12a5-5e2d-a4ac-450f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit arrives from Strategic Reserves, while the unit is within 0" of a cult ambush marker, for the rest of the battle:
  -&gt; This model can be removed from the battlefield and set up again.
  -&gt; Spend 1 Cult Ambush marker.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scouts" id="5e83-4ce6-43d1-7896" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Scouts X" ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
