            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase, you may use this ability, once per battle per unit, until the end of the phase, this model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="5076-fab0-1f3d-73c6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
