    <selectionEntry name="Detachment" id="b96c-3fb6-1ee9-15ae" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="edd1-9685-11e1-88f2" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="1"/>
        <constraint id="3708-c7eb-9e6f-81de" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" id="c938-7fd0-eabf-8669" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" id="ebdc-96c9-a0e5-56d3" hidden="false">
          <constraints>
            <constraint id="b724-68f9-1cab-aca2" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Brood Brothers Auxilia" id="9c3e-2c2a-6308-21d7" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8cb6-0795-7f5b-0c66" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Integrated Tactics" id="9b1d-7ab7-e0fe-b511" hidden="false">
                  <description>When a friendly unit is selected to shoot (the triggering unit must have ASTRA MILITARUM), you may use this ability, until the end of the phase:
  -&gt; Select one enemy unit if the selected unit is within 18" of the triggering unit and the selected unit is visible to the triggering unit:
    -&gt; The triggering unit must target that unit with ranged weapons.
    -&gt; That unit is caught in overlapping fire.
    -&gt; While the target is caught in overlapping fire, while making ranged attacks, all friendly GENESTEALER CULTS models get +1 to Hit rolls.</description>
                </rule>
                <rule name="Brood Brothers" id="8475-3762-f8ab-287d" hidden="false">
                  <description>Your army can include ASTRA MILITARUM units (excluding AIRCRAFT, COMMISSAR, EPIC HERO, MILITARUM TEMPESTUS, OGRYN, RATLING, TECH-PRIEST ENGINSEER or MINISTORUM PRIEST units).
The unit must be your Warlord.
All friendly ASTRA MILITARUM units lose the Voice of Command ability.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="1c2f-b5b8-1683-eaf9" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Biosanctic Broodsurge" id="ff11-0fa4-2950-380e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9e97-4444-0d55-2651" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Hypermorphic Fury" id="41b4-fe22-3b28-b6a2" hidden="false">
                  <description>The unit gets +1 to Charge rolls.
-&gt; When a friendly unit is selected to fight (the triggering unit must have ABERRANTS, BIOPHAGUS or PURESTRAIN GENESTEALERS), until the end of the phase: if the triggering unit charged this turn, add 1 to the Attacks characteristic of melee weapons equipped by the triggering unit.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="17bb-6528-607c-bb23" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Outlander Claw" id="59e2-4fec-2b00-b1e8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e105-afb2-cfde-5c94" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Rapid Takeover" id="e963-4dc5-867b-4cfe" hidden="false">
                  <description>While the unit is not Battle-shocked, add 1 to this model's Objective Control characteristic.
-&gt; At the end of the Command phase: if you control 1+ objectives, while a friendly ATALAN JACKALS unit is within range of an objective marker you control, objective markers this model controls remain under your control until your opponent's Level of Control over them is greater than yours at the end of a phase.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="5309-59cc-9ccb-d9a7" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Final Day" id="cb2f-554e-1162-75d5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1c87-fd35-bcd9-8d21" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Psionic Parasitism" id="61ff-d3d0-513b-8fc3" hidden="false">
                  <description>-&gt; At the end of your Movement phase, until the start of your next Movement phase:
  For each friendly SYNAPSE TYRANIDS unit:
    -&gt; You can:
      -&gt; Select one friendly GENESTEALER CULTS unit (excluding PATRIARCH or PURESTRAIN GENESTEALERS units) if the selected unit is within 9" of the unit and the selected unit is visible to the unit, binding it as cult:
        -&gt; Select one friendly TYRANIDS unit if the selected unit is within 9" of the unit and the selected unit is visible to the unit, binding it as brood:
          -&gt; Roll D3+1, then:
            -&gt; The bound cult suffers a number of mortal wounds equal to the result of that roll.
            -&gt; One model in the bound brood regains up to a number of lost wounds equal to the result of that roll.
          -&gt; The bound brood gets +1 to Hit rolls.
All friendly TYRANIDS units gain the Catalyst ability:
  -&gt; While an enemy unit is within 6" of this unit, if the attack targets that unit, all friendly GENESTEALER CULTS units get +1 to Hit rolls.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="66ad-4751-d259-88ef" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Xenocreed Congregation" id="536a-b3ea-7597-81bb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="232e-4d40-ac46-3e9d" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Unquestioning Fanaticism" id="97e2-3699-42af-d3d0" hidden="false">
                  <description>While this model is leading a unit:
  -&gt; You can re-roll a failed Advance roll.
  -&gt; You can re-roll a failed Charge roll.
  -&gt; If the unit has the MAGUS, PRIMUS or ACOLYTE ICONWARD keywords, this model has the Feel No Pain 3+ ability.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="24bd-fe88-7ed2-4f6d" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Host of Ascension" id="0a79-5968-68f0-56b5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5796-6167-9f0d-83bb" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="A Perfect Ambush" id="d7b1-737f-8e74-b4b6" hidden="false">
                  <description>Each time a friendly unit ends an ingress move (the triggering unit must have GENESTEALER CULTS), until the end of your next Fight phase, the triggering unit's weapons gain [SUSTAINED HITS 1] and [IGNORES COVER].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="ef10-9ef4-ddb0-8474" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
                <categoryLink name="Detachment Tag: hosts" id="ad13-eaeb-ef5a-c01b" hidden="false" primary="false" targetId="d98e-36f2-ae09-0a88"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="3"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Heroes of the Uprising" id="fc4a-2c42-6f33-0347" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3899-7aed-316c-6fd9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Killer Reputation" id="8f01-bd5d-87f8-70c3" hidden="false">
                  <description>All friendly models with the KELERMORPH, LOCUS, REDUCTUS SABOTEUR or SANCTUS keyword gain the KILLER keyword.
You can re-roll a Hit roll of 1 for attacks made by all friendly KILLER models.
You can re-roll a Wound roll of 1 for attacks made by all friendly KILLER models.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="e663-9254-32be-b699" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
