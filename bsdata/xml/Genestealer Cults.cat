            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, melee weapons equipped by models in this unit gain [LETHAL HITS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="662c-d279-aa3f-660c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="a4ca-66da-dd7a-f313" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
