          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="e404-831c-aa5d-6fb6" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Bomb Squigs" id="eb29-5119-21ce-748d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal move, you may use this ability, twice per battle per unit, during the Movement phase, in your turn:
  -&gt; Select one enemy unit visible to this model if the selected unit is within 12" of the unit:
    -&gt; Roll one D6: on a 3+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rokkit Barrage" id="5411-8538-2d57-8171" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After the unit resolves its attacks, during the Shooting phase, in your turn:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence: that unit must take a Battle-shock test, applying -1 to that test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
