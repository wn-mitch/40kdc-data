        <profile name="Beast Snagga Following" id="925f-dfbb-92e0-36e0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly BEAST SNAGGA unit (excluding CHARACTER MONSTER units), the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Da Bigger Dey Iz..." id="61db-4839-35f2-21b4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making melee attacks, while the target is an enemy unit with the MONSTER or VEHICLE keyword, you can re-roll the Wound roll with melee weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="One Last Kill" id="bbef-155f-ed92-5678" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Before this model is removed from play, until the end of the phase, during the Fight phase, unless the unit has fought this phase, roll one D6. On a 2+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="d6e9-fe9d-68f6-f518" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
      </profiles>
