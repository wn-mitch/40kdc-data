          <profiles>
            <profile name="Temperamental Shokka (Upgrade)" id="ee3b-e335-dfc3-4f5b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Roll one D6:
    - On 1: Ranged Shokk Attack Gun weapons equipped by this model gain [TORRENT]; after the unit resolves its attacks: destroy this model.
    - On 2-5: Improve the Attacks characteristic of ranged shokk attack gun weapons equipped by this model by 1.
    - On 6: Ranged Shokk Attack Gun weapons equipped by this model gain [SUSTAINED HITS 2].
Applies to: units with BIG MEK WITH SHOKK ATTACK GUN.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="20"/>
            <cost name="Enhancements" typeId="f759-1bc4-cb3a-f0d2" value="1"/>
