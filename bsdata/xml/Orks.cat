        <profile name="Drive-by Skorchin'" id="5fdc-9915-50a1-c085" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Movement phase, in your turn, until the end of the turn:
