        <profile name="That'll Learn Ya" id="844d-c891-4300-9ba0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After a Battle-shock test is made, if the unit is Battle-shocked and the unit contains 4+ GRETCHIN models, you may use this ability, once per battle round per unit:
  -&gt; Destroy D3 of the GRETCHIN models in the unit.
  -&gt; The unit is no longer Battle-shocked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="e21d-d370-7aa7-2a37" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
