    <selectionEntry name="Stompa" id="6c08-9131-14a3-a3b4" hidden="false" import="true" type="model">
      <modifiers>
        <modifier field="a075-e63e-d13e-dc00" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="a075-e63e-d13e-dc00" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Stompa" id="c2c8-99a1-a2a5-bc6d" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">14</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">30</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">12</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">6+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">Hull</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="9aa0-5033-7bbd-4cf7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Idol of Belligerence" id="2dd3-2264-5496-76c1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly unit embarked within the unit is selected to make a Disembark move, during the Movement phase, in your turn, until the start of your next turn, the triggering unit is riled up.</characteristic>
          </characteristics>
        </profile>
        <profile name="Waaagh! Effigy" id="e74c-fb86-2662-86e0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit is riled up.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="60aa-ff20-487e-992b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Super-heavy Walker" id="891a-2643-4913-d6d8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Until the end of the turn:
  -&gt; This model can move over models excluding titanic and terrain as though they were not there; this model cannot end a move within Engagement Range of any enemy unit, during its Normal, Advance and Fall Back moves.
  If this model moved:
    -&gt; Roll one D6: on exactly 1, the unit is Battle-shocked.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Waaagh!" id="d6c3-cf98-a122-a4ab" hidden="false" targetId="6ac2-fce9-ef59-43eb" type="rule"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink name="Vehicle" id="08c7-2c54-db30-de83" hidden="false" primary="true" targetId="dbd4-63-af05-998"/>
