    <selectionEntry name="Detachment" id="73c2-d0ed-3c7e-7e17" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6c45-1110-46ae-cf01" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="min" value="1"/>
        <constraint id="7c1d-b06c-b0d2-b3c1" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" id="eb0a-d742-7b75-701b" hidden="false" primary="true" targetId="4ac9-fd30-1e3d-b249"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Detachment" id="7961-3b2d-1b51-4ec7" hidden="false">
          <constraints>
            <constraint id="bc80-7657-44ba-8923" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Blitz Brigade" id="63cc-721f-b263-9d4a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="307e-b3c2-ef82-001a" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Unstoppable Momentum" id="9dc9-7d26-c287-e349" hidden="false">
                  <description>You can re-roll the Charge roll for all friendly WAGON units.
-&gt; When a friendly unit is selected to make an Advance move (the triggering unit must have WAGON): the unit's Advance rolls count as 6.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="a82f-113e-2f4f-ef03" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Brute Bosses" id="09b2-b286-7608-d613" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a300-afd1-9683-e987" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="'Ard As Nails" id="2b07-1ac6-3c0f-e331" hidden="false">
                  <description>When a friendly WARBOSS model in the unit is destroyed:
  -&gt; Unless the unit has fought this phase, while the unit is riled up, roll one D6+1. On a 3+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.
  -&gt; Unless the unit has fought this phase, while the unit is not riled up, roll one D6. On a 3+, leave that model on the battlefield; when its unit is selected to fight, it can fight. Remove it after this unit has fought or at the end of the phase, whichever comes first.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="2fbf-d9fb-789d-60f6" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Bully Boyz" id="4b17-a73a-7a0a-a265" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b5c1-68d8-d25b-c77a" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Displays of Savagery" id="b2cd-3184-89e1-e879" hidden="false">
                  <description>Melee weapons equipped by all friendly units with the MEGANOBZ or NOBZ keyword gain [SUSTAINED HITS 1].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="145d-50de-0bf7-a6f6" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Da Big Hunt" id="80e6-2190-9767-a7ed" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="911c-043e-50a2-4a29" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Da Hunt Is On" id="851f-5eb0-1d53-b8d8" hidden="false">
                  <description>While the target is an enemy unit with the MONSTER or VEHICLE keyword, improve all friendly BEAST SNAGGA units' Armour Penetration characteristic by 1.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="5fa7-ec48-3bc6-67d7" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Dread Mob" id="807c-9732-5465-5ca5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="72bc-8363-8eed-4752" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Try Dat Button!" id="63cb-f028-b45a-22e1" hidden="false">
                  <description>During the Shooting phase, in your turn or during the Fight phase, until the end of the phase:
  -&gt; When a friendly unit is selected to shoot or fight (the triggering unit must have ORKS and WALKER) (the triggering unit must not have TITANIC), you may use this ability:
    Select one of the following:
      - Roll one D6: on 1-2, improve the triggering unit's Attacks characteristic by 1; on 3-4, improve the triggering unit's Strength characteristic by 2; on 5-6, improve the triggering unit's Armour Penetration characteristic by 1.
      - Roll 2 D6 and resolve each one (re-rolling any repeated result): on 1-2, improve the triggering unit's Attacks characteristic by 1; on 3-4, improve the triggering unit's Strength characteristic by 2; on 5-6, improve the triggering unit's Armour Penetration characteristic by 1; after the triggering unit resolves its attacks: the triggering unit must take a Hazard test.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="f4e9-8cab-11c7-7d67" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Flyboyz" id="7c3c-fb9c-8689-8c7a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d93c-fe98-dc56-749a" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Skyborne Loons" id="c56a-44f4-ed87-0ba8" hidden="false">
                  <description>All friendly AIRCRAFT ORKS units do not count toward the points limit for Strategic Reserves.
While a friendly ORKS unit with the AIRCRAFT or DEFFKOPTAS keyword is riled up, that unit gets +1 to Hit rolls with ranged weapons.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="dabe-ba4e-0876-3b09" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Green Tide" id="795f-b961-9504-bd08" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8cef-4f89-1a14-8519" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Mob-Handed Brutality" id="c204-b523-d3cb-64e7" hidden="false">
                  <description>Melee weapons equipped by all friendly BOYZ units gain [SUSTAINED HITS 1].
If a friendly INFANTRY ORKS unit charged this turn against a unit that is not a MONSTER or VEHICLE, melee weapons equipped by that unit gain [LETHAL HITS].</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="6a2f-bbfb-7b86-6358" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Kult of Speed" id="b404-44f-e9b4-7fe2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2322-a7f0-2c46-4ae2" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Adrenaline Junkies" id="b5c2-b1f1-f9ae-98d7" hidden="false">
                  <description>All friendly WARBIKERS units gain the BATTLELINE keyword.
-&gt; When a friendly unit is selected to make an Advance or Fall Back move (the triggering unit must have SPEED FREEKS), until the end of the turn:
  -&gt; Ranged weapons equipped by the triggering unit gain [ASSAULT].
  -&gt; The triggering unit is eligible to declare a charge even if it Advanced this turn or it Fell Back this turn.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Reconnaissance" id="5cef-5c73-5b3b-db33" hidden="false" primary="false" targetId="b4a7-5083-fe94-4d24"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Madcap Meks" id="9ae4-56d1-1fd8-adcf" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f08e-510b-5350-f6f0" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Unpredictable Genius" id="abe9-1653-fdc3-1987" hidden="false">
                  <description>When a friendly unit selects its targets (the triggering unit must have BIG MEK, MEK GUNZ, MORKANAUT or WAZBOM BLASTAJET), during the Shooting phase, in your turn, while making ranged attacks, when all of the unit's attacks target the same enemy unit, until this unit has resolved its ranged attacks:
  -&gt; Roll one D6:
    - On 1: The target has a 4+ invulnerable save.
    - On 2-3: Select one enemy unit other than the target if the selected unit is within 3" of the target unit: that unit suffers D3 mortal wounds.
    - On 4: The unit gets +1 to Hit rolls.
    - On 5: The target gains the FLY keyword; the target cannot benefit from Cover.
    - On 6: Worsen the target's Toughness characteristic by 1.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="8b25-1474-a156-371c" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Runt Swarm" id="7b06-be3a-9754-1bd4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="010f-1aea-1cad-906d" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Sneaky Little Gitz" id="c25a-e11c-9502-dc74" hidden="false">
                  <description>All friendly GRETCHIN units gain the BATTLELINE keyword.
-&gt; When a friendly unit is selected to make an Advance or Fall Back move (the triggering unit must have GRETCHIN): the triggering unit is eligible to start an Action.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="1189-bba4-6b3f-10ff" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Shoota Boyz" id="fca1-ecdf-4e4a-df41" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bdc7-880d-05f3-47ae" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Dakka! Dakka! Dakka!" id="d592-a36f-afdc-653c" hidden="false">
                  <description>Ranged weapons equipped by all friendly INFANTRY ORKS units gain [ASSAULT].
While the unit is riled up, add 3 to the Range characteristic of ranged weapons equipped by models in this unit.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Purge the Foe" id="ede2-dde6-fa7b-b8e2" hidden="false" primary="false" targetId="6fe0-3dbe-f7e0-10bb"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Taktikal Brigade" id="fdd5-9868-a9ee-e9f1" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cd1d-e40e-6d67-77e6" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Suspiciously Well Organised" id="3a9f-731a-826b-7629" hidden="false">
                  <description>All friendly STORMBOYZ units gain the BATTLELINE keyword.
-&gt; When a friendly unit is selected to make a Fall Back move (the triggering unit must have BOYZ, KOMMANDOS or STORMBOYZ): the triggering unit is eligible to declare a charge even if it Fell Back this turn.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Take and Hold" id="1f1b-6420-a3bd-797f" hidden="false" primary="false" targetId="1cc1-f11a-4e8f-1bcc"/>
              </categoryLinks>
              <costs>
