        <profile name="More Dakka" id="f273-af3d-7a35-a7cc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Ranged weapons equipped by models in this unit gain [IGNORES COVER].
While the unit is riled up, ranged weapons equipped by models in this unit gain [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile name="Shokk-boosta" id="b9c5-f151-6627-5bd5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Movement phase, in your turn, until the end of the phase:
  -&gt; When the unit is selected to make an Advance move, you may use this ability:
    -&gt; The unit's Advance rolls count as 6.
    -&gt; The unit can move over models as though they were not there.
  -&gt; When the unit ends an Advance move: the unit must take a Hazard test for each model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8f81-4101-0739-9868" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
