        <profile name="Da Grand Warlord's Ladz" id="721b-4ab6-3ab5-eedb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly INFANTRY ORKS unit other than this unit, the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Makari, Hoist Dat Banner" id="5530-cb7c-41e5-2bc7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Movement phase, in your turn, until the start of your next turn:
  -&gt; Select any number of friendly ORKS units (at most the battle round number):
    -&gt; For each selected unit:
      -&gt; That unit is riled up.
      -&gt; Place a Makari token marker.
      -&gt; Remove that Makari token marker from the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prophet of Da Great Waaagh!" id="3489-406f-0e20-139c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While making melee attacks, while a friendly ORKS unit is within 6" of this unit, that unit gets +1 to Hit rolls; that unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Commander" id="d9a8-12c3-b24f-c6f4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is friendly, the unit must be your Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
