      <profiles>
        <profile name="Warboss" id="daa1-04b8-8fd4-3949" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
