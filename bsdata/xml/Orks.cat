        <profile name="Kunnin' Infiltrator" id="3ea2-c8ed-eced-d918" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your opponent's Fight phase, you may use this ability, while the unit is hidden, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="fc80-5c2a-84f0-44a9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="a7a0-bb63-dd90-0377" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deff from the Shadows (First battle round onwards)" id="4ac8-65d5-7c06-ade4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your opponent's Movement phase, while the unit is in Strategic Reserves, the unit can make an Ingress move.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="0e9d-699f-4f03-13eb" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
