      <profiles>
        <profile name="Rokkit Charge" id="ae7d-9f52-48d7-c54f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to fight, you may use this ability, if the unit charged this turn, until the end of the phase:
  -&gt; Improve the Attacks characteristic of melee weapons equipped by models in this unit by 1.
  -&gt; Improve the Strength characteristic of melee weapons equipped by models in this unit by 1.
  -&gt; Melee weapons equipped by models in this unit gain [HAZARDOUS].</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="7dac-3f70-5a63-3340" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
