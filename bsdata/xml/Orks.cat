              </constraints>
              <rules>
                <rule name="Get Stuck In" id="f3ca-3844-4d8a-7096" hidden="false">
                  <description>Melee weapons equipped by all friendly ORKS units gain [SUSTAINED HITS 1].</description>
                </rule>
              </rules>
              <categoryLinks>
