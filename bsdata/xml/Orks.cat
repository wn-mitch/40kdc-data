        <profile name="Deep Strike" id="89b2-8875-ebf6-a7d5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deff From Above" id="918f-2746-2869-f366" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Shooting phase, in your turn, if the unit made an ingress move this turn, while making ranged attacks, the unit gets +1 to Hit rolls with ranged weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Aerial Manoover" id="8643-9f38-9169-72c8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your opponent's Fight phase, you may use this ability, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
