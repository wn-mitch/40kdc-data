        <profile name="Catch Dat Red Bit (Once per battle, per unit)" id="0aa2-05ae-9b99-e098" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model uses Crude Surgery, you may use this ability:
  -&gt; The unit regains up to D3 lost wounds.
  -&gt; Place a Grot Orderly token marker.
  -&gt; Remove that Grot Orderly token marker from the battlefield.</characteristic>
          </characteristics>
        </profile>
