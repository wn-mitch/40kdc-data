      <profiles>
        <profile name="Wazdakka Gutsmek" id="5fad-f8e9-cfeb-e2dd" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">8</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">120mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Full Throttle" id="7784-0d50-40c7-aea9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  Select exactly 1 distinct options (Throttlerokkit Shokka Engine Ability):
    - When the unit is selected to make an Advance or Fall Back move: the unit is eligible to declare a charge even if it Advanced this turn or it Fell Back this turn.
    - During the Command phase, in your turn, while the unit is unengaged, the unit can be placed into Strategic Reserves.
    - When the unit is selected to move, you may use this ability: during the Movement phase, in your turn, while the unit is unengaged, the unit can make a Pulse Jet move.</characteristic>
          </characteristics>
        </profile>
        <profile name="Turbo Engine" id="2fea-69cd-3c8e-9a99" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; When the unit is selected to make an Advance or Fall Back move: the unit is eligible to declare a charge even if it Advanced this turn or it Fell Back this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shokk Attack Engine" id="44dc-652f-a9df-847e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase, during the Command phase, in your turn, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pulse Jet" id="506c-f682-3a76-3d23" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; When the unit is selected to move, you may use this ability: during the Movement phase, in your turn, while the unit is unengaged, the unit can make a Pulse Jet move.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pulse Jet" id="d434-eb0b-dbe5-a7d2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to move, you may use this ability, during the Movement phase, in your turn, while the unit is unengaged, the unit can make a Pulse Jet move.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shokk Attack Engine" id="f2f8-7d26-c133-62ec" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Command phase, in your turn, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Turbo Engine" id="91e0-2292-cf5a-eed4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to make an Advance or Fall Back move, the unit is eligible to declare a charge even if it Advanced this turn or it Fell Back this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="d658-20d3-effd-2730" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="fbf6-a301-750d-e8f0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="ed46-713e-8182-1246" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
      </profiles>
