    <selectionEntry name="Kommandos" id="303-267f-e45c-6aa9" hidden="false" import="true" type="unit">
      <modifiers>
        <modifier field="04b9-950c-700e-0c66" type="set" value="2">
          <conditions>
            <condition childId="d62d-db22-4893-4bc0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="04b9-950c-700e-0c66" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Bomb Squig" id="7497-b5a5-3015-9ae8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal move, you may use this ability, once per battle per unit, during the Movement phase, in your turn:
  -&gt; Select one enemy unit visible to this model if the selected unit is within 12" of the unit:
    -&gt; Roll one D6: on a 3+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Found 'Em!" id="72b4-b2cf-7883-8679" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">You can: During the Movement phase, in your turn, until the end of the turn:
  -&gt; Select one enemy unit within 12" of the unit: add 3 to that unit's detection range characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nowhere to Hide" id="6719-0f6a-606a-636d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target is hidden, the unit gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Taktikal Know-wotz" id="8809-594a-bf81-94bc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When declaring Battle Formations, you may use this ability:
  -&gt; Split the unit into 2 units of 5 and 5 models.
  -&gt; The unit gains the Bomb Squig ability.
  -&gt; The unit gains the Found Em ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infiltrators" id="bc0f-3091-99d6-5c91" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Infiltrators ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="f038-7453-eac7-0816" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
      </profiles>
