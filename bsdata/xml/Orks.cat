            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">80mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Boss of da Hunt" id="a47c-c559-016c-a69f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is within 3" of a friendly BEAST SNAGGA unit (excluding CHARACTER MONSTER units), the unit gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="9795-6448-4922-2d28" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Thundering Stampede (Aura)" id="2c79-8906-dbb1-3168" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly BEAST SNAGGA unit is within 6" of this unit, that unit gets +1 to Charge rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Keep Huntin'! (Once per battle round, per army)" id="3aae-fcf8-8736-ff41" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move, you may use this ability or when the unit ends a move, you may use this ability, during the Movement phase, in your turn, until the start of your next turn:
  -&gt; Select one friendly BEAST SNAGGA unit within 6" of the unit:
    -&gt; That unit is no longer Battle-shocked.
    -&gt; That unit is riled up.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
