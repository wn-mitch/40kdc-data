            </selectionEntry>
            <selectionEntry name="Wreckas" id="f782-e3f1-c132-fe52" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8fb2-eced-9b93-71e9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Wreckin' and Lootin'" id="e509-082c-37c5-1d72" hidden="false">
                  <description>When a friendly unit is selected to shoot (the triggering unit must have BREAKA BOYZ, FLASH GITZ or TANKBUSTAS), during the Shooting phase, in your turn, until the end of the phase, while the triggering unit is within range of an objective marker or while the target is within range of an objective marker, you can re-roll a Hit roll of 1.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="f889-2951-4515-dc15" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Wurrband" id="1b34-af6b-8900-61b5" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e338-4f79-09d7-52ad" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Powers Of Da Waaagh!" id="6da2-1ce1-bc3a-d8e4" hidden="false">
                  <description>Improve the Strength characteristic of weapons with [PSYCHIC] equipped by all friendly ORKS PSYKER models by 1.
Improve the Strength characteristic of weapons with [PSYCHIC] equipped by all friendly ORKS PSYKER models by 1 for every 5 models in or embarked within this model.
All friendly ORKS PSYKER models gain the Roar of Mork ability:
  -&gt; You can:
    -&gt; By paying this cost (spend 1 Psychic Level): during the Movement phase, in your turn, while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; select one enemy unit (excluding MONSTER or VEHICLE units) if the selected unit is within 12" of the unit: that unit must take a Battle-shock test, applying -1 to that test for every 10 models in this unit.
All friendly ORKS PSYKER models gain the Visions of Violence ability:
  -&gt; At the start of the Fight phase, you may use this ability, by paying this cost (spend 1 Psychic Level), until the end of the phase: while the unit is not Battle-shocked, roll D6; then roll one D6: on 1, the unit is Battle-shocked; on 2-6, nothing happens; the unit gains the Fights First ability.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Disruption" id="6131-585d-2587-14e8" hidden="false" primary="false" targetId="ecf8-cf72-7d5b-1b5b"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="1"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
