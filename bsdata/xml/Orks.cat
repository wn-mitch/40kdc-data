        <constraint id="9d24-0582-0fd9-89b8" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="6"/>
      </constraints>
      <profiles>
        <profile name="Ammo Runts (Once per battle, per unit)" id="faea-b8de-6188-5ef3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability, during the Shooting phase, in your turn, while making ranged attacks, until the end of the phase, the unit gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Never Too Busy to Fight" id="52b9-b8dc-59d9-5273" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit is eligible to start an Action even if it is within Engagement Range of enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tide of Muscle" id="f605-04a0-a59d-1824" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Fight phase, if the unit charged this turn, melee weapons equipped by models in this unit gain [LETHAL HITS].</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Waaagh!" id="a921-5833-2b10-b1ac" hidden="false" targetId="6ac2-fce9-ef59-43eb" type="rule"/>
      </infoLinks>
