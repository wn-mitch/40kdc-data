            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">7</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">50mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Intimidating Motivation" id="6aa0-93dc-a886-c27e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move, you may use this ability or when the unit ends a move, you may use this ability, during the Movement phase, in your turn, until the start of your next turn:
  -&gt; Select one friendly ORKS unit if the selected unit is within 6" of the unit:
    -&gt; That unit is no longer Battle-shocked.
    -&gt; That unit is riled up.</characteristic>
          </characteristics>
        </profile>
        <profile name="Krushin' Impetus" id="3a30-6ba3-e7a2-8b44" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Charge move, you may use this ability:
  -&gt; Select one enemy unit if the selected unit is within Engagement Range of the unit: roll one D6 for each friendly model in the unit that is within Engagement Range of the selected unit: for each 3+, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="54db-f50c-62cf-58ad" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
