      <profiles>
        <profile name="Beastboss on Squigosaur" id="cbf0-3aaa-29ba-e7c2" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">10"</characteristic>
