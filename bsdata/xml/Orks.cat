        <profile name="Hardy Bioniks" id="5ee0-e4f9-51a8-5318" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the attack's S is more than the target's T, the attacking unit gets -1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Push Dat Bit Back In" id="8dbb-9353-a69f-7c40" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn:
  -&gt; Select one friendly BEAST SNAGGA unit if the selected unit is within 6" of the unit: that unit regains up to 3 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Runnin' Wiv da Herd" id="8102-1b94-a957-f538" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is attached to a MOUNTED unit:
  -&gt; This model loses the INFANTRY keyword.
  -&gt; This model gains the MOBILE and MOUNTED keywords.
  -&gt; Add 4 to this model's Move characteristic.</characteristic>
          </characteristics>
        </profile>
