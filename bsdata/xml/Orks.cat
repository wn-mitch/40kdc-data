    <selectionEntry name="Nazdreg" id="80c4-14b2-d02d-d289" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="c27d-4415-5bcc-9b2d" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Nazdreg" id="f03b-b876-51a5-7728" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">7</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">8</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Intimidating Motivation" id="46b2-0406-3943-3b38" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move, you may use this ability or when the unit ends a move, you may use this ability, during the Movement phase, in your turn, until the start of your next turn:
  -&gt; Select one friendly ORKS unit if the selected unit is within 6" of the unit:
    -&gt; That unit is no longer Battle-shocked.
    -&gt; That unit is riled up.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nazdreg's Know-wotz" id="0626-61f5-55df-51d7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Deep Strike ability.
Ranged weapons equipped by models in this unit gain [IGNORES COVER].</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Kunnin'" id="0e7e-9ea6-1e3a-4474" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a move, you may use this ability, during the Movement phase, in the opponent's turn, while the triggering unit is within 8" of the unit, while the unit is unengaged:
  Select one of the following:
    - The unit can make a Normal move of up to D6".
    - While the unit is riled up, the unit can make a Normal move of up to 5".</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="08be-49ea-8bbd-0df4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="b309-375d-1ac5-2d80" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
