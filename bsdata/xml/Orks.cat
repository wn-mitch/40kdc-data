            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">4+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">6</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">50mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Intimidating Motivation" id="2d27-347c-6649-3ef9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit starts a move, you may use this ability or when the unit ends a move, you may use this ability, during the Movement phase, in your turn, until the start of your next turn:
  -&gt; Select one friendly ORKS unit if the selected unit is within 6" of the unit:
    -&gt; That unit is no longer Battle-shocked.
    -&gt; That unit is riled up.</characteristic>
          </characteristics>
        </profile>
        <profile name="Might is Right" id="21bb-6fec-9d9a-36be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the unit charged this turn:
  -&gt; Improve the Attacks characteristic of melee weapons equipped by this model by 3.
  -&gt; Improve the Strength characteristic of melee weapons equipped by this model by 2.</characteristic>
          </characteristics>
        </profile>
        <profile name="Boss' Ammo Runt (Once per battle, per unit)" id="c960-b7df-c70e-0c08" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability, during the Shooting phase, in your turn, while making ranged attacks, until the end of the phase, this model gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="e2e6-c6e2-0802-de97" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
