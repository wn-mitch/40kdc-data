    <selectionEntry name="Pulsa Rokkit (Once per battle, per unit)" id="d1a0-2f98-8d77-8da9" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Pulsa Rokkit" id="7245-0424-ce2d-1aac" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability, once per battle per unit, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit with the MONSTER or VEHICLE keyword if the selected unit is within 24" of the unit (your Pulsa Rokkit Target). Each time a friendly unit makes an attack against it:
    -&gt; The unit's weapons gain [LETHAL HITS].
    -&gt; Improve the Armour Penetration characteristic of that attack by 1 if it is made by the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
      </costs>
    </selectionEntry>
