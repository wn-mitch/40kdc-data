          </characteristics>
        </profile>
        <profile name="Agent of Discord (Aura)" id="c653-6d3f-90ac-18a2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When an enemy unit within 12" of this model is targeted with a Stratagem, you may use this ability, once per turn per model, increase the CP cost of that use of the Stratagem by 1CP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Guns Blazing" id="dc4e-32ab-becb-8bb2" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After an enemy unit shoots, once per turn per unit, during the Shooting phase, in the opponent's turn, if the triggering unit has selected a friendly HERETIC ASTARTES unit within 3" of this model as a target of its ranged attacks, until the end of the phase:
  -&gt; If the unit is eligible to shoot, this model is eligible to shoot as if it were your Shooting phase.
  -&gt; If the unit is eligible to shoot, this model must target the triggering unit with ranged attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Operative" id="d080-3caa-f6c8-b288" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units cannot target this model with ranged weapons unless the attacking unit is within 12".</characteristic>
          </characteristics>
        </profile>
      </profiles>
