        <profile name="Enrage Machine Spirits" id="e58d-91fc-0d9f-73ee" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of your Movement phase:
  -&gt; Select one enemy VEHICLE unit if the selected unit is within 12" of this model: that unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="7337-966f-dc4a-1f31" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Mechanisms" id="082f-8d0c-bf5d-27d8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the Command phase, in your turn, until the start of your next Command phase:
  -&gt; Select one friendly HERETIC ASTARTES VEHICLE model if the selected unit is within 3" of this model (each model can be selected for this ability at most once per phase across your army):
    -&gt; That model regains up to D3 lost wounds.
    -&gt; That model gets +1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warpsmith" id="ba31-c8bd-e29a-f770" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly HERETIC ASTARTES VEHICLE unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
