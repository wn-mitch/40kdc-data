        <profile name="Chance for Glory" id="8537-6333-e70d-415c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, you may use this ability, once per battle per unit, until the end of the phase:
  -&gt; Improve the Attacks characteristic of melee weapons equipped by this model by 1.
  -&gt; Improve the Strength characteristic of melee weapons equipped by this model by 1.
  -&gt; Improve the Armour Penetration characteristic of melee weapons equipped by this model by 1.
  -&gt; Improve the Damage characteristic of melee weapons equipped by this model by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="8c47-7f2d-340a-8868" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Chaos" id="a4b5-54ee-9ab6-7b7d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model's unit is targeted with a Stratagem, you may use this ability, once per battle round per army, while the unit has the Lord of Chaos ability, reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP).</characteristic>
          </characteristics>
        </profile>
      </profiles>
