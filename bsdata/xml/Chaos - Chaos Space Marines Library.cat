      <constraints>
        <constraint id="b65a-5fe8-96bd-e3e5" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Attached Unit" id="f787-256c-a8dc-06a6" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">A friendly CHARACTER unit (excluding EPIC HERO units) with the Leader ability that can be attached to friendly LEGIONARIES units can also be attached to the unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stealth" id="bc62-3758-19bc-ce9b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit has the Stealth ability, while making ranged attacks, the unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Visions of Suffering (Psychic)" id="ebf7-5f68-cba1-8cea" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the target unit is below its starting strength:
  -&gt; The unit gets +1 to Hit rolls.
  -&gt; While the unit is below half strength, the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Dark Pacts" id="3f83-bc33-aa4a-3e6e" hidden="false" targetId="ae8f-a598-b4d3-c749" type="rule"/>
      </infoLinks>
      <categoryLinks>
