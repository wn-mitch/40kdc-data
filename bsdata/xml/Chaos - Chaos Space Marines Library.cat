    <selectionEntry name="Masters of the Maelstrom" id="a998-9dce-fbab-8d32" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="83ca-0673-d4eb-74b7" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Choice Samples" id="4481-266d-5339-3685" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the unit is below its starting strength, return 1 destroyed model to the unit, each with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fleet Command" id="abdd-c3fe-ba0b-d0ca" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After deployment, you may use this ability, while the unit is on the battlefield or while the Transport this unit is embarked within is on the battlefield:
  -&gt; Select up to 3 friendly HERETIC ASTARTES units:
    -&gt; For each selected unit:
      Select one of the following:
        - That unit can be set up on the battlefield.
        - That unit can be placed into Strategic Reserves, ignoring any limits on units in Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Plunder" id="f49a-7668-c720-aa12" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal move, you may use this ability, once per battle per unit:
  -&gt; Select one enemy unit visible to this model if the selected unit is within 12" of the unit:
    -&gt; Roll one D6: on a 2+, that unit suffers D3+1 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support" id="d960-7e17-e1f6-4bd5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
