                <cost name="Detachment Points" typeId="82ae-1066-5107-6ae0" value="2"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Cult of the Arkifane" id="5f38-038e-a1e9-a457" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9209-50b6-8f24-cead" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
              </constraints>
              <rules>
                <rule name="Soul Forge Boons" id="8acd-0ce8-dab2-8c88" hidden="false">
                  <description>All friendly HERETIC ASTARTES VEHICLE units gain the DAEMON keyword.
All friendly HERETIC ASTARTES VEHICLE, LORD DISCORDANT or VASHTORR THE ARKIFANE units gain the SOUL FORGE keyword.
All friendly SOUL FORGE units have a 5+ invulnerable save.
Applies to: units with HERETIC ASTARTES.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink name="Priority Assets" id="cbce-0795-cade-dc73" hidden="false" primary="false" targetId="0936-9767-1cc7-52ae"/>
              </categoryLinks>
              <costs>
