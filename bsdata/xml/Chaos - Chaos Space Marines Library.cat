        <profile name="Warp Strike" id="5d3c-b64b-6546-f2d5" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of the Fight phase, you may use this ability, if the unit has destroyed 1+ enemy units this phase, while the unit is unengaged, the unit can be placed into Strategic Reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="504d-310b-9a8b-4c58" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
