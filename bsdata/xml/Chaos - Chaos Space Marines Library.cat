            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After this model resolves its attacks or after this model resolves its attacks in a fight:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit made with a [PSYCHIC] weapon during its just-finished shooting sequence:
    -&gt; That unit must take a Leadership test.
    -&gt; If the triggering leadership roll was a failure, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="5f67-f3b0-9c87-2dfd" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prescience (Psychic)" id="2870-f26d-fee6-4f45" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, the attacking unit gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
