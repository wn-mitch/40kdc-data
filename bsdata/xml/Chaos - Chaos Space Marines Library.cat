      <profiles>
        <profile name="Defiler" id="09c7-3ecd-40b4-8c32" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">11</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">18</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">5</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">5+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">160mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonforge" id="ed66-5901-acb5-82aa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time the unit makes a Dark Pact, until the end of the phase, you can re-roll a Wound roll of 1 for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="8e36-2e65-a69d-e5de" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scuttling Walker" id="5c4a-faf6-825d-6792" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends a Normal, Advance or Fall Back move:
  -&gt; The unit can move over non-Titanic models as though they were not there.
  -&gt; The unit can move over terrain features as though they were not there.
  -&gt; The triggering unit is eligible to move even if it is within Engagement Range of enemy units.
  -&gt; The triggering unit cannot end a move within Engagement Range of any enemy unit, during its Normal, Advance and Fall Back moves.
  -&gt; The unit automatically passes Desperate Escape tests.</characteristic>
          </characteristics>
        </profile>
        <profile name="Damaged" id="06e8-9ac1-c14c-9fd1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Dark Pacts" id="0ec5-7799-d90b-b1e1" hidden="false" targetId="ae8f-a598-b4d3-c749" type="rule"/>
