        <profile name="Lord Discordant on Helstalker" id="0476-6eb1-84b0-63d4" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">14"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">9</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">4</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">92x120mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Corrupt Machine Spirits" id="78df-27d6-067e-4d8e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Shooting phase:
  -&gt; Select one enemy VEHICLE unit within 12" of this model visible to this model:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-3: That unit suffers D3 mortal wounds.
      - On 4-5: That unit suffers 3 mortal wounds.
      - On 6: That unit suffers D3+3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spirit Thief" id="a49c-7b54-7e7c-f912" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of your Shooting phase:
  -&gt; Select one enemy VEHICLE unit visible to this model (your Spirit Thief Target). Until the end of the phase, each time a friendly unit makes an attack against it, you can re-roll a Wound roll of 1 for attacks made by all friendly HERETIC ASTARTES models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
