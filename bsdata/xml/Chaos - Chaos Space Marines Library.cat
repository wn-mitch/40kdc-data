        <profile name="Architect of Ruin" id="9619-d1a3-3461-0760" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">-&gt; At the start of the battle round, if during the first battle round:
  -&gt; Select one enemy unit, binding it as hated foe selection (your Hated Foe target). When your Hated Foe target is destroyed, you may select one enemy unit, binding it as hated foe selection to replace it. Only one such designation can be active for this bearer unit. For the rest of the battle, each time this model makes an attack against it, while the unit is tagged hated foe, you can re-roll the Wound roll for attacks made by this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="0bfe-3199-f411-de0d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Headlong Destruction" id="5139-ac47-68f7-2380" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If the target is the closest eligible target, improve the unit's Armour Penetration characteristic by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="416d-0a80-d474-dd6d" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
