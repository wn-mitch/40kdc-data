      <profiles>
        <profile name="Dark Zealotry" id="0027-ae4e-d0a7-3ed1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit, if the unit contains 1+ DARK APOSTLE models, while making melee attacks, the unit gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Demagogue" id="afd2-c3f8-ae0a-51e1" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of each phase, you may use this ability, once per battle per unit:
  -&gt; Select one friendly HERETIC ASTARTES unit if the selected unit is Battle-shocked and the selected unit is within 12" of this model: that unit is no longer Battle-shocked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="b9af-26da-2993-c593" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Malign Sacrifice" id="3110-dd22-9d3e-2dfa" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, you may use this ability, if the unit contains 1+ DARK DISCIPLE models:
  -&gt; Select one enemy unit if the selected unit is within Engagement Range of the unit:
    -&gt; Roll one D6:
      - On 1: Nothing happens.
      - On 2-5: That unit suffers 1 mortal wound.
      - On 6: That unit suffers D3 mortal wounds.
    -&gt; Destroy 1 of the DARK DISCIPLE models in the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Dark Pacts" id="efb2-fa39-b604-a9ef" hidden="false" targetId="ae8f-a598-b4d3-c749" type="rule"/>
