                <conditionGroup type="and">
                  <conditions>
                    <condition childId="9bbd-a535-a4ef-9680" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                    <condition childId="2a1d-2757-347c-58f2" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
