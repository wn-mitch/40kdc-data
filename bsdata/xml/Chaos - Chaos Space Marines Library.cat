        <profile name="Daemonkin (Psychic)" id="cbdc-6d3d-7b7b-6853" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is leading a unit:
  -&gt; The unit gets +1 to Advance rolls.
  -&gt; The unit gets +1 to Charge rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="a517-d1e6-c2a8-1a73" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacrificial Dagger" id="a01d-d00e-5626-b1d9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit is selected to shoot, you may use this ability or when the unit is selected to fight, you may use this ability, once per phase per unit, until the end of the phase:
  -&gt; The unit suffers 1 mortal wound.
  -&gt; While making psychic attacks, this model gets +1 to Hit rolls.
  -&gt; This model gets +1 to Wound rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
