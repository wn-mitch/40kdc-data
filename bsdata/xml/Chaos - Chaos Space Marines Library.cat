      <constraints>
        <constraint id="f09f-7a50-d374-5302" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Fearsome (Aura)" id="d695-cd71-151d-3e77" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit takes a Battle-shock test or when the unit takes a Leadership test, while an enemy unit is within 6" of this unit, that unit gets -1 to Battle-shock rolls; that unit gets -1 to Leadership rolls.</characteristic>
          </characteristics>
        </profile>
        <profile name="Terrifying Assault" id="9496-2f9a-fdf2-7ef9" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the Fight phase, once per phase per army:
  For each enemy unit: While the unit is within Engagement Range of a friendly unit with the Terrifying Assault ability, the unit must take a Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="f81b-6e7c-7370-6776" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
