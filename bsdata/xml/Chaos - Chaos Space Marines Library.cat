        <profile name="Hamadrya's Knowledge (Psychic)" id="9f79-5db5-6381-1fc7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time an enemy unit ends a Normal, Advance or Fall Back move, once per battle round per unit, while the triggering unit is within 8" of the unit, while the unit is unengaged, the unit can make a Normal move of up to D3+3".</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" id="a1ea-3e2e-4a00-157f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit gains the Leader ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Badab (Aura)" id="fed9-acf6-e43d-4248" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly HERETIC ASTARTES INFANTRY unit (excluding DAMNED units) that is not Battle-shocked is within 6" of this model, add 1 to that unit's Objective Control characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deep Strike" id="c8b1-ab5b-3786-f61b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feel No Pain" id="4b88-5a8b-c34e-7200" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
          </characteristics>
        </profile>
