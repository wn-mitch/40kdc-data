      <profiles>
        <profile name="Heretic Astartes Daemon Prince" id="02ef-688c-63d7-b88e" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">8"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">10</characteristic>
            <characteristic name="Sv" typeId="450-a17e-9d5e-29da">2+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">6+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">3</characteristic>
            <characteristic name="InSv" typeId="55a7-5b54-c60d-11dc">4+</characteristic>
            <characteristic name="Base" typeId="nr-base-size">60mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Ascended Daemon" id="c8b2-7bfa-3d5a-83cc" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is selected to shoot, you may use this ability or when this model is selected to fight, you may use this ability, until the end of the phase:
  -&gt; You can re-roll one Hit roll.
  -&gt; You can re-roll one Wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic Allegiance" id="3d5a-f0fb-eb51-aed8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Add 3 to the unit's Attacks characteristic.
Add 2 to the unit's Strength characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dark Blessing (Aura)" id="2280-037f-1804-b259" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When damage is allocated, while a friendly HERETIC ASTARTES INFANTRY unit is within 6" of this model, that unit has the Benefit of Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Demise" id="aad1-c652-121d-1da8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this model is destroyed, after the units embarked within it have made their emergency disembark moves:
  -&gt; Roll one D6: on a 6+, for each unit: while the unit is within 6" of this model, the unit suffers a number of mortal wounds equal to its rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Chaos" id="022c-16dd-26c5-0ae7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3" of a friendly HERETIC ASTARTES INFANTRY unit, this model gains the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
