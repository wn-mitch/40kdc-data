  <forces>
    <force id="force0" name="Tau Empire" catalogueName="Tau Empire">
      <selections>
        <selection id="unit0" name="Darkstrider" type="unit" number="1">
          <profiles>
            <profile name="Darkstrider" typeName="Unit">
              <characteristics>
                <characteristic name="M">7"</characteristic>
                <characteristic name="T">3</characteristic>
                <characteristic name="SV">4+</characteristic>
                <characteristic name="W">3</characteristic>
                <characteristic name="LD">7+</characteristic>
                <characteristic name="OC">1</characteristic>
              </characteristics>
            </profile>
            <profile name="Jammer Array" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Enemy units cannot be set up on the battlefield from Strategic Reserves within 12" of this model.</characteristic>
              </characteristics>
            </profile>
            <profile name="Leader" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">This unit gains the Leader ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Structural Analyser" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">While this model is leading a unit, while making ranged attacks, add 1 to this unit's Wound rolls.</characteristic>
              </characteristics>
            </profile>
            <profile name="Infiltrators" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">This unit gains the Infiltrators ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Scouts" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">This unit gains the Scouts X" ability, X being its rating.</characteristic>
              </characteristics>
            </profile>
            <profile name="For the Greater Good" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of your Shooting phase, you can use this ability, if your Army Faction is TAU EMPIRE:
  - Select one or more friendly units with the For the Greater Good ability. Those units are an Observer.
  - Until the end of the phase, during your Shooting phase, for each friendly unit that is Observers: select one enemy unit that is not Spotted and visible to this unit; unless this unit has been selected to shoot this phase, if this unit is eligible to shoot (excluding Fortification units), while this unit is not Battle-shocked, that unit is Spotted by that unit until the end of the phase; if the attacking unit is Guided, while the target is Spotted, improve friendly models' Ballistic Skill characteristic by 1; if the attacking unit is Guided, while the target is Spotted and the target is Spotted by a friendly MARKERLIGHT unit that is an Observer, friendly models' weapons gain [IGNORES COVER].</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: T’au Empire"/>
            <category name="Infantry"/>
            <category name="Character"/>
            <category name="Epic Hero"/>
            <category name="Markerlight"/>
            <category name="Darkstrider"/>
          </categories>
