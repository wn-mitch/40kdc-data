            </profile>
            <profile name="Assault Ramp" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When the unit ends a Normal move, during the Movement phase, in your turn, friendly units embarked within the unit can disembark using the Assault Disembarkation rules.</characteristic>
              </characteristics>
            </profile>
            <profile name="Deadly Demise" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Before this model is removed from play:
  -&gt; Roll one D6: on a 6+, enemy units within 6" suffer a number of mortal wounds equal to its rating.</characteristic>
              </characteristics>
            </profile>
            <profile name="Damaged" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">While the model has X or fewer wounds remaining, X being its rating, this model gets -1 to Hit rolls.</characteristic>
              </characteristics>
            </profile>
            <profile name="Power Of The Machine Spirit" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">After an enemy unit shoots, until the end of the phase, the unit is eligible to shoot as if it were your Shooting phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
