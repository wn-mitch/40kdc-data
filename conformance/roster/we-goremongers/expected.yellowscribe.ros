<?xml version="1.0" encoding="utf-8"?>
<roster id="roster0" name="Blood for the Blood God" gameSystemId="sys-352e-adc2-7639-d6a9" gameSystemName="Warhammer 40,000">
  <forces>
    <force id="force0" name="World Eaters" catalogueName="World Eaters">
      <selections>
        <selection id="unit0" name="Goremongers" type="unit" number="1">
          <profiles>
            <profile name="Goremongers" typeName="Unit">
              <characteristics>
                <characteristic name="M">9"</characteristic>
                <characteristic name="T">4</characteristic>
                <characteristic name="SV">6+</characteristic>
                <characteristic name="W">1</characteristic>
                <characteristic name="LD">7+</characteristic>
                <characteristic name="OC">1</characteristic>
              </characteristics>
            </profile>
            <profile name="Infiltrators" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Infiltrators ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Loping Speed" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Each time an enemy unit ends a move, during the Movement phase, in the opponent's turn, while the triggering unit is within 8" of the unit, while the unit is unengaged, the unit can make a Normal move of up to D6".</characteristic>
              </characteristics>
            </profile>
            <profile name="Blessings of Khorne" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of the battle round, you may use this ability, once per battle round per army, if your Army Faction is WORLD EATERS, until the end of the battle round:
  -&gt; Roll 8D6; allocate dice to activate up to 2 of the following:
    - Unbridled Bloodlust (requires pair of 1+): the unit gets +1 to Charge rolls.
    - Rage-Fuelled Invigoration (requires pair of 2+): add 3" to the unit's Pile-in and Consolidation moves.
    - Total Carnage (requires pair of 3+): when a model in the unit is destroyed: each time a model in this unit is destroyed, unless that unit has fought this phase, roll one D6. On a 4+, leave that model on the battlefield; after the attacking unit has finished making its attacks, it can fight. Remove it after it has fought.
    - Martial Excellence (requires pair of 4+ or triple of 1+): melee weapons equipped by models in this unit gain [SUSTAINED HITS 1].
    - Warp Blades (requires pair of 5+ or triple of 2+): melee weapons equipped by models in this unit gain [LETHAL HITS].
    - Decapitating Strikes (requires pair of 6+ or triple of 3+): while making melee attacks against INFANTRY targets, the unit's weapons gain [DEVASTATING WOUNDS].</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: World Eaters"/>
            <category name="Infantry"/>
            <category name="Grenades"/>
            <category name="Chaos"/>
            <category name="Khorne"/>
            <category name="Goremongers"/>
          </categories>
