            <profile name="Black Rage" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">You can re-roll Hit rolls of 1 with melee weapons.
While this unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while this unit is not within 12" of a friendly CHAPLAIN unit, this unit cannot Fall Back.
While this unit is not within 6" of a friendly BLOOD ANGELS CHARACTER unit or while this unit is not within 12" of a friendly CHAPLAIN unit, set this unit's Objective Control characteristic to 0.</characteristic>
              </characteristics>
            </profile>
