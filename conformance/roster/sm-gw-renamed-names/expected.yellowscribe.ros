            <profile name="Codex Adept" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains Assault Doctrine (Combat Doctrines).
The unit gains Devastator Doctrine (Combat Doctrines).
The unit gains Tactical Doctrine (Combat Doctrines).</characteristic>
              </characteristics>
            </profile>
            <profile name="Deep Strike" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
              </characteristics>
            </profile>
            <profile name="Leader" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Leader ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Master Tactician" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">You can: During the Movement phase, in your turn, until the start of your next Command phase:
  -&gt; Select one friendly ADEPTUS ASTARTES unit within 9" of this model visible to this model: select one option of Combat Doctrines for that unit, in place of any already active.</characteristic>
              </characteristics>
            </profile>
            <profile name="Thunderhawk Insertion" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When declaring Battle Formations, you may use this ability:
  -&gt; Select one friendly unit with the GRAVIS, PHOBOS or TACTICUS keyword: that unit gains the Deep Strike ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
