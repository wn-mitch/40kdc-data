  <forces>
    <force id="force0" name="Adeptus Custodes" catalogueName="Adeptus Custodes">
      <selections>
        <selection id="unit0" name="Trajann Valoris" type="unit" number="1">
          <profiles>
            <profile name="Trajann Valoris" typeName="Unit">
              <characteristics>
                <characteristic name="M">6"</characteristic>
                <characteristic name="T">6</characteristic>
                <characteristic name="SV">2+</characteristic>
                <characteristic name="W">7</characteristic>
                <characteristic name="LD">5+</characteristic>
                <characteristic name="OC">2</characteristic>
              </characteristics>
            </profile>
            <profile name="Invulnerable Save" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">4+ invulnerable save</characteristic>
              </characteristics>
            </profile>
            <profile name="Captain-General" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">While a friendly ADEPTUS CUSTODES unit (excluding MONSTER or VEHICLE units) is within 6" of this model, you can re-roll a Hit roll of 1 for attacks made by that unit; you can re-roll a Wound roll of 1 for attacks made by that unit.</characteristic>
              </characteristics>
            </profile>
            <profile name="Leader" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Leader ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Moment Shackle" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of each phase, you may use this ability, once per battle per army, until the end of the phase:
  Select exactly 1 distinct options (One of the Following):
    - Improve the Attacks characteristic of melee Watcher’s Axe weapons equipped by this model by 3.
    - This model has a 3+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
            <profile name="Supreme Commander" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">While this model is friendly, the unit must be your Warlord.</characteristic>
              </characteristics>
            </profile>
            <profile name="Deep Strike" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When the unit ends an ingress move, while the unit has the Deep Strike ability, the triggering unit can be set up on the battlefield more than 8" away from all enemy models.</characteristic>
              </characteristics>
            </profile>
            <profile name="Feel No Pain" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit has the Feel No Pain X+ ability, X being its rating.</characteristic>
              </characteristics>
            </profile>
            <profile name="Aegis of the Emperor" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">All friendly ADEPTUS CUSTODES units with the Aegis of the Emperor ability have the Feel No Pain 5+ ability against mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Aquila Commander" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of the battle round, while this model has the Aquila Commander ability, while this model is the Warlord, you gain 1CP.</characteristic>
              </characteristics>
            </profile>
            <profile name="Martial Ka’tah" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">-&gt; At the start of your Command phase: all friendly ADEPTUS CUSTODES units with the Martial Katah ability are readied.
-&gt; You can: while the unit is readied, select one: Conversai (until the end of the turn: the unit is no longer readied; during the Command phase, in your turn, the unit is eligible to start an Action even if it is within Engagement Range of enemy units or it is Battle-shocked; the unit is eligible to shoot even if it is performing an Action) / Calistus (when the unit is selected to move, until the end of the phase: the unit is no longer readied; during the Movement phase, in your turn, the unit can move over models as though they were not there, during its Normal, Advance and Fall Back moves) / Salvus (when the unit is selected to shoot, until the end of the phase: the unit is no longer readied; during the Shooting phase, in your turn, the unit ignores any modifiers to its Ballistic Skill characteristics; the unit ignores any modifiers to its Hit and Wound rolls) / Dacatarai (at the start of the Fight phase, until the end of the phase: the unit is no longer readied; while making melee attacks, while the target is an enemy unit (excluding MONSTER or VEHICLE units), you can re-roll a Hit roll of 1 with melee weapons) / Kaptaris (at the start of the Fight phase, until the end of the phase: the unit is no longer readied; against melee attacks, the attacking unit gets -1 to Hit rolls) / Rendax (when the unit is selected to fight, until the end of the phase: the unit is no longer readied; during the Fight phase, against MONSTER or VEHICLE targets, melee weapons equipped by models in this unit gain [LETHAL HITS]).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: Adeptus Custodes"/>
            <category name="Infantry"/>
            <category name="Character"/>
            <category name="Epic Hero"/>
            <category name="Imperium"/>
            <category name="Trajann Valoris"/>
