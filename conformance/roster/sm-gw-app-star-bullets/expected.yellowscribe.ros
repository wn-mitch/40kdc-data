            </profile>
            <profile name="Bolter Discipline" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">During the Shooting phase, in your turn, while the unit is within range of an objective marker or while the target is within range of an objective marker, the unit gets +1 to Hit rolls with ranged weapons.</characteristic>
              </characteristics>
            </profile>
            <profile name="Tactical Mainstay" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit is eligible to start an Action even if it is within Engagement Range of enemy units or it is Battle-shocked.
-&gt; Each time the unit uses action: the unit is eligible to shoot even if it is performing an Action.</characteristic>
              </characteristics>
            </profile>
          </profiles>
