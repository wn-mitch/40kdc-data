                <characteristic name="Description">The unit gains the Leader ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Malign Wardings (Psychic)" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">While this model is leading a unit, the unit has the Feel No Pain 4+ ability against Psychic Attacks.</characteristic>
              </characteristics>
            </profile>
            <profile name="Psychic Barrier (Psychic)" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of your opponent's Shooting phase, you may use this ability, until the end of the phase:
  -&gt; Roll one D6:
    - On 1: The unit suffers D3 mortal wounds.
    - On 2-6: The unit has a 4+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
          </profiles>
