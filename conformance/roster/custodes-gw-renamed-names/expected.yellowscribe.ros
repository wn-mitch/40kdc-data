  <forces>
    <force id="force0" name="Adeptus Custodes" catalogueName="Adeptus Custodes">
      <selections>
        <selection id="unit0" name="Witchseekers" type="unit" number="1">
          <profiles>
            <profile name="Witchseeker" typeName="Unit">
              <characteristics>
                <characteristic name="M">6"</characteristic>
                <characteristic name="T">3</characteristic>
                <characteristic name="SV">3+</characteristic>
                <characteristic name="W">1</characteristic>
                <characteristic name="LD">6+</characteristic>
                <characteristic name="OC">1</characteristic>
              </characteristics>
            </profile>
            <profile name="Sanctified Flames" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">After the unit resolves its attacks, you may use this ability, during the Shooting phase, in your turn, until the end of the phase:
  -&gt; Select one enemy unit that was hit by an attack made by the triggering unit during its just-finished shooting sequence:
    -&gt; If the selected unit has "PSYKER", that unit must take a Battle-shock test, applying -1 to that test.
    -&gt; Unless the selected unit has "PSYKER", that unit must take a Battle-shock test.</characteristic>
              </characteristics>
            </profile>
            <profile name="Scouts" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Scouts X" ability, X being its rating.</characteristic>
              </characteristics>
            </profile>
            <profile name="Daughters of the Abyss" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">All friendly ANATHEMA PSYKANA units have the Feel No Pain 3+ ability against Psychic Attacks.
All friendly ANATHEMA PSYKANA units gain the Psychic Null ability:
  -&gt; While a friendly ADEPTUS CUSTODES unit is within 6" of this unit, that unit has the Feel No Pain 5+ ability against Psychic Attacks.
Your army can include ANATHEMA PSYKANA units.
You cannot select Anathema Psykana as your Army Faction.
All friendly ANATHEMA PSYKANA units cannot be your Warlord.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: Anathema Psykana"/>
            <category name="Infantry"/>
            <category name="Imperium"/>
            <category name="Witchseeker Squad"/>
            <category name="Anathema Psykana"/>
          </categories>
