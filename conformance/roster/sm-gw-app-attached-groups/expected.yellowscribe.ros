      <selections>
        <selection id="unit0" name="Captain" type="unit" number="1">
          <profiles>
            <profile name="Captain" typeName="Unit">
              <characteristics>
                <characteristic name="M">6"</characteristic>
                <characteristic name="T">5</characteristic>
                <characteristic name="SV">3+</characteristic>
                <characteristic name="W">5</characteristic>
                <characteristic name="LD">6+</characteristic>
                <characteristic name="OC">1</characteristic>
              </characteristics>
            </profile>
            <profile name="Invulnerable Save" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">4+ invulnerable save</characteristic>
              </characteristics>
            </profile>
            <profile name="Leader" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Leader ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Finest Hour" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When the unit is selected to fight, you may use this ability, during the Fight phase, until the end of the phase:
  -&gt; Improve the Attacks characteristic of melee weapons equipped by this model by 3.
  -&gt; Melee weapons equipped by this model gain [DEVASTATING WOUNDS].</characteristic>
              </characteristics>
            </profile>
            <profile name="Relic Shield" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Add 1 to this model's Wounds characteristic.</characteristic>
              </characteristics>
            </profile>
            <profile name="Strategic Acumen" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">You can: During the Command phase, in your turn, until the start of your next Command phase, select one option of Combat Doctrines for the unit, in place of any already active.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: Adeptus Astartes"/>
            <category name="Infantry"/>
            <category name="Character"/>
            <category name="Explosives"/>
            <category name="Imperium"/>
            <category name="Tacticus"/>
            <category name="Captain"/>
          </categories>
          <selections>
