            <profile name="Divine Guidance (Once per turn per unit)" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When a friendly unit is selected to shoot or fight (the triggering unit must have SANCTUARY GUARDIANS), you may use this ability, you can re-roll the Hit roll for attacks made by the triggering unit.</characteristic>
              </characteristics>
            </profile>
            <profile name="Null Rod" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit has the Feel No Pain 4+ ability against Psychic Attacks and mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Acts of Faith" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Nothing happens.</characteristic>
              </characteristics>
            </profile>
