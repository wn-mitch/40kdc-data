{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/defs/common.schema.json",
  "title": "40kdc Common Definitions",
  "$defs": {
    "entity-id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2,
      "maxLength": 128,
      "description": "Kebab-case identifier"
    },
    "edition": {
      "type": "string",
      "pattern": "^\\d{1,2}(th)?$",
      "description": "Game edition, e.g. '10th' or '11'"
    },
    "dataslate-version": {
      "type": "string",
      "pattern": "^(\\d{4}-q[1-4]|[a-z0-9][a-z0-9-]*[a-z0-9])$",
      "description": "Dataslate version: a quarterly tag (e.g. '2025-q3') or a named kebab-case slug for non-quarterly slates (e.g. 'pre-launch-provisional')"
    },
    "keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "keyword-list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyword"
      },
      "uniqueItems": true
    },
    "stat-value": {
      "description": "A stat that can be a fixed number or a dice expression",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d*[Dd]\\d+(\\+\\d+)?$"
        }
      ]
    },
    "contributor-ref": {
      "type": "string",
      "description": "GitHub handle or '40kdc-community'"
    },
    "external-reference": {
      "type": "object",
      "description": "A stable identifier assigned to the same entity by an external data source.",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Open source namespace, such as 'mfm', 'bsdata', or 'game-datacards'."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifier exactly as assigned by the external source."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "additionalProperties": false
    },
    "external-reference-list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external-reference"
      },
      "uniqueItems": true,
      "description": "Known external source identities. More than one id per namespace and cross-entity fan-out are valid."
    },
    "phase": {
      "type": "string",
      "enum": [
        "command",
        "movement",
        "shooting",
        "charge",
        "fight"
      ],
      "description": "The five official game phases. Unchanged between 10th and 11th edition — 11e reorders Pile In timing within the Fight phase but adds no top-level phase."
    },
    "phase-list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "source-type": {
      "type": "string",
      "enum": [
        "ability",
        "stratagem",
        "enhancement",
        "detachment-rule",
        "faction-rule"
      ],
      "description": "Type of game element that is the source of an enrichment entry"
    },
    "player-turn": {
      "type": "string",
      "enum": [
        "your-turn",
        "opponent-turn",
        "either"
      ],
      "description": "Which player's turn this applies during"
    },
    "game-event": {
      "type": "string",
      "description": "The event families a trigger fires on and a `happened` condition looks back at. Each family takes typed parameters in the trigger's `filter` (which move, which roll, which Stratagem) and names who acted (`subject`) and what it was aimed at (`object`), so an event name never packs a subject or object.",
      "enum": [
        "battle-started",
        "battle-formations-declared",
        "deployment-ended",
        "round-started",
        "round-ended",
        "turn-started",
        "turn-ended",
        "phase-started",
        "phase-ended",
        "step-started",
        "selected",
        "targets-selected",
        "move-ended",
        "set-up",
        "disembarked",
        "before-roll",
        "after-roll",
        "damage-allocated",
        "attacks-resolved",
        "destroyed",
        "model-destroyed",
        "used",
        "state-changed",
        "designation-changed",
        "designation-resolved",
        "marker-removed",
        "objective-gained",
        "resource-gained",
        "resource-spent"
      ]
    },
    "battle-size": {
      "type": "string",
      "enum": [
        "incursion",
        "strike-force"
      ],
      "description": "11e battle size, which sets the army's points limit and detachment-point budget: 'incursion' = 1000 pts / 2 detachment points; 'strike-force' = 2000 pts / 3 detachment points."
    },
    "force-disposition-id": {
      "type": "string",
      "enum": [
        "take-and-hold",
        "disruption",
        "purge-the-foe",
        "priority-assets",
        "reconnaissance"
      ],
      "description": "One of the five confirmed 11e launch Force Dispositions. Shared by force-disposition entities and the mission-matchup matrix."
    },
    "game-mode-id": {
      "type": "string",
      "enum": [
        "matched-play",
        "combat-patrol",
        "boarding-actions",
        "crusade"
      ],
      "description": "The game mode an army-construction entity is legal or authored for, parallel to the game_version edition axis. 'matched-play' is the competitive default: when an entity omits `game_modes`, treat it as matched-play only. 'combat-patrol', 'boarding-actions', and 'crusade' are non-competitive modes; of these only combat-patrol currently has an ingest source and coverage measurement (the others are schema-homed for hand-authoring)."
    },
    "game-modes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/game-mode-id"
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Game modes this entity is legal or authored for. Absent implies ['matched-play'] (the competitive default), so existing matched-play entities need not carry the field."
    },
    "vec2": {
      "type": "object",
      "description": "A 2D point in board inches. Origin at a board corner; JSON uses y-down (downstream renderers may flip to y-up).",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "footprint": {
      "description": "A terrain piece's 2D footprint in local inches (y-down): an axis-aligned rectangle with its min corner at the local origin, a right triangle with the right angle at the local origin and legs along +x/+y, or an explicit polygon (>= 3 points). The placement resolver re-centers the footprint on its polygon area centroid, so the local-origin convention does not affect where the piece lands — only its shape matters.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "rectangle"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "right-triangle"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/vec2"
              },
              "minItems": 3
            }
          },
          "required": [
            "type",
            "points"
          ],
          "additionalProperties": false
        }
      ]
    },
    "wall": {
      "type": "object",
      "description": "A wall polyline: an open path of 2+ vertices with optional thickness, in the same local frame as the footprint.",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "minItems": 2
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Wall thickness in inches. Omit for thin walls."
        }
      },
      "required": [
        "points"
      ],
      "additionalProperties": false
    },
    "terrain-area-keyword": {
      "type": "string",
      "enum": [
        "obscuring",
        "hidden",
        "plunging-fire"
      ],
      "description": "An 11e terrain-area keyword. Confirmed launch set; extend as further keywords publish on dataslate."
    },
    "base-size": {
      "type": "object",
      "description": "A model's base. 'round' carries 'diameter'; 'oval' carries 'width'+'length'. 'flying-base' (with 'size': small/large), 'hull', and 'unique' are categories the GW base-size guide gives without standard millimetre dimensions; entries carrying such a category, or any millimetre value not taken from an authoritative source, set 'draft': true to mark them for later hand-authoring.",
      "properties": {
        "shape": {
          "enum": [
            "round",
            "oval",
            "flying-base",
            "hull",
            "unique"
          ]
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size": {
          "enum": [
            "small",
            "large"
          ],
          "description": "Flying-base size class, when 'shape' is 'flying-base'."
        },
        "draft": {
          "type": "boolean",
          "default": false,
          "description": "True when the entry is provisional/guessed (e.g. a category without authoritative dimensions) and should be revisited."
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "enum": [
        "friendly",
        "enemy",
        "any"
      ],
      "description": "Which player a unit, objective or resource belongs to."
    },
    "unit-state": {
      "type": "string",
      "enum": [
        "engaged",
        "battle-shocked",
        "embarked",
        "in-strategic-reserves",
        "on-battlefield",
        "hidden",
        "fights-first",
        "benefit-of-cover"
      ],
      "description": "Core-rules states a unit is in. Each state's opposite is the state under `not` (unengaged is not engaged)."
    },
    "unit-filter": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Any unit (or model, with level: model) matching every listed property. Reads as 'a unit that…'.",
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "all_of": {
          "$ref": "#/$defs/keyword-list"
        },
        "any_of": {
          "$ref": "#/$defs/keyword-list"
        },
        "none_of": {
          "$ref": "#/$defs/keyword-list"
        },
        "designated": {
          "$ref": "#/$defs/designation-id",
          "description": "The unit carries this designation (a tag an effect applied)."
        },
        "state": {
          "$ref": "#/$defs/unit-state"
        },
        "level": {
          "enum": [
            "unit",
            "model"
          ],
          "description": "model: the filter matches individual models. Default unit."
        },
        "visible": {
          "const": true,
          "description": "Only units visible to the subject of the enclosing predicate."
        },
        "within": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "range"
          ],
          "properties": {
            "range": {
              "$ref": "#/$defs/range-ref"
            },
            "of": {
              "$ref": "#/$defs/unit-ref"
            },
            "wholly": {
              "const": true
            }
          },
          "description": "Only units within (wholly within, if set) this range of `of` (default the unit with the ability): aura recipients."
        },
        "excluding": {
          "$ref": "#/$defs/unit-ref",
          "description": "Not this unit (\"another friendly unit\")."
        },
        "designated_by": {
          "$ref": "#/$defs/unit-ref",
          "description": "The designation was applied by this unit (their Spotted unit). Requires `designated`."
        },
        "not_designated": {
          "$ref": "#/$defs/designation-id",
          "description": "The unit does not carry this designation."
        },
        "embarked_in": {
          "$ref": "#/$defs/unit-ref",
          "description": "Units embarked within this Transport."
        },
        "member_of": {
          "$ref": "#/$defs/unit-ref",
          "description": "Models (level: model) or units that are part of this unit, attached units included."
        },
        "engaged_with": {
          "$ref": "#/$defs/unit-filter",
          "description": "Units within Engagement Range of at least one unit matching this filter."
        },
        "not_engaged_with": {
          "$ref": "#/$defs/unit-filter",
          "description": "Units within Engagement Range of no unit matching this filter."
        },
        "has_ability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity-id"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Units with every listed ability."
        },
        "lacks_ability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity-id"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Units with none of the listed abilities."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "designated_by"
            ]
          },
          "then": {
            "required": [
              "designated"
            ]
          }
        }
      ]
    },
    "unit-ref": {
      "description": "Which unit a predicate or trigger talks about. A fixed role, a filter for 'any unit that…', or a unit bound by an earlier trigger or selection.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "this-unit",
            "this-model",
            "model-in-this-unit",
            "attacker",
            "defender",
            "event-subject",
            "event-object",
            "stratagem-target",
            "selected-unit",
            "recipient",
            "bearer-transport",
            "ability-unit"
          ],
          "description": "this-unit: the unit with the ability (attached units included); the default subject, and in an eligibility filter the candidate being checked. this-model: the model with the ability. model-in-this-unit: any model in this unit. attacker / defender: the two units of the attack being resolved. event-subject / event-object: the unit whose action fired the trigger, and the unit it was aimed at. stratagem-target: the Stratagem's TARGET. selected-unit: a unit the ability tells the player to select. recipient: the unit an effect or aura is being applied to. bearer-transport: the Transport the unit with the ability is embarked within. ability-unit: the unit with the ability, even inside a selection's eligibility, where this-unit names the candidate being checked."
        },
        {
          "$ref": "#/$defs/unit-filter"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_var"
          ],
          "properties": {
            "event_var": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The object a sibling trigger bound with binds_event_variable."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_var"
          ],
          "properties": {
            "selection_var": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "A unit an earlier selection step bound."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stratagem_target"
          ],
          "properties": {
            "stratagem_target": {
              "$ref": "#/$defs/entity-id"
            }
          },
          "description": "One named target of a Stratagem with several targets (its target_restrictions list names each one)."
        }
      ]
    },
    "range-ref": {
      "description": "One reference for every distance.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inches"
          ],
          "properties": {
            "inches": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "string",
          "enum": [
            "engagement",
            "aura",
            "weapon",
            "half-weapon",
            "detection",
            "objective-control"
          ],
          "description": "engagement: Engagement Range. aura: the aura range of the unit the distance is measured from (its aura abilities' own ranges). weapon / half-weapon: the attacking weapon's range, or half of it. detection: detection range. objective-control: the range at which a model counts for an objective."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aura_of"
          ],
          "properties": {
            "aura_of": {
              "$ref": "#/$defs/entity-id"
            }
          },
          "description": "The current aura range of another ability, extensions included (Contagion Range is {aura_of: nurgle-s-gift-aura})."
        }
      ]
    },
    "history-window": {
      "type": "string",
      "enum": [
        "phase",
        "turn",
        "round",
        "battle",
        "previous-turn",
        "event"
      ],
      "description": "How far back a history condition looks. event: during the triggering event (this attack, this move)."
    },
    "objective-filter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which objectives. Every listed property must hold.",
      "properties": {
        "role": {
          "enum": [
            "central",
            "expansion",
            "home",
            "non-home"
          ]
        },
        "home_of": {
          "enum": [
            "friendly",
            "enemy"
          ],
          "description": "The friendly or the enemy home objective."
        },
        "territory": {
          "enum": [
            "your-territory",
            "enemy-territory",
            "no-mans-land"
          ]
        },
        "controlled_by": {
          "$ref": "#/$defs/owner"
        },
        "designated": {
          "$ref": "#/$defs/designation-id"
        },
        "name": {
          "$ref": "#/$defs/entity-id",
          "description": "A mission-specific named objective."
        },
        "selection_var": {
          "type": "string",
          "minLength": 1,
          "description": "The objective marker a select-objective step bound."
        }
      }
    },
    "region-ref": {
      "description": "A region of the battlefield.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "territory"
          ],
          "properties": {
            "territory": {
              "enum": [
                "your-territory",
                "enemy-territory",
                "no-mans-land",
                "your-deployment-zone",
                "enemy-deployment-zone",
                "attacker-territory"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terrain_area"
          ],
          "properties": {
            "terrain_area": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "designated": {
                  "$ref": "#/$defs/designation-id"
                },
                "footprint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_region"
          ],
          "properties": {
            "rule_region": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region_id"
              ],
              "properties": {
                "region_id": {
                  "$ref": "#/$defs/entity-id"
                },
                "owner_faction": {
                  "$ref": "#/$defs/entity-id"
                }
              }
            }
          },
          "description": "A region an army rule defines (Flow of Magic, Hallowed Ground)."
        }
      ]
    },
    "event-filter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Narrows an event family: which selection, move, roll or rule. Only the properties that make sense for the family are used.",
      "properties": {
        "to": {
          "enum": [
            "move",
            "shoot",
            "fight",
            "attack",
            "disembark",
            "observe",
            "declare-charge"
          ],
          "description": "selected: what the unit was selected to do. attack means shoot or fight."
        },
        "kind": {
          "enum": [
            "attack",
            "shoot",
            "fight",
            "charge",
            "stratagem",
            "ability",
            "action",
            "manoeuvre",
            "order",
            "ritual",
            "dark-pact",
            "act-of-faith",
            "doctrine",
            "contract"
          ],
          "description": "targets-selected / attacks-resolved / used: which kind of targeting, attack or rule."
        },
        "id": {
          "$ref": "#/$defs/entity-id",
          "description": "Which one of `kind` (a Stratagem, ability, action…)."
        },
        "move_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "normal",
              "advance",
              "remain-stationary",
              "fall-back",
              "charge",
              "pile-in",
              "consolidation",
              "ingress",
              "surge",
              "scout",
              "disembark"
            ]
          }
        },
        "mode": {
          "$ref": "#/$defs/move-mode",
          "description": "A move type's named mode (a Fall Back's desperate escape, a combat disembark)."
        },
        "roll": {
          "$ref": "#/$defs/roll-kind"
        },
        "result": {
          "$ref": "#/$defs/roll-outcome"
        },
        "from": {
          "enum": [
            "strategic-reserves",
            "deep-strike",
            "cult-ambush",
            "transport"
          ]
        },
        "through": {
          "enum": [
            "terrain",
            "tall-terrain"
          ]
        },
        "attack_type": {
          "enum": [
            "ranged",
            "melee",
            "psychic",
            "mortal"
          ]
        },
        "weapon_name": {
          "type": "string",
          "minLength": 1
        },
        "weapon_keyword": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "$ref": "#/$defs/unit-ref",
          "description": "Who caused it (the unit or model whose attack destroyed the object)."
        },
        "timing": {
          "enum": [
            "before-removal"
          ],
          "description": "destroyed: resolve before the model is removed."
        },
        "first": {
          "const": true,
          "description": "Only the first time this happens in the window."
        },
        "step": {
          "enum": [
            "battle-shock",
            "reinforcements"
          ]
        },
        "state": {
          "$ref": "#/$defs/unit-state"
        },
        "tag": {
          "$ref": "#/$defs/designation-id"
        },
        "pool": {
          "type": "string",
          "minLength": 1
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "ability_keyword": {
          "type": "string",
          "minLength": 1,
          "description": "used: any ability whose name carries this keyword in brackets (BONDSMAN for every '(Bondsman)' ability), instead of one `id`."
        },
        "same_rule_as": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_var"
          ],
          "properties": {
            "event_var": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "used: the same ability or Stratagem the event a trigger bound (binds_event_variable) used."
        }
      }
    },
    "roll-kind": {
      "oneOf": [
        {
          "enum": [
            "hit",
            "wound",
            "save",
            "damage",
            "charge",
            "advance",
            "battle-shock",
            "leadership",
            "hazard",
            "psychic",
            "desperate-escape",
            "dark-pact",
            "blessings-of-khorne",
            "manoeuvre",
            "channelling"
          ]
        },
        {
          "$ref": "#/$defs/ability-roll"
        }
      ]
    },
    "roll-outcome": {
      "enum": [
        "success",
        "failure",
        "critical"
      ]
    },
    "battle-size-value": {
      "type": "object",
      "additionalProperties": false,
      "description": "One value per battle size (Incursion, Strike Force, Onslaught). Accepted wherever a count, amount or cap is: the value that applies is the one for the battle being played.",
      "properties": {
        "incursion": {
          "type": "integer",
          "minimum": 0
        },
        "strike-force": {
          "type": "integer",
          "minimum": 0
        },
        "onslaught": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "incursion",
        "strike-force",
        "onslaught"
      ]
    },
    "scaling-source": {
      "type": "string",
      "enum": [
        "enemy-models-in-range",
        "friendly-models-in-range",
        "models-in-bearer-unit",
        "models-in-or-embarked-in-bearer",
        "models-embarked-in-bearer",
        "embarked-models-oc",
        "models-equipped-with",
        "enemy-units-in-range",
        "wounds-lost",
        "battle-round"
      ],
      "description": "What a count or a scaling block counts. models-embarked-in-bearer: passengers only. embarked-models-oc: the summed Objective Control of the passengers. models-equipped-with: models in the bearer's unit equipped with `wargear`. battle-round: the current battle round number."
    },
    "roll-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll_var"
      ],
      "description": "The result of a roll an enclosing `roll` step bound: its total, or (with successes_on) how many of its dice rolled that value or higher.",
      "properties": {
        "roll_var": {
          "type": "string",
          "minLength": 1
        },
        "successes_on": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "count-of": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_of"
      ],
      "description": "A number equal to how many of `count_of` there are (models in this unit with `keyword`, models equipped with `wargear`, the battle round number).",
      "properties": {
        "count_of": {
          "$ref": "#/$defs/scaling-source"
        },
        "keyword": {
          "$ref": "#/$defs/keyword"
        },
        "wargear": {
          "$ref": "#/$defs/entity-id"
        },
        "within_inches": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "count_of": {
                "const": "models-equipped-with"
              }
            }
          },
          "then": {
            "required": [
              "wargear"
            ]
          },
          "else": {
            "not": {
              "required": [
                "wargear"
              ]
            }
          }
        }
      ]
    },
    "quantity": {
      "description": "A count, amount or value: a number, a dice expression (D3, 2D6, D6+1), one value per battle size, the result of a bound roll, or a count of something on the battlefield, or the rating the unit prints for this rule.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(\\d*D(3|6)(\\+\\d+)?|\\d+)$"
        },
        {
          "$ref": "#/$defs/battle-size-value"
        },
        {
          "$ref": "#/$defs/roll-reference"
        },
        {
          "$ref": "#/$defs/count-of"
        },
        {
          "$ref": "#/$defs/unit-rating"
        }
      ]
    },
    "move-mode": {
      "enum": [
        "ordered-retreat",
        "desperate-escape",
        "ongoing",
        "engaging",
        "objective",
        "rapid",
        "tactical",
        "combat",
        "emergency",
        "assault"
      ],
      "description": "A move type's named mode: a Fall Back's ordered retreat or desperate escape, a rapid, combat, assault or emergency disembarkation."
    },
    "ability-roll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "of_ability"
      ],
      "properties": {
        "of_ability": {
          "$ref": "#/$defs/entity-id"
        }
      },
      "description": "The dice a named ability rolls (Reanimation Protocols' roll), not every roll the unit makes."
    },
    "place-ref": {
      "description": "Something a distance is measured to: a unit, an objective marker, a named marker, a battlefield edge or the centre of the battlefield.",
      "oneOf": [
        {
          "$ref": "#/$defs/unit-ref"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective"
          ],
          "properties": {
            "objective": {
              "$ref": "#/$defs/objective-filter"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "marker"
          ],
          "properties": {
            "marker": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "enum": [
            "battlefield-edge",
            "battlefield-centre"
          ]
        }
      ]
    },
    "placement-near": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "of",
        "range"
      ],
      "description": "Set up within `range` of `of` (wholly within, if set).",
      "properties": {
        "of": {
          "$ref": "#/$defs/place-ref"
        },
        "range": {
          "$ref": "#/$defs/range-ref"
        },
        "wholly": {
          "const": true
        }
      }
    },
    "placement-away": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "of",
        "range"
      ],
      "description": "Set up more than `range` away from `of` (enemy models: {owner: enemy}).",
      "properties": {
        "of": {
          "$ref": "#/$defs/place-ref"
        },
        "range": {
          "$ref": "#/$defs/range-ref"
        }
      }
    },
    "placement-region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region"
      ],
      "description": "Set up inside a region (wholly inside, if set).",
      "properties": {
        "region": {
          "$ref": "#/$defs/region-ref"
        },
        "wholly": {
          "const": true
        }
      }
    },
    "designation-id": {
      "type": "string",
      "minLength": 1,
      "description": "A designation (a tag an effect applies: spotted, observer, afflicted, riled-up). Kebab-case id; the describer prints the rules' term from its label table and integrity rejects ids outside the registry. Upper-case legacy spellings are accepted until the record repair normalises them."
    },
    "unit-rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating"
      ],
      "properties": {
        "rating": {
          "const": true
        }
      },
      "description": "The rating the unit's datasheet prints for this rule (the D3 of Deadly Demise D3, the 5 of Feel No Pain 5+): the value of the unit's ability_ids entry for the ability that carries this effect."
    }
  }
}
